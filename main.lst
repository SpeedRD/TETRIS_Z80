  1+  A009              ; Programa para pintar el área de juego del Tetris
  2+  A009
  3+  A009              ; Rutina para dibujar el tablero de juego
  4+  A009              dibujar_tablero:
  5+  A009 CD CD 9C         call CLEARSCR   ; Limpiar toda la pantalla
  6+  A00C
  7+  A00C                  ; Dibujar el borde izquierdo
  8+  A00C 21 06 58         ld hl, $5800 + 0 * 32 + 6 ; Dirección de memoria de la pantalla para el borde izquierdo
  9+  A00F 11 20 00         ld de, $0020              ; Posición vertical (Y)
 10+  A012 3E 37            ld a, 6 * 8 + 7            ; Color del borde
 11+  A014 06 16            ld b, 22                  ; Número de filas del borde izquierdo
 12+  A016
 13+  A016              borde_izquierdo:
 14+  A016 77               ld (hl), a               ; Escribir el color en la pantalla
 15+  A017 19               add hl, de               ; Mover la posición a la siguiente fila
 16+  A018 10 FC            djnz borde_izquierdo     ; Decrementar B y repetir hasta que B sea cero
 17+  A01A
 18+  A01A                  ; Dibujar el borde derecho
 19+  A01A 21 19 58         ld hl, $5800 + 0 * 32 + 25 ; Dirección de memoria de la pantalla para el borde derecho
 20+  A01D 11 20 00         ld de, $0020               ; Posición vertical (Y)
 21+  A020 3E 37            ld a, 6 * 8 + 7            ; Color del borde
 22+  A022 06 16            ld b, 22                   ; Número de filas del borde derecho
 23+  A024
 24+  A024              borde_derecho:
 25+  A024 77               ld (hl), a               ; Escribir el color en la pantalla
 26+  A025 19               add hl, de               ; Mover la posición a la siguiente fila
 27+  A026 10 FC            djnz borde_derecho       ; Decrementar B y repetir hasta que B sea cero
 28+  A028
 29+  A028                  ; Dibujar la base
 30+  A028 21 C6 5A         ld hl, $5800 + 22 * 32 + 6 ; Dirección de memoria de la pantalla para la base
 31+  A02B 3E 37            ld a, 6 * 8 + 7            ; Color de la base
 32+  A02D 06 14            ld b, 20                   ; Número de columnas de la base
 33+  A02F
 34+  A02F              base:
 35+  A02F 77               ld (hl), a               ; Escribir el color en la pantalla
 36+  A030 23               inc hl                   ; Mover la posición a la siguiente columna
 37+  A031 10 FC            djnz base                ; Decrementar B y repetir hasta que B sea cero
 38+  A033
 39+  A033 F3               di                       ; Tetris_3D deja IY en $9FDF y no lo restaura
 40+  A034 CD E8 9F         call Tetris_3D           ; Aplicar el efecto 3D a los bloques
 41+  A037 FD 21 3A 5C      ld iy, $5C3A             ; devolvemos IY a la base de variables del sistema
 42+  A03B FB               ei
 43+  A03C
 44+  A03C
 45+  A03C C9               ret
