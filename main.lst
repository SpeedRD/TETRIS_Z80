  5+  9D13
  6+  9D13
  7+  9D13              ; ----------------------------------------------------------------------------------------
  8+  9D13              ; PRINTAT - Print a string in a position and attributes as per registers:
  9+  9D13              ;		IN	A	: Bit 7=1 For Flash / Bit 6=1 For Brigh / Bit 5,4,3 for Paper / Bit 2,1,0 for Ink
 10+  9D13              ;		IN	B	: Row 0..23
 11+  9D13              ;		IN	C	: Column 0..31
 12+  9D13              ;		IN	IX	: Address of text (Text must end in a 0)
 13+  9D13              ; ----------------------------------------------------------------------------------------
 14+  9D13 CD 22 9D     PRINTAT:	CALL PREP_PRT				; Update Attribute var &Screen & Attributes pointers
 15+  9D16              ; ----------------------------------------------------------------------------------------
 16+  9D16              ;		VVV Do not move PRINTSTR below as PRINTAT continues into PRINTSTR routine
 17+  9D16              ; ----------------------------------------------------------------------------------------
 18+  9D16              ; PRINTSTR - Prints String - IX Points to the String start
 19+  9D16              ; ----------------------------------------------------------------------------------------
 20+  9D16 DD 7E 00     PRINTSTR:   LD A,(IX)					; A Contains first char to print
 21+  9D19 B7           			OR A						; check for end of string (0)
 22+  9D1A C8           			RET Z						; Finish printing if 0
 23+  9D1B CD 50 9D     			CALL PRINTCHNUM
 24+  9D1E DD 23        			INC IX						; Move to next char in string
 25+  9D20 18 F4        			JR PRINTSTR					; Start over printing sequence
 26+  9D22              ; ----------------------------------------------------------------------------------------
 27+  9D22
 28+  9D22
 29+  9D22              ;-----------------------------------------------------------------------------------------
 30+  9D22              ; PREP_PRT - Updates Print_Attr, SCR & ATTR Vars
 31+  9D22              ;-----------------------------------------------------------------------------------------
 32+  9D22 32 96 9D     PREP_PRT:	LD (PRINT_ATTR),A			; Set Attribute
 33+  9D25 CD 2B 9D     PREP_PRT_2:	CALL CRtoSCREEN
 34+  9D28 C3 3D 9D     			JP CRtoATTR
 35+  9D2B              ;-----------------------------------------------------------------------------------------
 36+  9D2B
 37+  9D2B              ;-----------------------------------------------------------------------------------------
 38+  9D2B              ; CRtoSCREEN - Converts a scr char coord into a SCREEN Address   b,c = y,x positions
 39+  9D2B              ;	IN  - B=Row, C=Column
 40+  9D2B              ;	OUT - HL=Address in screen also stored in (SCR_CUR_PTR)
 41+  9D2B              ;	Conversion:
 42+  9D2B              ;			Row FFfff   Column CCCCC
 43+  9D2B              ;			HL=%010FF000 fffCCCCC
 44+  9D2B              ;-----------------------------------------------------------------------------------------
 45+  9D2B              CRtoSCREEN:
 46+  9D2B 78           			LD A,B						; %___FFfff
 47+  9D2C F6 40        			OR #40						; %010FFfff
 48+  9D2E E6 F8        			AND #F8						; %010FF000
 49+  9D30 67           			LD H,A
 50+  9D31
 51+  9D31 78           			LD A,B						; %___FFfff
 52+  9D32 E6 07        			AND #7						; %00000fff
 53+  9D34 0F           			RRCA						; %f00000ff
 54+  9D35 0F           			RRCA						; %ff00000f
 55+  9D36 0F           			RRCA						; %fff00000
 56+  9D37 B1           			OR C						; %fffCCCCC
 57+  9D38 6F           			LD L,A
 58+  9D39 22 92 9D                 LD (SCR_CUR_PTR),HL			; Update Variable
 59+  9D3C C9                       RET
 60+  9D3D              ; ----------------------------------------------------------------------------------------
 61+  9D3D
 62+  9D3D
 63+  9D3D
 64+  9D3D              ;-----------------------------------------------------------------------------------------
 65+  9D3D              ; CRtoATTR - Converts a screen char coord  into a ATTR Address  b,c = y,x positions
 66+  9D3D              ;	IN  - B=Row, C=Column
 67+  9D3D              ;	OUT - HL=Address in screen also stored in (SCR_ATTR_PTR)
 68+  9D3D              ;	Conversion:
 69+  9D3D              ;			Row FFfff   Column CCCCC
 70+  9D3D              ;			HL=%010110FF fffCCCCC
 71+  9D3D              ;-----------------------------------------------------------------------------------------
 72+  9D3D              CRtoATTR:
 73+  9D3D 78           			LD A,B						; %___FFfff
 74+  9D3E 0F           			RRCA						; %f000FFff
 75+  9D3F 0F           			RRCA						; %ff000FFf
 76+  9D40 0F           			RRCA						; %fff000FF
 77+  9D41 6F           			LD L,A
 78+  9D42 E6 03        			AND 3						; %000000FF	value of FF can be only 00,01,10
 79+  9D44 F6 58        			OR #58						; %010110FF value will be #58, #59 or #5A
 80+  9D46 67           			LD H,A
 81+  9D47
 82+  9D47 7D           			LD A,L						; %fff000FF
 83+  9D48 E6 E0        			AND #E0						; %fff00000
 84+  9D4A B1           			OR C						; %fffCCCCC
 85+  9D4B 6F           			LD L,A
 86+  9D4C
 87+  9D4C 22 94 9D                 LD (SCR_ATTR_PTR),HL		; Update Variable
 88+  9D4F C9                       RET
