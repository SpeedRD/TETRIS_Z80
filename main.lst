 98+  A4C2 06 03          ld b, 3
 98+  A4C4 0E 1A          ld c, 26
 98+  A4C6 DD 21 70 A5    ld ix, MsgLineas
 98+  A4CA CD 5C 9C       call PRINTAT
 99+  A4CD 3E 06            ld a, 6
 99+  A4CF 06 06          ld b, 6
 99+  A4D1 0E 1A          ld c, 26
 99+  A4D3 DD 21 76 A5    ld ix, MsgNivel
 99+  A4D7 CD 5C 9C       call PRINTAT
100+  A4DA 3E 06            ld a, 6
100+  A4DC 06 09          ld b, 9
100+  A4DE 0E 1A          ld c, 26
100+  A4E0 DD 21 7C A5    ld ix, MsgProxima
100+  A4E4 CD 5C 9C       call PRINTAT
101+  A4E7 C1               pop bc
101+  A4E8 DD E1          pop ix
102+  A4EA C9               ret
103+  A4EB
104+  A4EB              ; ImprimirMarcador -- refresca los tres valores. Solo se llama cuando alguno
105+  A4EB              ;   ha cambiado: repintar texto en cada frame es puro desperdicio.
106+  A4EB              ;   Preserva BC e IX, que son la posicion y el puntero de la pieza en curso.
107+  A4EB              ImprimirMarcador:
108+  A4EB DD E5            push ix
108+  A4ED C5             push bc
109+  A4EE 3E 07            ld a, 7
109+  A4F0 06 01          ld b, 1
109+  A4F2 0E 1A          ld c, 26
110+  A4F4 CD 6B 9C         call PREP_PRT                      ; fija atributo y los dos cursores
111+  A4F7 3A 83 A5         ld a, (PUNTOS+2)
111+  A4FA CD 2B A5       call ImprimirBCD ; el par mas significativo primero
112+  A4FD 3A 82 A5         ld a, (PUNTOS+1)
112+  A500 CD 2B A5       call ImprimirBCD
