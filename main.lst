 45   A581                  INCLUDE "variables.asm"   ; SIEMPRE el ultimo: el estado mutable va al final
# file opened: variables.asm
  1+  A581              ; variables.asm -- TODO el estado mutable nuevo del juego, en un solo sitio.
  2+  A581              ;
  3+  A581              ; Se INCLUDE el ULTIMO en main.asm, asi que aterriza en $A2C7, el primer byte
  4+  A581              ; libre despues de la imagen del programa: memoria no contendida, separada del
  5+  A581              ; codigo y de la tabla de piezas, y referenciada siempre por etiqueta.
  6+  A581              ;
  7+  A581              ; NO declarar ninguna de estas variables en otro fichero: una segunda
  8+  A581              ; declaracion es un error de etiqueta duplicada.
  9+  A581              ; NO copiar el patron de "Medio" (piezas.asm:31), que vive incrustado en la
 10+  A581              ; imagen de codigo justo detras del ultimo registro de pieza y sin margen.
 11+  A581
 12+  A581              ; --- puntuacion ------------------------------------------------------------
 13+  A581 00 00 00     PUNTOS:          DB 0, 0, 0 ; BCD empaquetado, 6 digitos: pares 1-2, 3-4, 5-6
 14+  A584 00           LINEAS:          DB 0       ; total de filas eliminadas (binario de 8 bits)
 15+  A585 00           NIVEL:           DB 0       ; nivel actual (binario de 8 bits)
 16+  A586 0A           PROX_NIVEL:      DB 10      ; filas que faltan para subir de nivel
 17+  A587
 18+  A587              ; --- gravedad --------------------------------------------------------------
 19+  A587 30           FRAMES_POR_FILA: DB 48      ; frames entre dos caidas de una fila (nivel 0)
 20+  A588 30           contador_frames: DB 48      ; frames que faltan para la proxima caida
 21+  A589
 22+  A589              ; --- entrada ---------------------------------------------------------------
 23+  A589 00           teclas_ant:      DB 0       ; mascara de la lectura anterior de leer_teclas.
 24+  A58A                                          ; Convenio de leer_teclas: bit a 1 = tecla PULSADA
 25+  A58A                                          ; (ya invertida), por eso el valor inicial es 0.
 26+  A58A
 27+  A58A              ; --- seleccion y posicion de pieza -----------------------------------------
 28+  A58A A5           semilla:         DB $A5     ; estado del LFSR. DEBE ser distinto de cero: un
 29+  A58B                                          ; LFSR que llega a cero se queda en cero para siempre
 30+  A58B 54 A1        siguiente_pieza: DW T_0     ; puntero al registro de la proxima pieza (preview).
 31+  A58D                                          ; Arranca en un registro VALIDO, no en 0: iniciar
 32+  A58D                                          ; siempre llama antes a iniciar_secuencia, pero con
 33+  A58D                                          ; un 0 aqui cualquier camino que se saltara ese paso
 34+  A58D                                          ; dejaria IX=$0000 y pintar_tetromino leeria las
 35+  A58D                                          ; filas/columnas de la ROM.
 36+  A58D 0F           Medio:           DB 15      ; copia en memoria de la columna en curso (C).
 37+  A58E                                          ; El valor inicial es indiferente: juego.asm lo
 38+  A58E                                          ; escribe desde C en cuanto aparece la primera
 39+  A58E                                          ; pieza. Antes vivia en piezas.asm, dentro de la
 40+  A58E                                          ; imagen de codigo, pegado al ultimo registro.
 41+  A58E
