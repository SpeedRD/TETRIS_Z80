 96+  9C90              PRINTCHNUM:	;SUB 32						; Adjust Ascii to charset
 97+  9C90 26 00        			LD H,0						; Multiply value by 8 to get to right Char in Charset
 98+  9C92 6F           			LD L,A
 99+  9C93 29           			ADD HL,HL
100+  9C94 29           			ADD HL,HL
101+  9C95 29           			ADD HL,HL
