 21+  9B65 3E 82            ld a,2+$80               ; Verde parpadeante
 22+  9B67 77               ld (hl),a                ; Establecer el atributo
 23+  9B68
 24+  9B68 CD C6 9B         call EsperarTecla        ; Leer el teclado hasta que se pulse S o N
 25+  9B6B C9               ret
 26+  9B6C
 27+  9B6C              Pantalla_Final:
 28+  9B6C CD CD 9C         call CLEARSCR  ; Clear the screen
 29+  9B6F
 30+  9B6F                  ; Display the first message
 31+  9B6F 3E 03            ld a, 3               ; Set color to pink on black
 32+  9B71 06 05            ld b, 5               ; Row position
 33+  9B73 0E 0C            ld c, 12              ; Column position
 34+  9B75 DD 21 4B 9C      ld ix, MensajeGameOver  ; Address of the message
 35+  9B79 CD 5C 9C         call PRINTAT  ; Print the message
 36+  9B7C
 37+  9B7C                  ; Display the second message
 38+  9B7C 3E 01            ld a, 1               ; Set color to blue on black, blinking
 39+  9B7E 06 12            ld b, 18              ; Row position
 40+  9B80 0E 01            ld c, 1               ; Column position
 41+  9B82 DD 21 31 9C      ld ix, MensajeReiniciar  ; Address of the message (antes cargaba
 42+  9B86 CD 5C 9C         call PRINTAT             ;  MensajeGameOver por segunda vez)
 43+  9B89
 44+  9B89                  ; Set cursor attribute to blinking blue
 45+  9B89 06 12            ld b, 18              ; Row position for attribute
 46+  9B8B 0E 1E            ld c, 30              ; Column position for attribute
 47+  9B8D CD AB 9B         call CalcularAtributo ; Calculate attribute address
 48+  9B90 3E 81            ld a, 1 + $80         ; Blinking blue
 49+  9B92 77               ld (hl), a            ; Set the attribute
 50+  9B93
 51+  9B93 CD CE 9B         call LeerTecla     ; Wait for a key press (S or N)
 52+  9B96
 53+  9B96 C3 0E 80         jp inicializar            ; Restart the game. JP y no CALL: con CALL cada
 54+  9B99                                            ; reinicio dejaba 2 bytes de pila sin recuperar,
 55+  9B99                                            ; y lo que hubiera detras era codigo muerto.
 56+  9B99
 57+  9B99
 58+  9B99              FinDelJuego:
 59+  9B99 CD CD 9C         call CLEARSCR
 60+  9B9C
 61+  9B9C 3E 85            ld a,5+$80               ; Letra cian
 62+  9B9E 06 0B            ld b,11                  ; Coordenadas para el mensaje final
 63+  9BA0 0E 08            ld c,8
 64+  9BA2 DD 21 EB 9B      ld ix,MensajeFinal
 65+  9BA6 CD 5C 9C         call PRINTAT
 66+  9BA9
 67+  9BA9 18 FE        fin:    JR fin
