 69+  9BAB              CalcularAtributo:
 70+  9BAB                                      ; Rutina que recibe en B,C las coordenadas de la pantalla (fila, columna)
 71+  9BAB                                      ; y devuelve en HL la dirección del atributo correspondiente
 72+  9BAB F5               PUSH AF             ; Guardamos A en el stack
 73+  9BAC 60               LD H,b              ; Los bits 4,5 de B deben ser los bits 0,1 de H
 74+  9BAD CB 3C            SRL H
 74+  9BAF CB 3C          SRL H
 74+  9BB1 CB 3C          SRL H
 75+  9BB3 78               LD A,B              ; Los bits 0,1,2 de B deben ser los bits 5,6,7 de L
 76+  9BB4 CB 27            SLA A
 76+  9BB6 CB 27          SLA A
 76+  9BB8 CB 27          SLA A
 76+  9BBA CB 27          SLA A
 76+  9BBC CB 27          SLA a
 77+  9BBE B1               OR c                ; Y C son los bits 0-4 de L
 78+  9BBF 6F               LD L,A
 79+  9BC0 01 00 58         LD BC, $5800        ; Le sumamos la dirección de comienzo de los atributos
 80+  9BC3 09               ADD HL,BC
 81+  9BC4 F1               POP AF
 82+  9BC5 C9               RET
 83+  9BC6
 84+  9BC6
 85+  9BC6              EsperarTecla:
 86+  9BC6 CD CE 9B         call LeerTecla
 87+  9BC9 FE 1F            cp $1F              ; SoltarTecla devuelve el puerto enmascarado a los bits 0-4
 88+  9BCB 20 F9            jr nz,EsperarTecla  ; Esperar hasta que no haya tecla pulsada
 89+  9BCD C9               ret
 90+  9BCE
 91+  9BCE              LeerTecla:
 92+  9BCE 01 FE 7F         ld bc,$7FFE         ; Escanear línea B,N,M,SYMB,Space
 93+  9BD1 ED 78            in a,(c)
 94+  9BD3 CB 5F            bit 3,a
 95+  9BD5 28 C2            jr z,FinDelJuego    ; Han pulsado N
 96+  9BD7 01 FE FD         ld bc,$FDFE         ; Escanear línea G,F,D,S,A
 97+  9BDA ED 78            in a,(c)
 98+  9BDC CB 4F            bit 1,a
 99+  9BDE 20 EE            jr nz,LeerTecla     ; No han pulsado 'S'
100+  9BE0 18 00            jr SoltarTecla
101+  9BE2
102+  9BE2              SoltarTecla:
103+  9BE2 ED 78            in a,(c)            ; Leer del puerto que se ha definido en LeerTecla
104+  9BE4 E6 1F            and $1F             ; solo los bits 0-4 son teclado; el bit 6 (EAR) no es fiable
105+  9BE6 FE 1F            cp $1F              ; Comprobar que no hay tecla pulsada
106+  9BE8 20 F8            jr nz,SoltarTecla   ; Esperar hasta que no haya tecla pulsada
107+  9BEA C9               ret
