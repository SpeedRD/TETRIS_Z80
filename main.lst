123+  A52B              ; ImprimirBCD -- imprime los dos digitos del byte BCD en A.
124+  A52B              ;   El cursor debe estar ya puesto. Destruye AF, B, DE, HL. Preserva C, IX, IY.
125+  A52B              ImprimirBCD:
126+  A52B F5               PUSH AF
127+  A52C 0F               RRCA
127+  A52D 0F             RRCA
127+  A52E 0F             RRCA
127+  A52F 0F             RRCA   ; nibble alto a los bits 0-3
128+  A530 E6 0F            AND $0F
128+  A532 C6 30          ADD A, '0'        ; valor del digito -> codigo ASCII
129+  A534 CD 99 9C         CALL PRINTCHNUM
129+  A537 F1             POP AF
130+  A538 E6 0F            AND $0F
130+  A53A C6 30          ADD A, '0'        ; nibble bajo
131+  A53C C3 99 9C         JP PRINTCHNUM               ; salto final: imprime, avanza cursor y vuelve
132+  A53F
133+  A53F              ; ImprimirDec3 -- imprime A (0-255) como tres digitos decimales con ceros a la
134+  A53F              ;   izquierda, para que el campo no encoja y no queden digitos viejos.
135+  A53F              ;   El Z80 no divide, asi que restamos. Destruye AF, B, DE, HL. Preserva C.
136+  A53F              ImprimirDec3:
137+  A53F 06 00            ld b, 0
