 45   A5AC                  INCLUDE "variables.asm"   ; SIEMPRE el ultimo: el estado mutable va al final
# file opened: variables.asm
  1+  A5AC              ; variables.asm -- TODO el estado mutable nuevo del juego, en un solo sitio.
  2+  A5AC              ;
  3+  A5AC              ; Se INCLUDE el ULTIMO en main.asm, asi que aterriza en $A2C7, el primer byte
  4+  A5AC              ; libre despues de la imagen del programa: memoria no contendida, separada del
  5+  A5AC              ; codigo y de la tabla de piezas, y referenciada siempre por etiqueta.
  6+  A5AC              ;
  7+  A5AC              ; NO declarar ninguna de estas variables en otro fichero: una segunda
  8+  A5AC              ; declaracion es un error de etiqueta duplicada.
  9+  A5AC              ; NO copiar el patron de "Medio" (piezas.asm:31), que vive incrustado en la
 10+  A5AC              ; imagen de codigo justo detras del ultimo registro de pieza y sin margen.
 11+  A5AC
 12+  A5AC              ; --- puntuacion ------------------------------------------------------------
 13+  A5AC 00 00 00     PUNTOS:          DB 0, 0, 0 ; BCD empaquetado, 6 digitos: pares 1-2, 3-4, 5-6
 14+  A5AF 00           LINEAS:          DB 0       ; total de filas eliminadas (binario de 8 bits)
 15+  A5B0 00           NIVEL:           DB 0       ; nivel actual (binario de 8 bits)
 16+  A5B1 0A           PROX_NIVEL:      DB 10      ; filas que faltan para subir de nivel
 17+  A5B2
 18+  A5B2              ; --- gravedad --------------------------------------------------------------
 19+  A5B2 30           FRAMES_POR_FILA: DB 48      ; frames entre dos caidas de una fila (nivel 0)
 20+  A5B3 30           contador_frames: DB 48      ; frames que faltan para la proxima caida
 21+  A5B4 04           contador_rapido: DB 4       ; frames que faltan para la proxima caida RAPIDA
 22+  A5B5                                          ; (soft drop, SPACE mantenida). Solo se decuenta
 23+  A5B5                                          ; mientras SPACE esta pulsada -- juego.asm; no
 24+  A5B5                                          ; toca ni reemplaza a contador_frames, que sigue
 25+  A5B5                                          ; su cuenta normal por debajo sin interrupcion
 26+  A5B5
 27+  A5B5              ; --- entrada ---------------------------------------------------------------
 28+  A5B5 00           teclas_ant:      DB 0       ; mascara de la lectura anterior de leer_teclas.
 29+  A5B6                                          ; Convenio de leer_teclas: bit a 1 = tecla PULSADA
 30+  A5B6                                          ; (ya invertida), por eso el valor inicial es 0.
 31+  A5B6
 32+  A5B6              ; --- seleccion y posicion de pieza -----------------------------------------
 33+  A5B6 A5           semilla:         DB $A5     ; estado del LFSR. DEBE ser distinto de cero: un
 34+  A5B7                                          ; LFSR que llega a cero se queda en cero para siempre
