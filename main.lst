116+  9CA0 1A           BYTEPCHAR:	LD A,(DE)					; Get Char to be printed, first line
117+  9CA1 77           			LD (HL),A					; Move to Printing location
118+  9CA2 24                       INC H						; inc H so next line in char (ZX Spectrum Screen RAM)
119+  9CA3 13                       INC DE 						; next line to be printed
120+  9CA4 10 FA                    DJNZ BYTEPCHAR				; Repeat 8 lines
121+  9CA6 3A D6 9C                 LD A,(PRINT_ATTR) 			; Load Attributes to print char with
