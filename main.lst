 83+  A48F 32 84 A5         ld (LINEAS), a
 84+  A492 32 85 A5         ld (NIVEL), a
 85+  A495 3E 0A            ld a, 10
 85+  A497 32 86 A5       ld (PROX_NIVEL), a
 86+  A49A CD 6A A4         call ActualizarVelocidad           ; FRAMES_POR_FILA = tabla[0] = 48
 87+  A49D 3A 87 A5         ld a, (FRAMES_POR_FILA)
 88+  A4A0 32 88 A5         ld (contador_frames), a
 89+  A4A3 CD B0 A4         call ImprimirEtiquetas
 90+  A4A6 CD EB A4         call ImprimirMarcador
 91+  A4A9 DD E1            pop ix
 91+  A4AB E1             pop hl
 91+  A4AC D1             pop de
 91+  A4AD C1             pop bc
 91+  A4AE F1             pop af
 92+  A4AF C9               ret
 93+  A4B0
 94+  A4B0              ; ImprimirEtiquetas -- rotulos fijos, una sola vez por partida.
 95+  A4B0              ImprimirEtiquetas:
 96+  A4B0 DD E5            push ix
 96+  A4B2 C5             push bc                  ; IX = pieza, B/C = posicion de la pieza
 97+  A4B3 3E 06            ld a, 6
 97+  A4B5 06 00          ld b, 0
 97+  A4B7 0E 1A          ld c, 26
 97+  A4B9 DD 21 6A A5    ld ix, MsgPuntos
 97+  A4BD CD 5C 9C       call PRINTAT
