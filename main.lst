 37+  A316              ; "Medio" (la columna en curso) vivia aqui, incrustado en la imagen de codigo
 38+  A316              ; justo detras del ultimo registro de pieza y sin ningun margen. Ahora esta en
 39+  A316              ; variables.asm, con el resto del estado mutable.
 40+  A316
 41+  A316              ; Rutina para pintar el tetromino en pantalla
 42+  A316              pintar_tetromino:
 43+  A316 F5               push af
 44+  A317 FD E5            push iy
 45+  A319 E5               push hl
 46+  A31A D5               push de
 47+  A31B C5               push bc
 48+  A31C F3               di                     ; IY va a apuntar al patron; la ROM ($0038) exige IY=$5C3A
 49+  A31D
 50+  A31D CD 76 9C         call CalcularAtributo  ; Calcular la dirección en HL
 51+  A320 DD 46 00         ld b, (ix)             ; Obtener filas en B
 52+  A323 DD 4E 01         ld c, (ix+1)           ; Obtener columnas en C
 53+  A326 DD E5 FD E1      ld iy, ix
 54+  A32A FD 23            inc iy
 54+  A32C FD 23          inc iy        ; Ajustar IY a la dirección del patrón de bits del tetromino
 55+  A32E
 56+  A32E              pintar_loop:
 57+  A32E FD 7E 00         ld a, (iy)
 58+  A331 FD 23            inc iy
 59+  A333 FE 00            cp 0                   ; Verificar si el byte es cero
 60+  A335 28 01            jr z, siguiente_byte
 61+  A337
 62+  A337 77               ld (hl), a             ; Pintar el byte en pantalla
 63+  A338              siguiente_byte:
 64+  A338 23               inc hl                 ; Mover a la siguiente posición en memoria de video
 65+  A339 0D               dec c                  ; Decrementar el contador de columnas
 66+  A33A 20 F2            jr nz, pintar_loop     ; Repetir hasta que C sea cero
 67+  A33C
 68+  A33C DD 4E 01         ld c, (ix+1)           ; Resetear C para la siguiente fila
 69+  A33F 3E 20            ld a, 32
 70+  A341 91               sub c
 71+  A342 16 00            ld d, 0
 72+  A344 5F               ld e, a
 73+  A345 19               add hl, de             ; Mover a la siguiente fila en memoria de video
 74+  A346 10 E6            djnz pintar_loop       ; Repetir para todas las filas
 75+  A348
 76+  A348 C1               pop bc
 77+  A349 D1               pop de
 78+  A34A E1               pop hl
 79+  A34B FD E1            pop iy
 80+  A34D FB               ei                     ; IY ya vale lo que tenia el llamante: seguro reanudar
 81+  A34E F1               pop af
 82+  A34F
 83+  A34F C9               ret
