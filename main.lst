 33+  A50F 23             inc hl
 33+  A510 56             ld d, (hl)   ; DE = premio en BCD
 34+  A511 CD 44 A5         call SumarPuntos
 35+  A514
 36+  A514 F1               pop af                       ; --- lineas y nivel, una vuelta por fila
 37+  A515 47               ld b, a
