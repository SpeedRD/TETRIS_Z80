 44   A428                  INCLUDE "puntuacion.asm"
# file opened: puntuacion.asm
  1+  A428              ; puntuacion.asm -- puntos, lineas, nivel y su marcador en pantalla
  2+  A428              ;
  3+  A428              ; Las VARIABLES (PUNTOS, LINEAS, NIVEL, PROX_NIVEL, FRAMES_POR_FILA) se
  4+  A428              ; declaran en variables.asm y SOLO alli: declararlas tambien aqui es un error
  5+  A428              ; de etiqueta duplicada. Este fichero aporta el codigo y sus tablas de solo
  6+  A428              ; lectura.
  7+  A428              ;
  8+  A428              ; El marcador se pinta en las columnas 26-31, FUERA del pozo. Es una
  9+  A428              ; restriccion de correccion, no de gusto: "ocupado" significa "byte de
 10+  A428              ; atributo distinto de cero", asi que cualquier texto dentro de las columnas
 11+  A428              ; 7-24 se convertiria en un muro invisible para comprobar.
 12+  A428
 13+  A428              NIVEL_MAX EQU 10
 14+  A428
 15+  A428 00 01 00 03  PUNTOS_POR_LINEA: DW $0100, $0300, $0500, $0800  ; BCD, indice (filas-1)*2
 15+  A42C 00 05 00 08
 16+  A430 30 28 21 1B  FRAMES_POR_NIVEL: DB 48,40,33,27,22,18,15,12,10,8,6  ; niveles 0..10, a 50 fps
 16+  A434 16 12 0F 0C
 16+  A438 0A 08 06
 17+  A43B
 18+  A43B              ; anotar_lineas -- contabiliza un borrado de lineas.
 19+  A43B              ;   Entrada: A = filas eliminadas (0..4). Si es 0 no hace nada.
 20+  A43B              ;   Actualiza puntos, lineas, nivel y velocidad, y refresca el marcador.
 21+  A43B              ;   Preserva BC, DE, HL, IX, IY. Destruye AF.
 22+  A43B              anotar_lineas:
 23+  A43B B7               or a
 24+  A43C C8               ret z                        ; no se elimino ninguna fila
 25+  A43D C5               push bc
 25+  A43E D5             push de
 25+  A43F E5             push hl
 25+  A440 DD E5          push ix
 26+  A442 F5               push af                      ; nos guardamos la cuenta
 27+  A443
 28+  A443 3D               dec a                        ; --- puntos: indice (filas-1)*2
 29+  A444 87               add a, a
 30+  A445 5F               ld e, a
 30+  A446 16 00          ld d, 0
 31+  A448 21 28 A4         ld hl, PUNTOS_POR_LINEA
 32+  A44B 19               add hl, de
 33+  A44C 5E               ld e, (hl)
 33+  A44D 23             inc hl
 33+  A44E 56             ld d, (hl)   ; DE = premio en BCD
 34+  A44F CD 82 A4         call SumarPuntos
 35+  A452
 36+  A452 F1               pop af                       ; --- lineas y nivel, una vuelta por fila
 37+  A453 47               ld b, a
 38+  A454              al_bucle:
 39+  A454 3A AF A5         ld a, (LINEAS)
 39+  A457 3C             inc a
 39+  A458 32 AF A5       ld (LINEAS), a
 40+  A45B 3A B1 A5         ld a, (PROX_NIVEL)
 40+  A45E 3D             dec a
 40+  A45F 32 B1 A5       ld (PROX_NIVEL), a
 41+  A462 20 10            jr nz, al_siguiente
 42+  A464 3E 0A            ld a, 10
 42+  A466 32 B1 A5       ld (PROX_NIVEL), a      ; otras 10 filas hasta el proximo nivel
 43+  A469 3A B0 A5         ld a, (NIVEL)
 44+  A46C FE 0A            cp NIVEL_MAX
 45+  A46E 30 04            jr nc, al_siguiente                ; ya estamos en el tope
 46+  A470 3C               inc a
 46+  A471 32 B0 A5       ld (NIVEL), a
 47+  A474              al_siguiente:
 48+  A474 10 DE            djnz al_bucle
 49+  A476
 50+  A476 CD 95 A4         call ActualizarVelocidad
 51+  A479 CD 16 A5         call ImprimirMarcador
 52+  A47C DD E1            pop ix
 52+  A47E E1             pop hl
 52+  A47F D1             pop de
 52+  A480 C1             pop bc
 53+  A481 C9               ret
 54+  A482
 55+  A482              ; SumarPuntos -- suma DE (BCD de 4 digitos) al marcador de 6 digitos.
 56+  A482              ;   Destruye AF y HL.
 57+  A482              SumarPuntos:
 58+  A482 21 AC A5         LD HL, PUNTOS
 59+  A485 7E               LD A, (HL)
 59+  A486 83             ADD A, E
 59+  A487 27             DAA
 59+  A488 77             LD (HL), A          ; DAA vuelve decimal la
 60+  A489 23               INC HL
 60+  A48A 7E             LD A, (HL)
 60+  A48B 8A             ADC A, D
 60+  A48C 27             DAA
 60+  A48D 77             LD (HL), A ;  suma binaria. LD no
 61+  A48E 23               INC HL
 61+  A48F 7E             LD A, (HL)
 61+  A490 CE 00          ADC A, 0
 61+  A492 27             DAA
 61+  A493 77             LD (HL), A ;  toca flags: el
 62+  A494 C9               RET                                               ;  acarreo sobrevive.
 63+  A495
 64+  A495              ; ActualizarVelocidad -- copia la velocidad del nivel actual a la gravedad.
 65+  A495              ;   Destruye AF, DE y HL.
 66+  A495              ActualizarVelocidad:
 67+  A495 3A B0 A5         LD A, (NIVEL)
 68+  A498 FE 0A            CP NIVEL_MAX
 68+  A49A 38 02          JR C, NivelOK
 69+  A49C 3E 0A            LD A, NIVEL_MAX             ; tope: nunca indexar mas alla de la tabla
 70+  A49E              NivelOK:
 71+  A49E 5F               LD E, A
 71+  A49F 16 00          LD D, 0
 72+  A4A1 21 30 A4         LD HL, FRAMES_POR_NIVEL
 72+  A4A4 19             ADD HL, DE
 73+  A4A5 7E               LD A, (HL)
 73+  A4A6 32 B2 A5       LD (FRAMES_POR_FILA), A   ; suelo de 6 frames (~120 ms):
 74+  A4A9 C9               RET                                    ;  una tabla no puede dar 0
 75+  A4AA
 76+  A4AA              ; reiniciar_marcador -- pone el marcador a cero y pinta rotulos y valores.
 77+  A4AA              ;   Se llama al empezar una partida, cuando aun no hay ninguna pieza en juego.
 78+  A4AA              ;   Preserva AF, BC, DE, HL, IX, IY.
 79+  A4AA              reiniciar_marcador:
 80+  A4AA F5               push af
 80+  A4AB C5             push bc
 80+  A4AC D5             push de
 80+  A4AD E5             push hl
 80+  A4AE DD E5          push ix
 81+  A4B0 AF               xor a
 82+  A4B1 32 AC A5         ld (PUNTOS), a
 82+  A4B4 32 AD A5       ld (PUNTOS+1), a
 82+  A4B7 32 AE A5       ld (PUNTOS+2), a
 83+  A4BA 32 AF A5         ld (LINEAS), a
 84+  A4BD 32 B0 A5         ld (NIVEL), a
 85+  A4C0 3E 0A            ld a, 10
 85+  A4C2 32 B1 A5       ld (PROX_NIVEL), a
 86+  A4C5 CD 95 A4         call ActualizarVelocidad           ; FRAMES_POR_FILA = tabla[0] = 48
 87+  A4C8 3A B2 A5         ld a, (FRAMES_POR_FILA)
 88+  A4CB 32 B3 A5         ld (contador_frames), a
 89+  A4CE CD DB A4         call ImprimirEtiquetas
 90+  A4D1 CD 16 A5         call ImprimirMarcador
 91+  A4D4 DD E1            pop ix
 91+  A4D6 E1             pop hl
 91+  A4D7 D1             pop de
 91+  A4D8 C1             pop bc
 91+  A4D9 F1             pop af
 92+  A4DA C9               ret
 93+  A4DB
 94+  A4DB              ; ImprimirEtiquetas -- rotulos fijos, una sola vez por partida.
 95+  A4DB              ImprimirEtiquetas:
 96+  A4DB DD E5            push ix
 96+  A4DD C5             push bc                  ; IX = pieza, B/C = posicion de la pieza
 97+  A4DE 3E 06            ld a, 6
 97+  A4E0 06 00          ld b, 0
 97+  A4E2 0E 1A          ld c, 26
 97+  A4E4 DD 21 95 A5    ld ix, MsgPuntos
 97+  A4E8 CD 5C 9C       call PRINTAT
 98+  A4EB 3E 06            ld a, 6
 98+  A4ED 06 03          ld b, 3
 98+  A4EF 0E 1A          ld c, 26
 98+  A4F1 DD 21 9B A5    ld ix, MsgLineas
 98+  A4F5 CD 5C 9C       call PRINTAT
 99+  A4F8 3E 06            ld a, 6
 99+  A4FA 06 06          ld b, 6
 99+  A4FC 0E 1A          ld c, 26
 99+  A4FE DD 21 A1 A5    ld ix, MsgNivel
 99+  A502 CD 5C 9C       call PRINTAT
100+  A505 3E 06            ld a, 6
100+  A507 06 09          ld b, 9
100+  A509 0E 1A          ld c, 26
100+  A50B DD 21 A7 A5    ld ix, MsgProxima
100+  A50F CD 5C 9C       call PRINTAT
101+  A512 C1               pop bc
101+  A513 DD E1          pop ix
102+  A515 C9               ret
103+  A516
104+  A516              ; ImprimirMarcador -- refresca los tres valores. Solo se llama cuando alguno
105+  A516              ;   ha cambiado: repintar texto en cada frame es puro desperdicio.
106+  A516              ;   Preserva BC e IX, que son la posicion y el puntero de la pieza en curso.
107+  A516              ImprimirMarcador:
108+  A516 DD E5            push ix
108+  A518 C5             push bc
109+  A519 3E 07            ld a, 7
109+  A51B 06 01          ld b, 1
109+  A51D 0E 1A          ld c, 26
110+  A51F CD 6B 9C         call PREP_PRT                      ; fija atributo y los dos cursores
111+  A522 3A AE A5         ld a, (PUNTOS+2)
111+  A525 CD 56 A5       call ImprimirBCD ; el par mas significativo primero
112+  A528 3A AD A5         ld a, (PUNTOS+1)
112+  A52B CD 56 A5       call ImprimirBCD
113+  A52E 3A AC A5         ld a, (PUNTOS)
113+  A531 CD 56 A5       call ImprimirBCD
114+  A534 3E 07            ld a, 7
114+  A536 06 04          ld b, 4
114+  A538 0E 1A          ld c, 26
115+  A53A CD 6B 9C         call PREP_PRT
116+  A53D 3A AF A5         ld a, (LINEAS)
116+  A540 CD 6A A5       call ImprimirDec3
117+  A543 3E 07            ld a, 7
117+  A545 06 07          ld b, 7
117+  A547 0E 1A          ld c, 26
118+  A549 CD 6B 9C         call PREP_PRT
119+  A54C 3A B0 A5         ld a, (NIVEL)
119+  A54F CD 6A A5       call ImprimirDec3
120+  A552 C1               pop bc
120+  A553 DD E1          pop ix
121+  A555 C9               ret
122+  A556
123+  A556              ; ImprimirBCD -- imprime los dos digitos del byte BCD en A.
124+  A556              ;   El cursor debe estar ya puesto. Destruye AF, B, DE, HL. Preserva C, IX, IY.
125+  A556              ImprimirBCD:
126+  A556 F5               PUSH AF
127+  A557 0F               RRCA
127+  A558 0F             RRCA
127+  A559 0F             RRCA
127+  A55A 0F             RRCA   ; nibble alto a los bits 0-3
128+  A55B E6 0F            AND $0F
128+  A55D C6 30          ADD A, '0'        ; valor del digito -> codigo ASCII
129+  A55F CD 99 9C         CALL PRINTCHNUM
129+  A562 F1             POP AF
130+  A563 E6 0F            AND $0F
130+  A565 C6 30          ADD A, '0'        ; nibble bajo
131+  A567 C3 99 9C         JP PRINTCHNUM               ; salto final: imprime, avanza cursor y vuelve
132+  A56A
133+  A56A              ; ImprimirDec3 -- imprime A (0-255) como tres digitos decimales con ceros a la
134+  A56A              ;   izquierda, para que el campo no encoja y no queden digitos viejos.
135+  A56A              ;   El Z80 no divide, asi que restamos. Destruye AF, B, DE, HL. Preserva C.
136+  A56A              ImprimirDec3:
137+  A56A 06 00            ld b, 0
138+  A56C              id_cientos:
139+  A56C FE 64            cp 100
140+  A56E 38 05            jr c, id_fin_cientos
141+  A570 D6 64            sub 100
142+  A572 04               inc b
143+  A573 18 F7            jr id_cientos
144+  A575              id_fin_cientos:
145+  A575 F5               push af
146+  A576 78               ld a, b
146+  A577 C6 30          add a, '0'
146+  A579 CD 99 9C       call PRINTCHNUM   ; PRINTCHNUM destruye B: por eso
147+  A57C F1               pop af                                   ;  se recarga en cada tramo
148+  A57D 06 00            ld b, 0
149+  A57F              id_decenas:
150+  A57F FE 0A            cp 10
151+  A581 38 05            jr c, id_fin_decenas
152+  A583 D6 0A            sub 10
153+  A585 04               inc b
154+  A586 18 F7            jr id_decenas
155+  A588              id_fin_decenas:
156+  A588 F5               push af
157+  A589 78               ld a, b
157+  A58A C6 30          add a, '0'
157+  A58C CD 99 9C       call PRINTCHNUM
158+  A58F F1               pop af
159+  A590 C6 30            add a, '0'
160+  A592 C3 99 9C         jp PRINTCHNUM
161+  A595
162+  A595              ; Solo ASCII: cualquier byte >= 128 indexa fuera del juego de caracteres.
163+  A595 53 43 4F 52  MsgPuntos: db "SCORE",0
163+  A599 45 00
164+  A59B 4C 49 4E 45  MsgLineas: db "LINES",0
164+  A59F 53 00
