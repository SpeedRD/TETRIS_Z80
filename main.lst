 60+  A545 23               INC HL
 60+  A546 7E             LD A, (HL)
 60+  A547 8A             ADC A, D
 60+  A548 27             DAA
 60+  A549 77             LD (HL), A ;  suma binaria. LD no
 61+  A54A 23               INC HL
 61+  A54B 7E             LD A, (HL)
 61+  A54C CE 00          ADC A, 0
 61+  A54E 27             DAA
 61+  A54F 77             LD (HL), A ;  toca flags: el
 62+  A550 C9               RET                                               ;  acarreo sobrevive.
 63+  A551
 64+  A551              ; ActualizarVelocidad -- copia la velocidad del nivel actual a la gravedad.
 65+  A551              ;   Destruye AF, DE y HL.
 66+  A551              ActualizarVelocidad:
