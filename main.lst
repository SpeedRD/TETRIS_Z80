 93+  A58D 32 20 A8         ld (contador_frames), a
 94+  A590 CD 21 A7         call musica_reiniciar              ; la melodia vuelve a empezar por el
 95+  A593                                                     ;  principio. Un fin de partida no borra
 96+  A593                                                     ;  la RAM -- inicializar solo rehace SP --
 97+  A593                                                     ;  asi que sin esta llamada la segunda
 98+  A593                                                     ;  partida arrancaba a mitad de frase
 99+  A593                                                     ;  (musica.asm; NO vale mus_cargar)
100+  A593 CD A0 A5         call ImprimirEtiquetas
101+  A596 CD DB A5         call ImprimirMarcador
102+  A599 DD E1            pop ix
102+  A59B E1             pop hl
102+  A59C D1             pop de
102+  A59D C1             pop bc
102+  A59E F1             pop af
103+  A59F C9               ret
