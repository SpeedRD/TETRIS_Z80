 94+  9D50              ; PRINTCHNUM - Prints Char Number N (stored in A)
 95+  9D50              ;-----------------------------------------------------------------------------------------
 96+  9D50              PRINTCHNUM:	;SUB 32						; Adjust Ascii to charset
 97+  9D50 26 00        			LD H,0						; Multiply value by 8 to get to right Char in Charset
 98+  9D52 6F           			LD L,A
 99+  9D53 29           			ADD HL,HL
100+  9D54 29           			ADD HL,HL
101+  9D55 29           			ADD HL,HL
102+  9D56 11 97 9C     			LD DE, CHARSET-(8*32)		; Optimize in compile time (instead of sub 32)
103+  9D59 19           			ADD HL,DE
104+  9D5A EB           			EX  DE,HL					;Value in DE
105+  9D5B              			; Continues to printchar below
106+  9D5B              ; ----------------------------------------------------------------------------------------
107+  9D5B
108+  9D5B
109+  9D5B              ; ----------------------------------------------------------------------------------------
110+  9D5B              ; PRINTCHAR - Prints Char  (DE points to the char. Uses HL as last Cur Pointer)
111+  9D5B              ; ----------------------------------------------------------------------------------------
112+  9D5B              PRINTCHAR:
113+  9D5B 06 08        			LD B,8						; 8 Lines per char
114+  9D5D 2A 92 9D                 LD HL, (SCR_CUR_PTR)		; Load Cursor Pointer y,x
115+  9D60
116+  9D60 1A           BYTEPCHAR:	LD A,(DE)					; Get Char to be printed, first line
117+  9D61 77           			LD (HL),A					; Move to Printing location
118+  9D62 24                       INC H						; inc H so next line in char (ZX Spectrum Screen RAM)
119+  9D63 13                       INC DE 						; next line to be printed
120+  9D64 10 FA                    DJNZ BYTEPCHAR				; Repeat 8 lines
121+  9D66 3A 96 9D                 LD A,(PRINT_ATTR) 			; Load Attributes to print char with
122+  9D69 2A 94 9D                 LD HL, (SCR_ATTR_PTR)
123+  9D6C 77                       LD (HL),A
124+  9D6D 21 94 9D                 LD HL, SCR_ATTR_PTR			; Get pointer to ATTR
125+  9D70 34                       INC (HL)					; Move Attribute cursor to next char
126+  9D71 21 92 9D     			LD HL, SCR_CUR_PTR
127+  9D74 34           			INC (HL)					; update Cursor pointer to next position
128+  9D75 C9                       RET
