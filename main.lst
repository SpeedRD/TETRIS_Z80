  1+  9C5C              ; -------------------------------
  2+  9C5C              ; ZX Spectrum Text print library
  3+  9C5C              ; Daniel León - AOC - UFV 2020
  4+  9C5C              ; -------------------------------
  5+  9C5C
  6+  9C5C
  7+  9C5C              ; ----------------------------------------------------------------------------------------
  8+  9C5C              ; PRINTAT - Print a string in a position and attributes as per registers:
  9+  9C5C              ;		IN	A	: Bit 7=1 For Flash / Bit 6=1 For Brigh / Bit 5,4,3 for Paper / Bit 2,1,0 for Ink
 10+  9C5C              ;		IN	B	: Row 0..23
 11+  9C5C              ;		IN	C	: Column 0..31
 12+  9C5C              ;		IN	IX	: Address of text (Text must end in a 0)
 13+  9C5C              ; ----------------------------------------------------------------------------------------
 14+  9C5C CD 6B 9C     PRINTAT:	CALL PREP_PRT				; Update Attribute var &Screen & Attributes pointers
 15+  9C5F              ; ----------------------------------------------------------------------------------------
 16+  9C5F              ;		VVV Do not move PRINTSTR below as PRINTAT continues into PRINTSTR routine
 17+  9C5F              ; ----------------------------------------------------------------------------------------
 18+  9C5F              ; PRINTSTR - Prints String - IX Points to the String start
 19+  9C5F              ; ----------------------------------------------------------------------------------------
 20+  9C5F DD 7E 00     PRINTSTR:   LD A,(IX)					; A Contains first char to print
 21+  9C62 B7           			OR A						; check for end of string (0)
 22+  9C63 C8           			RET Z						; Finish printing if 0
 23+  9C64 CD 99 9C     			CALL PRINTCHNUM
 24+  9C67 DD 23        			INC IX						; Move to next char in string
 25+  9C69 18 F4        			JR PRINTSTR					; Start over printing sequence
 26+  9C6B              ; ----------------------------------------------------------------------------------------
 27+  9C6B
 28+  9C6B
 29+  9C6B              ;-----------------------------------------------------------------------------------------
 30+  9C6B              ; PREP_PRT - Updates Print_Attr, SCR & ATTR Vars
 31+  9C6B              ;-----------------------------------------------------------------------------------------
 32+  9C6B 32 DF 9C     PREP_PRT:	LD (PRINT_ATTR),A			; Set Attribute
 33+  9C6E CD 74 9C     PREP_PRT_2:	CALL CRtoSCREEN
 34+  9C71 C3 86 9C     			JP CRtoATTR
 35+  9C74              ;-----------------------------------------------------------------------------------------
 36+  9C74
 37+  9C74              ;-----------------------------------------------------------------------------------------
 38+  9C74              ; CRtoSCREEN - Converts a scr char coord into a SCREEN Address   b,c = y,x positions
 39+  9C74              ;	IN  - B=Row, C=Column
 40+  9C74              ;	OUT - HL=Address in screen also stored in (SCR_CUR_PTR)
 41+  9C74              ;	Conversion:
 42+  9C74              ;			Row FFfff   Column CCCCC
 43+  9C74              ;			HL=%010FF000 fffCCCCC
 44+  9C74              ;-----------------------------------------------------------------------------------------
 45+  9C74              CRtoSCREEN:
 46+  9C74 78           			LD A,B						; %___FFfff
 47+  9C75 F6 40        			OR #40						; %010FFfff
 48+  9C77 E6 F8        			AND #F8						; %010FF000
 49+  9C79 67           			LD H,A
 50+  9C7A
 51+  9C7A 78           			LD A,B						; %___FFfff
 52+  9C7B E6 07        			AND #7						; %00000fff
 53+  9C7D 0F           			RRCA						; %f00000ff
 54+  9C7E 0F           			RRCA						; %ff00000f
 55+  9C7F 0F           			RRCA						; %fff00000
 56+  9C80 B1           			OR C						; %fffCCCCC
 57+  9C81 6F           			LD L,A
 58+  9C82 22 DB 9C                 LD (SCR_CUR_PTR),HL			; Update Variable
 59+  9C85 C9                       RET
 60+  9C86              ; ----------------------------------------------------------------------------------------
 61+  9C86
 62+  9C86
 63+  9C86
 64+  9C86              ;-----------------------------------------------------------------------------------------
 65+  9C86              ; CRtoATTR - Converts a screen char coord  into a ATTR Address  b,c = y,x positions
 66+  9C86              ;	IN  - B=Row, C=Column
 67+  9C86              ;	OUT - HL=Address in screen also stored in (SCR_ATTR_PTR)
 68+  9C86              ;	Conversion:
 69+  9C86              ;			Row FFfff   Column CCCCC
 70+  9C86              ;			HL=%010110FF fffCCCCC
 71+  9C86              ;-----------------------------------------------------------------------------------------
 72+  9C86              CRtoATTR:
 73+  9C86 78           			LD A,B						; %___FFfff
 74+  9C87 0F           			RRCA						; %f000FFff
 75+  9C88 0F           			RRCA						; %ff000FFf
 76+  9C89 0F           			RRCA						; %fff000FF
 77+  9C8A 6F           			LD L,A
 78+  9C8B E6 03        			AND 3						; %000000FF	value of FF can be only 00,01,10
 79+  9C8D F6 58        			OR #58						; %010110FF value will be #58, #59 or #5A
 80+  9C8F 67           			LD H,A
 81+  9C90
 82+  9C90 7D           			LD A,L						; %fff000FF
 83+  9C91 E6 E0        			AND #E0						; %fff00000
 84+  9C93 B1           			OR C						; %fffCCCCC
 85+  9C94 6F           			LD L,A
 86+  9C95
 87+  9C95 22 DD 9C                 LD (SCR_ATTR_PTR),HL		; Update Variable
 88+  9C98 C9                       RET
 89+  9C99              ; ----------------------------------------------------------------------------------------
 90+  9C99
 91+  9C99
 92+  9C99
 93+  9C99              ; ----------------------------------------------------------------------------------------
 94+  9C99              ; PRINTCHNUM - Prints Char Number N (stored in A)
 95+  9C99              ;-----------------------------------------------------------------------------------------
 96+  9C99              PRINTCHNUM:	;SUB 32						; Adjust Ascii to charset
 97+  9C99 26 00        			LD H,0						; Multiply value by 8 to get to right Char in Charset
 98+  9C9B 6F           			LD L,A
 99+  9C9C 29           			ADD HL,HL
100+  9C9D 29           			ADD HL,HL
101+  9C9E 29           			ADD HL,HL
102+  9C9F 11 E0 9B     			LD DE, CHARSET-(8*32)		; Optimize in compile time (instead of sub 32)
103+  9CA2 19           			ADD HL,DE
104+  9CA3 EB           			EX  DE,HL					;Value in DE
105+  9CA4              			; Continues to printchar below
106+  9CA4              ; ----------------------------------------------------------------------------------------
107+  9CA4
108+  9CA4
109+  9CA4              ; ----------------------------------------------------------------------------------------
110+  9CA4              ; PRINTCHAR - Prints Char  (DE points to the char. Uses HL as last Cur Pointer)
111+  9CA4              ; ----------------------------------------------------------------------------------------
112+  9CA4              PRINTCHAR:
113+  9CA4 06 08        			LD B,8						; 8 Lines per char
114+  9CA6 2A DB 9C                 LD HL, (SCR_CUR_PTR)		; Load Cursor Pointer y,x
115+  9CA9
116+  9CA9 1A           BYTEPCHAR:	LD A,(DE)					; Get Char to be printed, first line
117+  9CAA 77           			LD (HL),A					; Move to Printing location
118+  9CAB 24                       INC H						; inc H so next line in char (ZX Spectrum Screen RAM)
119+  9CAC 13                       INC DE 						; next line to be printed
120+  9CAD 10 FA                    DJNZ BYTEPCHAR				; Repeat 8 lines
121+  9CAF 3A DF 9C                 LD A,(PRINT_ATTR) 			; Load Attributes to print char with
122+  9CB2 2A DD 9C                 LD HL, (SCR_ATTR_PTR)
123+  9CB5 77                       LD (HL),A
124+  9CB6 21 DD 9C                 LD HL, SCR_ATTR_PTR			; Get pointer to ATTR
125+  9CB9 34                       INC (HL)					; Move Attribute cursor to next char
126+  9CBA 21 DB 9C     			LD HL, SCR_CUR_PTR
127+  9CBD 34           			INC (HL)					; update Cursor pointer to next position
128+  9CBE C9                       RET
