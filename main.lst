 30+  A238
 31+  A238              ; Estados de aparicion, uno por FORMA (no por giro). Son datos de SOLO LECTURA,
 32+  A238              ; asi que no les afecta el problema de adyacencia que tenia "Medio": al elegir
 33+  A238              ; de aqui, nada vuelve a indexar aritmeticamente la tabla de registros, con lo
 34+  A238              ; que desaparece el riesgo de que un indice se pase del ultimo registro.
 35+  A238 54 A1 60 A1  spawn_table: DW T_0, T_L1, T_J1, T_T1, T_I1, T_Z1, T_S1
 35+  A23C 90 A1 C0 A1
 35+  A240 F0 A1 08 A2
 35+  A244 20 A2
 36+  A246
 37+  A246              ; "Medio" (la columna en curso) vivia aqui, incrustado en la imagen de codigo
 38+  A246              ; justo detras del ultimo registro de pieza y sin ningun margen. Ahora esta en
 39+  A246              ; variables.asm, con el resto del estado mutable.
 40+  A246
 41+  A246              ; Rutina para pintar el tetromino en pantalla
 42+  A246              pintar_tetromino:
 43+  A246 F5               push af
 44+  A247 FD E5            push iy
 45+  A249 E5               push hl
 46+  A24A D5               push de
 47+  A24B C5               push bc
 48+  A24C F3               di                     ; IY va a apuntar al patron; la ROM ($0038) exige IY=$5C3A
 49+  A24D
 50+  A24D CD AB 9B         call CalcularAtributo  ; Calcular la dirección en HL
 51+  A250 DD 46 00         ld b, (ix)             ; Obtener filas en B
 52+  A253 DD 4E 01         ld c, (ix+1)           ; Obtener columnas en C
 53+  A256 DD E5 FD E1      ld iy, ix
 54+  A25A FD 23            inc iy
 54+  A25C FD 23          inc iy        ; Ajustar IY a la dirección del patrón de bits del tetromino
 55+  A25E
 56+  A25E              pintar_loop:
 57+  A25E FD 7E 00         ld a, (iy)
 58+  A261 FD 23            inc iy
 59+  A263 FE 00            cp 0                   ; Verificar si el byte es cero
 60+  A265 28 01            jr z, siguiente_byte
 61+  A267
 62+  A267 77               ld (hl), a             ; Pintar el byte en pantalla
 63+  A268              siguiente_byte:
 64+  A268 23               inc hl                 ; Mover a la siguiente posición en memoria de video
 65+  A269 0D               dec c                  ; Decrementar el contador de columnas
 66+  A26A 20 F2            jr nz, pintar_loop     ; Repetir hasta que C sea cero
 67+  A26C
 68+  A26C DD 4E 01         ld c, (ix+1)           ; Resetear C para la siguiente fila
 69+  A26F 3E 20            ld a, 32
 70+  A271 91               sub c
 71+  A272 16 00            ld d, 0
 72+  A274 5F               ld e, a
 73+  A275 19               add hl, de             ; Mover a la siguiente fila en memoria de video
 74+  A276 10 E6            djnz pintar_loop       ; Repetir para todas las filas
 75+  A278
 76+  A278 C1               pop bc
 77+  A279 D1               pop de
 78+  A27A E1               pop hl
 79+  A27B FD E1            pop iy
 80+  A27D FB               ei                     ; IY ya vale lo que tenia el llamante: seguro reanudar
 81+  A27E F1               pop af
 82+  A27F
 83+  A27F C9               ret
