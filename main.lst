 41   A316                  INCLUDE "giro.asm"
# file opened: giro.asm
  1+  A316              GIRAR:
  2+  A316              ;--------------------------------------------------------------------
  3+  A316              ;Gira la pieza actual: valida, aplica retranqueo (wall kick) y CONFIRMA
  4+  A316              ;aqui dentro. El llamante NO debe volver a comprobar el resultado.
  5+  A316              ;
  6+  A316              ;No lee el teclado ni espera a que se suelte ninguna tecla: el bucle
  7+  A316              ;llama a leer_teclas una vez por pasada y pasa la direccion en A. Leer
  8+  A316              ;aqui dejaria la pieza invisible entre el borrado y el repintado.
  9+  A316              ;
 10+  A316              ;Param. de Entrada: IX = registro actual, B = fila, C = columna,
 11+  A316              ;                   (Medio) = columna, A = 0 girar izquierda (Q),
 12+  A316              ;                   A distinto de 0 girar derecha (W)
 13+  A316              ;Param. de Salida : si cabe -> IX = registro nuevo, C y (Medio) = columna nueva
 14+  A316              ;                   si no cabe -> IX, C y (Medio) intactos
 15+  A316              ;Destruye AF y DE. Preserva B, HL, IY. C es SALIDA si el giro cabe.
 16+  A316              ;--------------------------------------------------------------------
 17+  A316 E5               PUSH HL
 18+  A317 B7               OR  A
 19+  A318 20 08            JR  NZ, giro_der
 20+  A31A DD 56 09         LD  D,(IX + 9)          ; +8/+9 = sucesor al girar a la izquierda
 21+  A31D DD 5E 08         LD  E,(IX + 8)          ;  (byte bajo primero)
 22+  A320 18 06            JR  giro_probar
 23+  A322              giro_der:
 24+  A322 DD 56 0B         LD  D,(IX + 11)         ; +10/+11 = sucesor al girar a la derecha
 25+  A325 DD 5E 0A         LD  E,(IX + 10)
 26+  A328
 27+  A328              giro_probar:
 28+  A328 DD E5            PUSH IX                 ; estado al que volver si no cabe en ningun sitio
 29+  A32A DD 7E 01         LD  A,(IX + 1)          ; ancho de la pieza VIEJA: leerlo antes de mover IX
 30+  A32D DD 62 DD 6B      LD  IX, DE              ; IX = estado candidato (instruccion falsa, ver
 31+  A331                                          ;  assembler-conventions: LD IXH,D : LD IXL,E)
 32+  A331 DD 96 01         SUB (IX + 1)            ; A = ancho_viejo - ancho_nuevo, con signo (-3..+3)
 33+  A334 F2 38 A3         JP  P, giro_media
 34+  A337 3C               INC A                   ; los negativos deben redondear hacia cero, no hacia
 35+  A338              giro_media:                 ;  -infinito, para que girar e desgirar vuelva a la
 36+  A338 CB 2F            SRA A                   ;  misma columna. A = (viejo-nuevo)/2
 37+  A33A 81               ADD A, C                ; anclamos por el centro, no por la esquina superior
 38+  A33B 5F               LD  E, A                ; E = columna base recentrada: aun es una CANDIDATA
 39+  A33C 21 62 A3         LD  HL, giro_kicks
 40+  A33F
 41+  A33F              giro_bucle:
 42+  A33F 7E               LD  A,(HL)
 43+  A340 23               INC HL
 44+  A341 FE 80            CP  $80                 ; centinela: se han agotado las candidatas
 45+  A343 28 15            JR  Z, giro_deshacer
 46+  A345 83               ADD A, E                ; columna candidata = base recentrada + retranqueo
 47+  A346 4F               LD  C, A                ; las dos pruebas leen la fila de B y la columna de C
 48+  A347 CD A2 A3         CALL en_rango           ; PRUEBA 1 geometria: ¿cabe entera en las columnas
 49+  A34A B7               OR  A                   ;  7-24? comprobar no puede ver esto
 50+  A34B 20 F2            JR  NZ, giro_bucle
 51+  A34D CD 96 A2         CALL comprobar          ; PRUEBA 2 solape: A=0 cabe, A=1 choca con un bloque
 52+  A350 B7               OR  A                   ;  o con el borde. Preserva BC/DE/HL/IX/IY.
 53+  A351 20 EC            JR  NZ, giro_bucle
 54+  A353 79               LD  A, C
 55+  A354 32 B9 A5         LD  (Medio), A          ; CONFIRMAMOS tambien la columna en memoria: el bucle
 56+  A357 D1               POP DE                  ;  recarga C desde Medio y deshariamos el retranqueo.
 57+  A358 18 06            JR  giro_fin            ; descartamos el IX viejo: vale el nuevo
 58+  A35A
 59+  A35A              giro_deshacer:
 60+  A35A DD E1            POP IX                  ; no cabia en ningun sitio: recuperamos la forma...
 61+  A35C 3A B9 A5         LD  A,(Medio)
 62+  A35F 4F               LD  C, A                ; ...y la columna. (Medio) es la copia de respaldo de C.
 63+  A360              giro_fin:
 64+  A360 E1               POP HL
 65+  A361 C9               RET
 66+  A362
 67+  A362 00 FF 01 FE  giro_kicks: DB 0, -1, 1, -2, 2, $80   ; en el sitio, luego 1 y luego 2 celdas a
 67+  A366 02 80
 68+  A368                                                    ; cada lado. Datos de solo lectura,
 69+  A368                                                    ; despues del RET: nunca se ejecutan.
 70+  A368
# file closed: giro.asm
 42   A368                  INCLUDE "entrada.asm"
# file opened: entrada.asm
  1+  A368              ; entrada.asm -- lectura de teclado no bloqueante y limite lateral del pozo
  2+  A368              ;
  3+  A368              ; Sustituye a las dos esperas de "soltar tecla" (giro.asm, movimiento.asm), que
  4+  A368              ; congelaban gravedad y dibujado mientras una tecla estuviera pulsada.
  5+  A368
  6+  A368              COL_IZQ_POZO EQU 7    ; primera columna interior del pozo
  7+  A368              COL_DER_POZO EQU 24   ; ultima columna interior del pozo
  8+  A368
  9+  A368              ; leer_teclas -- lectura no bloqueante. Llamar UNA sola vez por pasada del
 10+  A368              ;   bucle. El resultado mezcla dos convenios distintos en el mismo byte:
 11+  A368              ;   Salida: A = bit0 = K (derecha)   bit1 = J (izquierda)   } FLANCO: 1 solo
 12+  A368              ;                bit2 = Q (giro izq)  bit3 = W (giro drcha)  } en la pasada en
 13+  A368              ;                                                             que pasan de
 14+  A368              ;                                                             SUELTA a PULSADA
 15+  A368              ;               bit4 = SPACE (caida rapida / soft drop)     } ESTADO: 1 en
 16+  A368              ;                                                             TODAS las
 17+  A368              ;                                                             pasadas mientras
 18+  A368              ;                                                             siga pulsada, 0
 19+  A368              ;                                                             en cuanto suelta
 20+  A368              ;           A = 0 si no hay tecla nueva ni SPACE pulsada.
 21+  A368              ;   SPACE es a proposito de nivel y no de flanco: gravedad rapida (juego.asm)
 22+  A368              ;   necesita saber que SIGUE pulsada en cada pasada, no solo la primera.
 23+  A368              ;   Preserva BC, DE, HL, IX, IY. Destruye AF.
 24+  A368              leer_teclas:
 25+  A368 C5               push bc
 25+  A369 D5             push de
 25+  A36A E5             push hl
 26+  A36B 01 FE BF         ld bc, $BFFE
 26+  A36E ED 78          in a,(c) ; media fila ENTER,L,K,J,H. ACTIVO A NIVEL BAJO:
 27+  A370 2F               cpl                     ;  una tecla pulsada lee 0, asi que invertimos.
 28+  A371 0F               rrca
 28+  A372 0F             rrca             ;  K esta en el bit2 y J en el bit3: los bajamos.
 29+  A373 E6 03            and %00000011           ;  bit0 = K, bit1 = J (descarta bits 5-7, que no
 30+  A375 5F               ld e, a                 ;  son teclado y tras el cpl valen basura)
 31+  A376 01 FE FB         ld bc, $FBFE
 31+  A379 ED 78          in a,(c) ; media fila Q,W,E,R,T: Q en bit0, W en bit1
 32+  A37B 2F               cpl
 33+  A37C 07               rlca
 33+  A37D 07             rlca             ;  los subimos a los bits 2 y 3
 34+  A37E E6 0C            and %00001100           ;  bit2 = Q, bit3 = W
 35+  A380 B3               or e
 35+  A381 5F             ld e, a          ; E = K/J/Q/W, 1 = pulsada AHORA
 36+  A382 01 FE 7F         ld bc, $7FFE
 36+  A385 ED 78          in a,(c) ; media fila SPACE,SYM SHIFT,M,N,B: SPACE en bit0
 37+  A387 2F               cpl
 38+  A388 E6 01            and %00000001           ;  nos quedamos solo con SPACE
 39+  A38A 07               rlca
 39+  A38B 07             rlca
 39+  A38C 07             rlca
 39+  A38D 07             rlca ; lo subimos al bit4
 40+  A38E B3               or e
 40+  A38F 5F             ld e, a          ; E = mascara ACTUAL completa (bits0-4), 1 =
 41+  A390                                          ;  pulsada AHORA MISMO -- esto es ESTADO, todavia
 42+  A390                                          ;  no flanco
 43+  A390 21 B5 A5         ld hl, teclas_ant       ; un byte: la misma mascara de la llamada anterior
 44+  A393 7E               ld a,(hl)
 44+  A394 73             ld (hl), e  ; leemos la vieja y guardamos la nueva
 45+  A395 2F               cpl
 45+  A396 A3             and e             ; A = flanco nuevo de los CINCO bits; valido para
 46+  A397                                          ;  K/J/Q/W (bits0-3), pero el bit4 tambien saldria
 47+  A397                                          ;  de flanco aqui y SPACE no quiere eso
 48+  A397 E6 0F            and %00001111           ; nos quedamos solo con el flanco de K/J/Q/W
 49+  A399 57               ld d, a                 ; D = flanco K/J/Q/W, bit4 a cero
 50+  A39A 7B               ld a, e
 51+  A39B E6 10            and %00010000           ; A = SOLO el estado actual de SPACE (bit4)
 52+  A39D B2               or d                    ; resultado: bits0-3 flanco, bit4 estado (nivel)
 53+  A39E E1               pop hl
 53+  A39F D1             pop de
 53+  A3A0 C1             pop bc
 54+  A3A1 C9               ret
 55+  A3A2
 56+  A3A2              ; en_rango -- ¿cabe la pieza IX entera en la columna C?
 57+  A3A2              ;   comprobar no puede responder a esto: solo ve el borde porque su byte de
 58+  A3A2              ;   atributo es distinto de cero, asi que una candidata que se haya SALTADO el
 59+  A3A2              ;   borde lee celdas vacias fuera del pozo y la aceptaria.
 60+  A3A2              ;   Entrada: C = columna candidata, IX = registro de la pieza; (ix+1) = ancho.
 61+  A3A2              ;   Salida : A = 0 cabe, A = 1 se sale.
 62+  A3A2              ;   Preserva BC, DE, HL, IX, IY. Destruye AF.
 63+  A3A2              en_rango:
 64+  A3A2 79               ld a, c
 65+  A3A3 FE 07            cp COL_IZQ_POZO
 66+  A3A5 38 0B            jr c, er_fuera          ; C < 7 -> a la izquierda de la pared izquierda
 67+  A3A7 DD 86 01         add a,(ix+1)            ; A = C + ancho
 68+  A3AA 38 06            jr c, er_fuera          ; desbordo los 8 bits: C estaba lejisimos
 69+  A3AC FE 1A            cp COL_DER_POZO + 2     ; la ultima celda es C+ancho-1 y debe ser <= 24,
 70+  A3AE 30 02            jr nc, er_fuera         ;  o sea C+ancho <= 25, o sea C+ancho < 26
 71+  A3B0 AF               xor a                   ; A = 0: todas las celdas caen entre 7 y 24
 72+  A3B1 C9               ret
 73+  A3B2              er_fuera:
 74+  A3B2 3E 01            ld a, 1
 75+  A3B4 C9               ret
 76+  A3B5
# file closed: entrada.asm
 43   A3B5                  INCLUDE "lineas.asm"
# file opened: lineas.asm
  1+  A3B5              ; lineas.asm -- deteccion y borrado de lineas completas
  2+  A3B5              ;
  3+  A3B5              ; El fichero de atributos ES el tablero: una celda esta ocupada si su byte de
  4+  A3B5              ; atributo es distinto de cero. El interior del pozo son las columnas 7-24
  5+  A3B5              ; (18 celdas) y las filas 0-21; la fila 22 es el suelo y las columnas 6 y 25
  6+  A3B5              ; son las paredes. NUNCA se escribe en el borde: nadie lo vuelve a pintar
  7+  A3B5              ; despues de dibujar_tablero, y un solo byte suelto abre un agujero permanente.
  8+  A3B5
  9+  A3B5              COL_IZQ    EQU 7        ; primera columna interior
 10+  A3B5              ANCHO_POZO EQU 18       ; ancho interior: columnas 7..24 inclusive
 11+  A3B5              FILA_BAJA  EQU 21       ; fila interior mas baja (la 22 es el suelo)
 12+  A3B5
 13+  A3B5              ; limpiar_lineas -- elimina todas las filas completas y compacta el tablero.
 14+  A3B5              ;   Entrada: nada.  Salida: A = numero de filas eliminadas (0..4 en la practica)
 15+  A3B5              ;   Preserva BC, DE, HL, IX, IY. Destruye AF.
 16+  A3B5              limpiar_lineas:
 17+  A3B5 C5               push bc
 17+  A3B6 D5             push de
 17+  A3B7 E5             push hl
 17+  A3B8 DD E5          push ix  ; BC = fila/columna de la pieza e
 18+  A3BA 0E 00            ld c, 0                  ; C = cuenta de filas eliminadas
 19+  A3BC 06 15            ld b, FILA_BAJA          ; B = fila a examinar; empezamos abajo y subimos
 20+  A3BE              ll_probar:
 21+  A3BE CD D8 A3         call fila_llena
 21+  A3C1 B7             or a   ; A = 1 si la fila B esta completa
 22+  A3C2 28 06            jr z, ll_arriba          ; no lo esta -> subimos una fila
 23+  A3C4 0C               inc c
 24+  A3C5 CD F4 A3         call bajar_filas         ; bajamos sobre ella todo lo que tenia encima
 25+  A3C8 18 F4            jr ll_probar             ; VOLVEMOS A PROBAR LA MISMA FILA B: tras el
 26+  A3CA                                           ;  desplazamiento en el indice B hay una fila
 27+  A3CA                                           ;  DISTINTA. Poner "dec b" aqui es el fallo
 28+  A3CA                                           ;  clasico: un doble hueco borraria una sola fila.
 29+  A3CA              ll_arriba:
 30+  A3CA 78               ld a, b
 30+  A3CB B7             or a
 31+  A3CC 28 03            jr z, ll_fin             ; la fila 0 era la ultima por probar -> hemos acabado
 32+  A3CE 05               dec b
 32+  A3CF 18 ED          jr ll_probar
 33+  A3D1              ll_fin:
 34+  A3D1 79               ld a, c                  ; devolvemos la cuenta; la consume puntuacion.asm
 35+  A3D2 DD E1            pop ix
 35+  A3D4 E1             pop hl
 35+  A3D5 D1             pop de
 35+  A3D6 C1             pop bc   ; espejo exacto de los push
 36+  A3D7 C9               ret
 37+  A3D8
 38+  A3D8              ; fila_llena -- Entrada: B = fila 0..21.  Salida: A = 1 completa, 0 no.
 39+  A3D8              ;   Preserva BC, DE, HL. Destruye AF.
 40+  A3D8              fila_llena:
 41+  A3D8 C5               push bc
 41+  A3D9 D5             push de
 41+  A3DA E5             push hl
 42+  A3DB 0E 07            ld c, COL_IZQ
 43+  A3DD CD 86 9C         call CRtoATTR            ; HL = $5800 + B*32 + 7. A diferencia de
 44+  A3E0                                           ;  CalcularAtributo, esta PRESERVA BC, que es lo
 45+  A3E0                                           ;  que mantiene vivo el contador de filas.
 46+  A3E0 1E 12            ld e, ANCHO_POZO         ; exactamente 18 celdas: nunca 32, o los bytes de
 47+  A3E2              fl_celda:                    ;  la pared (siempre 55) darian toda fila por llena
 48+  A3E2 7E               ld a, (hl)
 48+  A3E3 B7             or a
 49+  A3E4 28 08            jr z, fl_hueco           ; con una celda vacia basta: la fila no esta completa
 50+  A3E6 23               inc hl
 50+  A3E7 1D             dec e
 51+  A3E8 20 F8            jr nz, fl_celda          ; dec e fija los flags; inc hl no los toca
 52+  A3EA 3E 01            ld a, 1
 52+  A3EC 18 02          jr fl_fin
 53+  A3EE              fl_hueco:
 54+  A3EE 3E 00            ld a, 0
 55+  A3F0              fl_fin:
 56+  A3F0 E1               pop hl
 56+  A3F1 D1             pop de
 56+  A3F2 C1             pop bc
 57+  A3F3 C9               ret
 58+  A3F4
 59+  A3F4              ; bajar_filas -- Entrada: B = la fila recien eliminada (0..21).
 60+  A3F4              ;   Copia una fila hacia abajo todo lo que hay encima y deja la fila 0 vacia.
 61+  A3F4              ;   Preserva AF, BC, DE, HL.
 62+  A3F4              bajar_filas:
 63+  A3F4 F5               push af
 63+  A3F5 C5             push bc
 63+  A3F6 D5             push de
 63+  A3F7 E5             push hl
 64+  A3F8 78               ld a, b
 64+  A3F9 B7             or a           ; A = numero de copias a hacer = B
 65+  A3FA 28 19            jr z, bf_fila0           ; se elimino la fila 0: no hay nada encima
 66+  A3FC 0E 07            ld c, COL_IZQ
 67+  A3FE CD 86 9C         call CRtoATTR            ; HL = destino = $5800 + B*32 + 7
 68+  A401 EB               ex de, hl                ; DE = destino
 69+  A402 21 E0 FF         ld hl, -32
 69+  A405 19             add hl, de  ; HL = origen = destino - 32 = una fila mas arriba
 70+  A406              bf_copiar:
 71+  A406 01 12 00         ld bc, ANCHO_POZO
 72+  A409 ED B0            ldir                     ; 18 bytes (HL)->(DE); ambos avanzan 18, BC -> 0
 73+  A40B 01 CE FF         ld bc, -(ANCHO_POZO + 32); deshacemos los 18 y subimos una fila mas
 74+  A40E 09               add hl, bc               ; HL -= 50
 75+  A40F EB               ex de, hl
 75+  A410 09             add hl, bc
 75+  A411 EB             ex de, hl   ; DE -= 50 (el Z80 no tiene "add de,bc")
 76+  A412 3D               dec a                    ; add hl,bc no toca Z; dec a si
 77+  A413 20 F1            jr nz, bf_copiar
 78+  A415              bf_fila0:
 79+  A415 06 00            ld b, 0
 79+  A417 0E 07          ld c, COL_IZQ  ; vaciamos las 18 celdas de la fila 0, o la fila
 80+  A419 CD 86 9C         call CRtoATTR            ;  de arriba se duplicaria hacia abajo para siempre
 81+  A41C 06 12            ld b, ANCHO_POZO
 82+  A41E              bf_cero:
 83+  A41E 36 00            ld (hl), 0
 83+  A420 23             inc hl
 84+  A421 10 FB            djnz bf_cero
 85+  A423 E1               pop hl
 85+  A424 D1             pop de
 85+  A425 C1             pop bc
 85+  A426 F1             pop af
 86+  A427 C9               ret
 87+  A428
