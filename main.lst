 47   A816                  INCLUDE "variables.asm"   ; SIEMPRE el ultimo: el estado mutable va al final
# file opened: variables.asm
  1+  A816              ; variables.asm -- TODO el estado mutable nuevo del juego, en un solo sitio.
  2+  A816              ;
  3+  A816              ; Se INCLUDE el ULTIMO en main.asm, asi que aterriza en $A2C7, el primer byte
  4+  A816              ; libre despues de la imagen del programa: memoria no contendida, separada del
  5+  A816              ; codigo y de la tabla de piezas, y referenciada siempre por etiqueta.
  6+  A816              ;
  7+  A816              ; NO declarar ninguna de estas variables en otro fichero: una segunda
  8+  A816              ; declaracion es un error de etiqueta duplicada.
  9+  A816              ; NO copiar el patron de "Medio" (piezas.asm:31), que vive incrustado en la
 10+  A816              ; imagen de codigo justo detras del ultimo registro de pieza y sin margen.
 11+  A816
 12+  A816              ; --- puntuacion ------------------------------------------------------------
 13+  A816 00 00 00     PUNTOS:          DB 0, 0, 0 ; BCD empaquetado, 6 digitos: pares 1-2, 3-4, 5-6
 14+  A819 00           LINEAS:          DB 0       ; total de filas eliminadas (binario de 8 bits)
 15+  A81A 00           NIVEL:           DB 0       ; nivel actual (binario de 8 bits)
 16+  A81B 0A           PROX_NIVEL:      DB 10      ; filas que faltan para subir de nivel
 17+  A81C 00 00 00     MEJOR:           DB 0, 0, 0 ; mejor puntuacion de la SESION, mismo formato que
 18+  A81F                                          ; PUNTOS (BCD empaquetado, 6 digitos) para poder
 19+  A81F                                          ; reutilizar ImprimirBCD. Se escribe en un solo
 20+  A81F                                          ; sitio -- ActualizarMejor, al entrar en
 21+  A81F                                          ; Pantalla_Final -- y se lee en dos, la pantalla de
 22+  A81F                                          ; inicio y la de fin de partida. Sobrevive a
 23+  A81F                                          ; inicializar: nadie lo pone a cero, y por eso es de
 24+  A81F                                          ; la sesion y no de la partida
 25+  A81F
 26+  A81F              ; --- gravedad --------------------------------------------------------------
 27+  A81F 30           FRAMES_POR_FILA: DB 48      ; frames entre dos caidas de una fila (nivel 0)
 28+  A820 30           contador_frames: DB 48      ; frames que faltan para la proxima caida
 29+  A821 04           contador_rapido: DB 4       ; frames que faltan para la proxima caida RAPIDA
 30+  A822                                          ; (soft drop, SPACE mantenida). Solo se decuenta
 31+  A822                                          ; mientras SPACE esta pulsada -- juego.asm; no
 32+  A822                                          ; toca ni reemplaza a contador_frames, que sigue
 33+  A822                                          ; su cuenta normal por debajo sin interrupcion
 34+  A822
 35+  A822              ; --- entrada ---------------------------------------------------------------
 36+  A822 00           teclas_ant:      DB 0       ; mascara de la lectura anterior de leer_teclas.
 37+  A823                                          ; Convenio de leer_teclas: bit a 1 = tecla PULSADA
 38+  A823                                          ; (ya invertida), por eso el valor inicial es 0.
 39+  A823
 40+  A823              ; --- seleccion y posicion de pieza -----------------------------------------
 41+  A823 A5           semilla:         DB $A5     ; estado del LFSR. DEBE ser distinto de cero: un
 42+  A824                                          ; LFSR que llega a cero se queda en cero para siempre
 43+  A824 2A A2        siguiente_pieza: DW T_0     ; puntero al registro de la proxima pieza (preview).
 44+  A826                                          ; Arranca en un registro VALIDO, no en 0: iniciar
 45+  A826                                          ; siempre llama antes a iniciar_secuencia, pero con
 46+  A826                                          ; un 0 aqui cualquier camino que se saltara ese paso
 47+  A826                                          ; dejaria IX=$0000 y pintar_tetromino leeria las
 48+  A826                                          ; filas/columnas de la ROM.
 49+  A826 0F           Medio:           DB 15      ; copia en memoria de la columna en curso (C).
 50+  A827                                          ; El valor inicial es indiferente: juego.asm lo
 51+  A827                                          ; escribe desde C en cuanto aparece la primera
 52+  A827                                          ; pieza. Antes vivia en piezas.asm, dentro de la
 53+  A827                                          ; imagen de codigo, pegado al ultimo registro.
 54+  A827
 55+  A827              ; --- musica ----------------------------------------------------------------
 56+  A827              ; Las tres primeras son la posicion del reproductor dentro de melodia
 57+  A827              ; (musica.asm); la cuarta es la unica que escribe alguien de fuera.
 58+  A827 A8 A7        musica_puntero:  DW melodia  ; siguiente pareja (nota, duracion) por leer.
 59+  A829                                           ; Referencia adelantada a musica.asm, igual que
 60+  A829                                           ; siguiente_pieza lo es a piezas.asm.
 61+  A829 FE           musica_nota:     DB NOTA_SIL ; indice en tabla_notas de la nota que suena
 62+  A82A                                           ; AHORA. NOTA_SIL = ninguna (silencio de la
 63+  A82A                                           ; propia melodia).
 64+  A82A 00           musica_frames:   DB 0        ; tramas que le quedan a esa nota. 0 = agotada:
 65+  A82B                                           ; la proxima llamada a musica_frame carga la
 66+  A82B                                           ; pareja siguiente. Por eso el valor inicial es 0
 67+  A82B                                           ; y no hace falta ninguna rutina de arranque.
 68+  A82B 00           musica_silencio: DB 0        ; distinto de cero = esta trama va MUDA.
 69+  A82C                                           ; La escribe juego.asm con el numero de filas que
 70+  A82C                                           ; devuelve limpiar_lineas: una trama que borra
 71+  A82C                                           ; lineas no tiene presupuesto para el relleno de
 72+  A82C                                           ; sonido (MUSIC_DESIGN.md 6). musica_frame la lee
 73+  A82C                                           ; y la vuelve a poner a cero SIEMPRE, asi que es
 74+  A82C                                           ; una bandera de una sola trama.
 75+  A82C
