146+  A632 78               ld a, b
146+  A633 C6 30          add a, '0'
146+  A635 CD 50 9D       call PRINTCHNUM   ; PRINTCHNUM destruye B: por eso
147+  A638 F1               pop af                                   ;  se recarga en cada tramo
148+  A639 06 00            ld b, 0
149+  A63B              id_decenas:
150+  A63B FE 0A            cp 10
151+  A63D 38 05            jr c, id_fin_decenas
