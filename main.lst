 24+  A377
 25+  A377 7E               ld a, (hl)
 26+  A378 B7               or a
 27+  A379 20 14            jr nz, colision_detectada
 28+  A37B
 29+  A37B              siguiente_cuadro:
 30+  A37B 23               inc hl
 31+  A37C 0D               dec c
 32+  A37D 20 F0            jr nz, validar_fila
 33+  A37F
 34+  A37F                  ; Avanzar a la siguiente fila del tetromino
 35+  A37F DD 4E 01         ld c, (ix+1)
 36+  A382 3E 20            ld a, 32
 37+  A384 91               sub c
