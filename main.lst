 36   A03D                  INCLUDE "juego.asm"
# file opened: juego.asm
  1+  A03D              ;Funcionamiento del juego -- bucle principal
  2+  A03D              ;
  3+  A03D              ;REGLA: se comprueba EXACTAMENTE la posicion que se va a pintar, con
  4+  A03D              ;EXACTAMENTE el IX que se va a pintar. El bucle antiguo validaba con la
  5+  A03D              ;columna de la pasada ANTERIOR y giraba DESPUES de comprobar, asi que
  6+  A03D              ;validaba una posicion que la pieza no llegaba a ocupar nunca.
  7+  A03D              ;
  8+  A03D              ;Estado global mientras cae una pieza:
  9+  A03D              ;   B  = fila       C  = columna      IX = registro de la pieza
 10+  A03D              ;   (Medio) = copia en memoria de C; debe coincidir con C en cada comprobar
 11+  A03D              ;   D  = desplazamiento lateral pedido en esta pasada (0, +1 o -1)
 12+  A03D              ;   E  = mascara de teclas nuevas de leer_teclas
 13+  A03D              ;   H  = 1 si en esta pasada toca bajar una fila, 0 si no
 14+  A03D              ;HL, DE y AF son libres para las rutinas llamadas; B, C e IX no lo son.
 15+  A03D
 16+  A03D              iniciar:
 17+  A03D CD 00 A1         CALL iniciar_secuencia  ; semilla del azar y primera pieza anunciada
 18+  A040
 19+  A040 CD 7F A4         CALL reiniciar_marcador ; puntos/lineas/nivel a cero y rotulos en pantalla.
 20+  A043                                          ;  Aqui todavia no hay ninguna pieza, asi que es el
 21+  A043                                          ;  unico sitio donde imprimir es gratis.
 22+  A043
 23+  A043 CD 0D A1         CALL seleccionar_pieza  ; IX = pieza, B = 0, C = 15
 24+  A046 CD 24 A1         CALL pintar_siguiente   ; muestra la que viene detras
 25+  A049 79               LD A, C
 26+  A04A 32 8D A5         LD (Medio), A           ; Medio siempre refleja C
 27+  A04D
 28+  A04D CD 80 A2         CALL comprobar          ; fin de partida = la pieza nueva no cabe en su
 29+  A050 B7               OR A                    ;  posicion de aparicion. Antes esto se hacia con
 30+  A051 20 7F            JR NZ, fin_partida      ;  B=255, que leia RAM fuera de la pantalla ($77EF).
 31+  A053
 32+  A053 CD 46 A2         CALL pintar_tetromino   ; pintamos una vez, para que el primer borrado
 33+  A056                                          ;  del bucle tenga algo que borrar
 34+  A056              paso:
 35+  A056 76               HALT                    ; dormimos hasta el tick de 50 Hz. El borrado y el
 36+  A057                                          ;  repintado caen justo detras, en el borde superior.
 37+  A057 26 00            LD H, 0                 ; por defecto esta pasada no baja
 38+  A059 3A 88 A5         LD A,(contador_frames)
 39+  A05C 3D               DEC A
 40+  A05D 32 88 A5         LD (contador_frames), A
 41+  A060 20 08            JR NZ, sin_gravedad
 42+  A062 3A 87 A5         LD A,(FRAMES_POR_FILA)  ; se agoto la cuenta: recargamos y pedimos bajada
 43+  A065 32 88 A5         LD (contador_frames), A
 44+  A068 26 01            LD H, 1
 45+  A06A              sin_gravedad:
 46+  A06A CD C4 A2         CALL borrar_tetromino   ; borra en el (B,C) ACTUAL con el IX ACTUAL
 47+  A06D
 48+  A06D CD 52 A3         CALL leer_teclas        ; A = teclas que acaban de pulsarse; nunca bloquea
 49+  A070 5F               LD E, A                 ; E sobrevive a en_rango, comprobar y GIRAR
 50+  A071 16 00            LD D, 0                 ; D = desplazamiento lateral
 51+  A073 CB 43            BIT 0, E
 52+  A075 28 01            JR Z, no_derecha
 53+  A077 14               INC D                   ; K -> una columna a la derecha
 54+  A078              no_derecha:
 55+  A078 CB 4B            BIT 1, E
 56+  A07A 28 01            JR Z, lateral
 57+  A07C 15               DEC D                   ; J -> una columna a la izquierda
 58+  A07D                                          ;  (las dos a la vez se anulan: D = 0)
 59+  A07D              lateral:
 60+  A07D 7A               LD A, D
 61+  A07E B7               OR A
 62+  A07F 28 18            JR Z, sin_lateral
 63+  A081 79               LD A, C
 64+  A082 82               ADD A, D
 65+  A083 4F               LD C, A                 ; C = columna candidata
 66+  A084 CD 77 A3         CALL en_rango           ; 1. ¿sigue dentro de las columnas 7-24?
 67+  A087 B7               OR A
 68+  A088 20 06            JR NZ, lat_no
 69+  A08A CD 80 A2         CALL comprobar          ; 2. ¿libre de bloques ya asentados?
 70+  A08D B7               OR A
 71+  A08E 28 05            JR Z, lat_si
 72+  A090              lat_no:
 73+  A090 79               LD A, C                 ; bloqueada: devolvemos la columna vieja. NO se
 74+  A091 92               SUB D                   ;  salta la gravedad de esta pasada.
 75+  A092 4F               LD C, A
 76+  A093 18 04            JR sin_lateral
 77+  A095              lat_si:
 78+  A095 79               LD A, C
 79+  A096 32 8D A5         LD (Medio), A           ; Medio se actualiza en cada confirmacion
 80+  A099              sin_lateral:
 81+  A099
 82+  A099 7B               LD A, E
 83+  A09A E6 0C            AND %00001100           ; ¿ni Q ni W recien pulsadas?
 84+  A09C 28 0A            JR Z, sin_giro
 85+  A09E CB 53            BIT 2, E
 86+  A0A0 3E 00            LD A, 0                 ; Q -> A = 0, girar a la izquierda
 87+  A0A2 20 01            JR NZ, girar_ya         ;  (LD no toca los flags de BIT)
 88+  A0A4 3C               INC A                   ; W -> A = 1, girar a la derecha
 89+  A0A5              girar_ya:
 90+  A0A5 CD 00 A3         CALL GIRAR              ; comprueba limites, retranquea, valida y CONFIRMA
 91+  A0A8              sin_giro:                   ;  el solo. NUNCA envolverlo en comprobar.
 92+  A0A8
 93+  A0A8 7C               LD A, H
 94+  A0A9 B7               OR A
 95+  A0AA 28 21            JR Z, dibujar           ; no es pasada de gravedad: solo repintar
 96+  A0AC
 97+  A0AC 04               INC B                   ; B = fila candidata
 98+  A0AD CD 80 A2         CALL comprobar
 99+  A0B0 B7               OR A
100+  A0B1 28 1A            JR Z, dibujar           ; libre: la caida queda confirmada
101+  A0B3
102+  A0B3 05               DEC B                   ; bloqueada: deshacemos la caida, la pieza se queda
103+  A0B4 CD 46 A2         CALL pintar_tetromino   ; y la fijamos en el fichero de atributos
104+  A0B7
105+  A0B7 CD 8A A3         CALL limpiar_lineas     ; A = filas eliminadas (0..4)
106+  A0BA CD 10 A4         CALL anotar_lineas      ; puntua, sube de nivel y refresca el marcador
107+  A0BD
108+  A0BD CD 0D A1         CALL seleccionar_pieza  ; IX = pieza siguiente, B = 0, C = 15
109+  A0C0 CD 24 A1         CALL pintar_siguiente   ; refresca el recuadro con la nueva anunciada
110+  A0C3 79               LD A, C
111+  A0C4 32 8D A5         LD (Medio), A
112+  A0C7 CD 80 A2         CALL comprobar          ; fin de partida = la nueva no cabe al aparecer
113+  A0CA B7               OR A
114+  A0CB 20 05            JR NZ, fin_partida
115+  A0CD
116+  A0CD              dibujar:
117+  A0CD CD 46 A2         CALL pintar_tetromino   ; pintamos el (B, C, IX) ya validado
118+  A0D0 18 84            JR paso
119+  A0D2
120+  A0D2              fin_partida:
121+  A0D2 C3 6C 9B         JP Pantalla_Final       ; JP, no CALL: no vuelve nunca
122+  A0D5
# file closed: juego.asm
 37   A0D5                  INCLUDE "tetromino_next.asm"
# file opened: tetromino_next.asm
  1+  A0D5              ;Programa para seleccionar y posicionar la proxima pieza
  2+  A0D5
  3+  A0D5              ; La version anterior elegia un ESTADO DE GIRO al azar entre los 19 registros,
  4+  A0D5              ; no una pieza: las piezas aparecian giradas al azar y las formas con 4 estados
  5+  A0D5              ; (L, J, T) salian el 75% de las veces. Ademas usaba "ld a,r" como fuente de
  6+  A0D5              ; azar (el contador de refresco, que avanza de forma casi fija por un camino de
  7+  A0D5              ; instrucciones fijo) y plegaba 19..31 sobre 0..12, con lo que los indices 0-12
  8+  A0D5              ; salian el doble que los 13-18.
  9+  A0D5              ;
 10+  A0D5              ; Ahora se elige una FORMA de una tabla de 7 estados de aparicion, todos
 11+  A0D5              ; verticales/canonicos, con un LFSR de 8 bits.
 12+  A0D5
 13+  A0D5              ; sembrar_azar -- toma una semilla del contador de refresco. Se llama una vez
 14+  A0D5              ;   por partida, justo despues de que el jugador pulse S, asi que el numero de
 15+  A0D5              ;   vueltas de la espera de teclado la hace realmente variable.
 16+  A0D5              ;   Destruye AF.
 17+  A0D5              sembrar_azar:
 18+  A0D5 ED 5F            ld a, r                 ; contador de refresco: 0..127
 19+  A0D7 B7               or a
 20+  A0D8 20 02            jr nz, sembrar_ok
 21+  A0DA 3E A5            ld a, $A5               ; un LFSR que valga cero se queda en cero para siempre
 22+  A0DC              sembrar_ok:
 23+  A0DC 32 8A A5         ld (semilla), a
 24+  A0DF C9               ret
 25+  A0E0
 26+  A0E0              ; nueva_pieza -- sortea una forma y devuelve su registro de aparicion.
 27+  A0E0              ;   Salida: DE = direccion del registro. Destruye AF y DE. Preserva BC, HL, IX, IY.
 28+  A0E0              nueva_pieza:
 29+  A0E0 E5               push hl
 30+  A0E1              np_tirar:
 31+  A0E1 3A 8A A5         ld a, (semilla)         ; LFSR de Galois de 8 bits, periodo 255, nunca da 0
 32+  A0E4 CB 3F            srl a                   ; desplaza a la derecha, el bit bajo va al acarreo
 33+  A0E6 30 02            jr nc, np_sin_tap
 34+  A0E8 EE B4            xor $B4                 ; polinomio de realimentacion
 35+  A0EA              np_sin_tap:
 36+  A0EA 32 8A A5         ld (semilla), a
 37+  A0ED E6 07            and 7
 38+  A0EF FE 07            cp 7
 39+  A0F1 28 EE            jr z, np_tirar          ; descartamos el 7 -> uniforme 0..6. El reintento
 40+  A0F3                                          ;  queda por DEBAJO del push: no hay fuga de pila.
 41+  A0F3 87               add a, a                ; *2: cada entrada de la tabla son 2 bytes
 42+  A0F4 21 38 A2         ld hl, spawn_table
 43+  A0F7 16 00            ld d, 0
 43+  A0F9 5F             ld e, a
 44+  A0FA 19               add hl, de
 45+  A0FB 5E               ld e, (hl)
 45+  A0FC 23             inc hl
 45+  A0FD 56             ld d, (hl)
 46+  A0FE E1               pop hl
 47+  A0FF C9               ret
 48+  A100
 49+  A100              ; iniciar_secuencia -- semilla y primera pieza anunciada. Una vez por partida,
 50+  A100              ;   antes del primer seleccionar_pieza. Destruye AF.
 51+  A100              iniciar_secuencia:
 52+  A100 CD D5 A0         call sembrar_azar
 53+  A103 D5               push de
 54+  A104 CD E0 A0         call nueva_pieza
 55+  A107 ED 53 8B A5      ld (siguiente_pieza), de
 56+  A10B D1               pop de
 57+  A10C C9               ret
 58+  A10D
 59+  A10D              ; seleccionar_pieza -- pone en juego la pieza ya anunciada y sortea la
 60+  A10D              ;   siguiente, de modo que el jugador siempre ve una por adelantado.
 61+  A10D              ;   Salida: IX = registro de aparicion, B = 0 (fila), C = 15 (columna).
 62+  A10D              ;   Destruye AF, BC, DE, IX. Preserva HL e IY.
 63+  A10D              ;   C = 15 es la UNICA definicion de la columna de aparicion; (Medio) se deriva
 64+  A10D              ;   de ella en juego.asm.
 65+  A10D              seleccionar_pieza:
 66+  A10D E5               push hl                 ; la version anterior preservaba HL: lo mantenemos
 67+  A10E 2A 8B A5         ld hl, (siguiente_pieza)
 68+  A111 E5               push hl                 ; la anunciada pasa a jugarse
 69+  A112 CD E0 A0         call nueva_pieza        ; DE = la proxima a anunciar
 70+  A115 ED 53 8B A5      ld (siguiente_pieza), de
 71+  A119 D1               pop de                  ; DE = la que toca jugar ahora
 72+  A11A DD 62 DD 6B      ld ix, de               ; instruccion falsa de sjasmplus -> LD IXH,D : LD IXL,E
 73+  A11E E1               pop hl
 74+  A11F 06 00            ld b, 0                 ; fila de aparicion
 75+  A121 0E 0F            ld c, 15                ; columna de aparicion
 76+  A123 C9               ret
 77+  A124
 78+  A124              ; ---------------------------------------------------------------------------
 79+  A124              ; Vista previa de la proxima pieza
 80+  A124              ;
 81+  A124              ; Se dibuja FUERA del pozo a proposito: "ocupado" es "byte de atributo distinto
 82+  A124              ; de cero", asi que cualquier cosa pintada en las columnas 7-24 se convertiria
 83+  A124              ; en geometria solida. en_rango mantiene la pieza en juego dentro de esas
 84+  A124              ; columnas, asi que el recuadro no puede tocarse nunca.
 85+  A124              PREV_FILA EQU 10        ; esquina superior izquierda del recuadro
 86+  A124              PREV_COL  EQU 27        ; columnas 27-30, filas 10-13: caja de 4x4
 87+  A124
 88+  A124              ; pintar_siguiente -- borra el recuadro y dibuja en el la pieza anunciada.
 89+  A124              ;   Preserva AF, BC, DE, HL, IX, IY.
 90+  A124              pintar_siguiente:
 91+  A124 F5               push af
 91+  A125 C5             push bc
 91+  A126 D5             push de
 91+  A127 E5             push hl
 91+  A128 DD E5          push ix
 92+  A12A 06 0A            ld b, PREV_FILA
 93+  A12C 16 04            ld d, 4                 ; 4 filas que limpiar
 94+  A12E              ps_fila:
 95+  A12E 0E 1B            ld c, PREV_COL
 96+  A130 CD 86 9C         call CRtoATTR           ; HL = direccion del atributo; PRESERVA BC
 97+  A133 36 00            ld (hl), 0
 97+  A135 23             inc hl     ; las 4 celdas de la fila, a cero (negro), igual
 98+  A136 36 00            ld (hl), 0
 98+  A138 23             inc hl     ;  que el interior del pozo
 99+  A139 36 00            ld (hl), 0
 99+  A13B 23             inc hl
100+  A13C 36 00            ld (hl), 0
101+  A13E 04               inc b
102+  A13F 15               dec d
103+  A140 20 EC            jr nz, ps_fila
104+  A142
105+  A142 DD 2A 8B A5      ld ix, (siguiente_pieza)
106+  A146 06 0A            ld b, PREV_FILA
107+  A148 0E 1B            ld c, PREV_COL
108+  A14A CD 46 A2         call pintar_tetromino
109+  A14D DD E1            pop ix
109+  A14F E1             pop hl
109+  A150 D1             pop de
109+  A151 C1             pop bc
109+  A152 F1             pop af
110+  A153 C9               ret
111+  A154
# file closed: tetromino_next.asm
