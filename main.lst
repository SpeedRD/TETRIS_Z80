 36   A03D                  INCLUDE "juego.asm"
# file opened: juego.asm
  1+  A03D              ;Funcionamiento del juego -- bucle principal
  2+  A03D              ;
  3+  A03D              ;REGLA: se comprueba EXACTAMENTE la posicion que se va a pintar, con
  4+  A03D              ;EXACTAMENTE el IX que se va a pintar. El bucle antiguo validaba con la
  5+  A03D              ;columna de la pasada ANTERIOR y giraba DESPUES de comprobar, asi que
  6+  A03D              ;validaba una posicion que la pieza no llegaba a ocupar nunca.
  7+  A03D              ;
  8+  A03D              ;Estado global mientras cae una pieza:
  9+  A03D              ;   B  = fila       C  = columna      IX = registro de la pieza
 10+  A03D              ;   (Medio) = copia en memoria de C; debe coincidir con C en cada comprobar
 11+  A03D              ;   D  = desplazamiento lateral pedido en esta pasada (0, +1 o -1)
 12+  A03D              ;   E  = mascara de leer_teclas: bits0-3 flanco nuevo (K/J/Q/W), bit4 = SPACE
 13+  A03D              ;        mantenida AHORA (caida rapida / soft drop), no flanco
 14+  A03D              ;   H  = 1 si en esta pasada toca bajar una fila, 0 si no
 15+  A03D              ;HL, DE y AF son libres para las rutinas llamadas; B, C e IX no lo son.
 16+  A03D
 17+  A03D              FRAMES_CAIDA_RAPIDA EQU 4   ; frames entre caidas mientras SPACE esta pulsada.
 18+  A03D                                          ; Mas rapido que cualquier nivel normal (la tabla
 19+  A03D                                          ; FRAMES_POR_NIVEL de puntuacion.asm no baja de 6),
 20+  A03D                                          ; pero no instantaneo: esto es soft drop, no hard
 21+  A03D                                          ; drop.
 22+  A03D
 23+  A03D              iniciar:
 24+  A03D CD 16 A1         CALL iniciar_secuencia  ; semilla del azar y primera pieza anunciada
 25+  A040
 26+  A040 CD AA A4         CALL reiniciar_marcador ; puntos/lineas/nivel a cero y rotulos en pantalla.
 27+  A043                                          ;  Aqui todavia no hay ninguna pieza, asi que es el
 28+  A043                                          ;  unico sitio donde imprimir es gratis.
 29+  A043
 30+  A043 CD 23 A1         CALL seleccionar_pieza  ; IX = pieza, B = 0, C = 15
 31+  A046 CD 3A A1         CALL pintar_siguiente   ; muestra la que viene detras
 32+  A049 79               LD A, C
 33+  A04A 32 B9 A5         LD (Medio), A           ; Medio siempre refleja C
 34+  A04D
 35+  A04D CD 96 A2         CALL comprobar          ; fin de partida = la pieza nueva no cabe en su
 36+  A050 B7               OR A                    ;  posicion de aparicion. Antes esto se hacia con
 37+  A051 C2 E8 A0         JP NZ, fin_partida      ;  B=255, que leia RAM fuera de la pantalla ($77EF).
 38+  A054                                          ;  JP, no JR: fin_partida ha quedado fuera de rango
 39+  A054
 40+  A054 CD 5C A2         CALL pintar_tetromino   ; pintamos una vez, para que el primer borrado
 41+  A057                                          ;  del bucle tenga algo que borrar
 42+  A057              paso:
 43+  A057 76               HALT                    ; dormimos hasta el tick de 50 Hz. El borrado y el
 44+  A058                                          ;  repintado caen justo detras, en el borde superior.
 45+  A058 26 00            LD H, 0                 ; por defecto esta pasada no baja
 46+  A05A
 47+  A05A CD 68 A3         CALL leer_teclas        ; A = teclas; nunca bloquea. Se lee YA aqui, antes
 48+  A05D                                          ;  del borrado, porque la gravedad rapida de abajo
 49+  A05D                                          ;  necesita el bit4 (SPACE) de esta misma pasada.
 50+  A05D                                          ;  borrar_tetromino preserva DE, asi que E aguanta.
 51+  A05D 5F               LD E, A                 ; E sobrevive a borrar_tetromino, en_rango,
 52+  A05E 16 00            LD D, 0                 ;  comprobar y GIRAR. D = desplazamiento lateral
 53+  A060
 54+  A060 3A B3 A5         LD A,(contador_frames)  ; gravedad NORMAL: cuenta siempre, la mantenga o
 55+  A063 3D               DEC A                   ;  no SPACE pulsada, para que soltar la tecla
 56+  A064 32 B3 A5         LD (contador_frames), A ;  vuelva a la velocidad normal sin ningun salto
 57+  A067 20 08            JR NZ, comprobar_rapida
 58+  A069 3A B2 A5         LD A,(FRAMES_POR_FILA)  ; se agoto la cuenta: recargamos y pedimos bajada
 59+  A06C 32 B3 A5         LD (contador_frames), A
 60+  A06F 26 01            LD H, 1
 61+  A071              comprobar_rapida:
 62+  A071 CB 63            BIT 4, E                ; gravedad RAPIDA (soft drop): SUMA una bajada
 63+  A073 28 10            JR Z, sin_gravedad       ;  mas si toca, nunca sustituye a la de arriba.
 64+  A075 3A B4 A5         LD A,(contador_rapido)  ;  Solo se decuenta mientras SPACE sigue pulsada:
 65+  A078 3D               DEC A                   ;  al soltarla la cuenta se queda congelada donde
 66+  A079 32 B4 A5         LD (contador_rapido), A ;  estaba, lista para retomarse la proxima vez.
 67+  A07C 20 07            JR NZ, sin_gravedad
 68+  A07E 3E 04            LD A, FRAMES_CAIDA_RAPIDA
 69+  A080 32 B4 A5         LD (contador_rapido), A
 70+  A083 26 01            LD H, 1
 71+  A085              sin_gravedad:
 72+  A085 CD DA A2         CALL borrar_tetromino   ; borra en el (B,C) ACTUAL con el IX ACTUAL
 73+  A088
 74+  A088 CB 43            BIT 0, E
 75+  A08A 28 01            JR Z, no_derecha
 76+  A08C 14               INC D                   ; K -> una columna a la derecha
 77+  A08D              no_derecha:
 78+  A08D CB 4B            BIT 1, E
 79+  A08F 28 01            JR Z, lateral
 80+  A091 15               DEC D                   ; J -> una columna a la izquierda
 81+  A092                                          ;  (las dos a la vez se anulan: D = 0)
 82+  A092              lateral:
 83+  A092 7A               LD A, D
 84+  A093 B7               OR A
 85+  A094 28 18            JR Z, sin_lateral
 86+  A096 79               LD A, C
 87+  A097 82               ADD A, D
 88+  A098 4F               LD C, A                 ; C = columna candidata
 89+  A099 CD A2 A3         CALL en_rango           ; 1. ¿sigue dentro de las columnas 7-24?
 90+  A09C B7               OR A
 91+  A09D 20 06            JR NZ, lat_no
 92+  A09F CD 96 A2         CALL comprobar          ; 2. ¿libre de bloques ya asentados?
 93+  A0A2 B7               OR A
 94+  A0A3 28 05            JR Z, lat_si
 95+  A0A5              lat_no:
 96+  A0A5 79               LD A, C                 ; bloqueada: devolvemos la columna vieja. NO se
 97+  A0A6 92               SUB D                   ;  salta la gravedad de esta pasada.
 98+  A0A7 4F               LD C, A
 99+  A0A8 18 04            JR sin_lateral
100+  A0AA              lat_si:
101+  A0AA 79               LD A, C
102+  A0AB 32 B9 A5         LD (Medio), A           ; Medio se actualiza en cada confirmacion
103+  A0AE              sin_lateral:
104+  A0AE
105+  A0AE 7B               LD A, E
106+  A0AF E6 0C            AND %00001100           ; ¿ni Q ni W recien pulsadas?
107+  A0B1 28 0A            JR Z, sin_giro
108+  A0B3 CB 53            BIT 2, E
109+  A0B5 3E 00            LD A, 0                 ; Q -> A = 0, girar a la izquierda
110+  A0B7 20 01            JR NZ, girar_ya         ;  (LD no toca los flags de BIT)
111+  A0B9 3C               INC A                   ; W -> A = 1, girar a la derecha
112+  A0BA              girar_ya:
113+  A0BA CD 16 A3         CALL GIRAR              ; comprueba limites, retranquea, valida y CONFIRMA
114+  A0BD              sin_giro:                   ;  el solo. NUNCA envolverlo en comprobar.
115+  A0BD
116+  A0BD 7C               LD A, H
117+  A0BE B7               OR A
118+  A0BF 28 21            JR Z, dibujar           ; no es pasada de gravedad: solo repintar
119+  A0C1
120+  A0C1 04               INC B                   ; B = fila candidata
121+  A0C2 CD 96 A2         CALL comprobar
122+  A0C5 B7               OR A
123+  A0C6 28 1A            JR Z, dibujar           ; libre: la caida queda confirmada
124+  A0C8
125+  A0C8 05               DEC B                   ; bloqueada: deshacemos la caida, la pieza se queda
126+  A0C9 CD 5C A2         CALL pintar_tetromino   ; y la fijamos en el fichero de atributos
127+  A0CC
128+  A0CC CD B5 A3         CALL limpiar_lineas     ; A = filas eliminadas (0..4)
129+  A0CF CD 3B A4         CALL anotar_lineas      ; puntua, sube de nivel y refresca el marcador
130+  A0D2
131+  A0D2 CD 23 A1         CALL seleccionar_pieza  ; IX = pieza siguiente, B = 0, C = 15
132+  A0D5 CD 3A A1         CALL pintar_siguiente   ; refresca el recuadro con la nueva anunciada
133+  A0D8 79               LD A, C
134+  A0D9 32 B9 A5         LD (Medio), A
135+  A0DC CD 96 A2         CALL comprobar          ; fin de partida = la nueva no cabe al aparecer
136+  A0DF B7               OR A
137+  A0E0 20 06            JR NZ, fin_partida
138+  A0E2
139+  A0E2              dibujar:
140+  A0E2 CD 5C A2         CALL pintar_tetromino   ; pintamos el (B, C, IX) ya validado
141+  A0E5 C3 57 A0         JP paso                 ; JP, no JR: paso ha quedado fuera de rango
142+  A0E8
143+  A0E8              fin_partida:
144+  A0E8 C3 6C 9B         JP Pantalla_Final       ; JP, no CALL: no vuelve nunca
145+  A0EB
# file closed: juego.asm
 37   A0EB                  INCLUDE "tetromino_next.asm"
# file opened: tetromino_next.asm
  1+  A0EB              ;Programa para seleccionar y posicionar la proxima pieza
  2+  A0EB
  3+  A0EB              ; La version anterior elegia un ESTADO DE GIRO al azar entre los 19 registros,
  4+  A0EB              ; no una pieza: las piezas aparecian giradas al azar y las formas con 4 estados
  5+  A0EB              ; (L, J, T) salian el 75% de las veces. Ademas usaba "ld a,r" como fuente de
  6+  A0EB              ; azar (el contador de refresco, que avanza de forma casi fija por un camino de
  7+  A0EB              ; instrucciones fijo) y plegaba 19..31 sobre 0..12, con lo que los indices 0-12
  8+  A0EB              ; salian el doble que los 13-18.
  9+  A0EB              ;
 10+  A0EB              ; Ahora se elige una FORMA de una tabla de 7 estados de aparicion, todos
 11+  A0EB              ; verticales/canonicos, con un LFSR de 8 bits.
 12+  A0EB
 13+  A0EB              ; sembrar_azar -- toma una semilla del contador de refresco. Se llama una vez
 14+  A0EB              ;   por partida, justo despues de que el jugador pulse S, asi que el numero de
 15+  A0EB              ;   vueltas de la espera de teclado la hace realmente variable.
 16+  A0EB              ;   Destruye AF.
 17+  A0EB              sembrar_azar:
 18+  A0EB ED 5F            ld a, r                 ; contador de refresco: 0..127
 19+  A0ED B7               or a
 20+  A0EE 20 02            jr nz, sembrar_ok
 21+  A0F0 3E A5            ld a, $A5               ; un LFSR que valga cero se queda en cero para siempre
 22+  A0F2              sembrar_ok:
 23+  A0F2 32 B6 A5         ld (semilla), a
 24+  A0F5 C9               ret
 25+  A0F6
 26+  A0F6              ; nueva_pieza -- sortea una forma y devuelve su registro de aparicion.
 27+  A0F6              ;   Salida: DE = direccion del registro. Destruye AF y DE. Preserva BC, HL, IX, IY.
 28+  A0F6              nueva_pieza:
 29+  A0F6 E5               push hl
 30+  A0F7              np_tirar:
 31+  A0F7 3A B6 A5         ld a, (semilla)         ; LFSR de Galois de 8 bits, periodo 255, nunca da 0
 32+  A0FA CB 3F            srl a                   ; desplaza a la derecha, el bit bajo va al acarreo
 33+  A0FC 30 02            jr nc, np_sin_tap
 34+  A0FE EE B4            xor $B4                 ; polinomio de realimentacion
 35+  A100              np_sin_tap:
 36+  A100 32 B6 A5         ld (semilla), a
 37+  A103 E6 07            and 7
 38+  A105 FE 07            cp 7
 39+  A107 28 EE            jr z, np_tirar          ; descartamos el 7 -> uniforme 0..6. El reintento
 40+  A109                                          ;  queda por DEBAJO del push: no hay fuga de pila.
 41+  A109 87               add a, a                ; *2: cada entrada de la tabla son 2 bytes
 42+  A10A 21 4E A2         ld hl, spawn_table
 43+  A10D 16 00            ld d, 0
 43+  A10F 5F             ld e, a
 44+  A110 19               add hl, de
 45+  A111 5E               ld e, (hl)
 45+  A112 23             inc hl
 45+  A113 56             ld d, (hl)
 46+  A114 E1               pop hl
 47+  A115 C9               ret
 48+  A116
 49+  A116              ; iniciar_secuencia -- semilla y primera pieza anunciada. Una vez por partida,
 50+  A116              ;   antes del primer seleccionar_pieza. Destruye AF.
 51+  A116              iniciar_secuencia:
 52+  A116 CD EB A0         call sembrar_azar
 53+  A119 D5               push de
 54+  A11A CD F6 A0         call nueva_pieza
 55+  A11D ED 53 B7 A5      ld (siguiente_pieza), de
 56+  A121 D1               pop de
 57+  A122 C9               ret
 58+  A123
 59+  A123              ; seleccionar_pieza -- pone en juego la pieza ya anunciada y sortea la
 60+  A123              ;   siguiente, de modo que el jugador siempre ve una por adelantado.
 61+  A123              ;   Salida: IX = registro de aparicion, B = 0 (fila), C = 15 (columna).
 62+  A123              ;   Destruye AF, BC, DE, IX. Preserva HL e IY.
 63+  A123              ;   C = 15 es la UNICA definicion de la columna de aparicion; (Medio) se deriva
 64+  A123              ;   de ella en juego.asm.
 65+  A123              seleccionar_pieza:
 66+  A123 E5               push hl                 ; la version anterior preservaba HL: lo mantenemos
 67+  A124 2A B7 A5         ld hl, (siguiente_pieza)
 68+  A127 E5               push hl                 ; la anunciada pasa a jugarse
 69+  A128 CD F6 A0         call nueva_pieza        ; DE = la proxima a anunciar
 70+  A12B ED 53 B7 A5      ld (siguiente_pieza), de
 71+  A12F D1               pop de                  ; DE = la que toca jugar ahora
 72+  A130 DD 62 DD 6B      ld ix, de               ; instruccion falsa de sjasmplus -> LD IXH,D : LD IXL,E
 73+  A134 E1               pop hl
 74+  A135 06 00            ld b, 0                 ; fila de aparicion
 75+  A137 0E 0F            ld c, 15                ; columna de aparicion
 76+  A139 C9               ret
 77+  A13A
 78+  A13A              ; ---------------------------------------------------------------------------
 79+  A13A              ; Vista previa de la proxima pieza
 80+  A13A              ;
 81+  A13A              ; Se dibuja FUERA del pozo a proposito: "ocupado" es "byte de atributo distinto
 82+  A13A              ; de cero", asi que cualquier cosa pintada en las columnas 7-24 se convertiria
 83+  A13A              ; en geometria solida. en_rango mantiene la pieza en juego dentro de esas
 84+  A13A              ; columnas, asi que el recuadro no puede tocarse nunca.
 85+  A13A              PREV_FILA EQU 10        ; esquina superior izquierda del recuadro
 86+  A13A              PREV_COL  EQU 27        ; columnas 27-30, filas 10-13: caja de 4x4
 87+  A13A
 88+  A13A              ; pintar_siguiente -- borra el recuadro y dibuja en el la pieza anunciada.
 89+  A13A              ;   Preserva AF, BC, DE, HL, IX, IY.
 90+  A13A              pintar_siguiente:
 91+  A13A F5               push af
 91+  A13B C5             push bc
 91+  A13C D5             push de
 91+  A13D E5             push hl
 91+  A13E DD E5          push ix
 92+  A140 06 0A            ld b, PREV_FILA
 93+  A142 16 04            ld d, 4                 ; 4 filas que limpiar
 94+  A144              ps_fila:
 95+  A144 0E 1B            ld c, PREV_COL
 96+  A146 CD 86 9C         call CRtoATTR           ; HL = direccion del atributo; PRESERVA BC
 97+  A149 36 00            ld (hl), 0
 97+  A14B 23             inc hl     ; las 4 celdas de la fila, a cero (negro), igual
 98+  A14C 36 00            ld (hl), 0
 98+  A14E 23             inc hl     ;  que el interior del pozo
 99+  A14F 36 00            ld (hl), 0
 99+  A151 23             inc hl
100+  A152 36 00            ld (hl), 0
101+  A154 04               inc b
102+  A155 15               dec d
103+  A156 20 EC            jr nz, ps_fila
104+  A158
105+  A158 DD 2A B7 A5      ld ix, (siguiente_pieza)
106+  A15C 06 0A            ld b, PREV_FILA
107+  A15E 0E 1B            ld c, PREV_COL
108+  A160 CD 5C A2         call pintar_tetromino
109+  A163 DD E1            pop ix
109+  A165 E1             pop hl
109+  A166 D1             pop de
109+  A167 C1             pop bc
109+  A168 F1             pop af
110+  A169 C9               ret
111+  A16A
# file closed: tetromino_next.asm
 38   A16A                  INCLUDE "piezas.asm"
# file opened: piezas.asm
  1+  A16A              ; Programa para definir y dibujar cada pieza o tetromino
  2+  A16A
  3+  A16A              ; Datos de los tetrominos: filas, columnas, patrón de bits, giros
  4+  A16A              ;Tetromino O
  5+  A16A 02 02 30 30  T_0: DB 2, 2, 6*8, 6*8, 6*8, 6*8, 0, 0
  5+  A16E 30 30 00 00
  5+  A172 6A A1 6A A1    DW T_0, T_0
  6+  A176              ;Tetromino L
  7+  A176 03 02 20 00  T_L1: DB 3, 2, 4*8, 0, 4*8, 0, 4*8, 4*8
  7+  A17A 20 00 20 20
  7+  A17E 82 A1 8E A1    DW T_L2, T_L3
  8+  A182 02 03 00 00  T_L2: DB 2, 3, 0, 0, 4*8, 4*8, 4*8, 4*8
  8+  A186 20 20 20 20
  8+  A18A 9A A1 76 A1    DW T_L4, T_L1
  9+  A18E 02 03 20 20  T_L3: DB 2, 3, 4*8, 4*8, 4*8, 4*8, 0, 0
  9+  A192 20 20 00 00
  9+  A196 76 A1 9A A1    DW T_L1, T_L4
 10+  A19A 03 02 20 20  T_L4: DB 3, 2, 4*8, 4*8, 0, 4*8, 0, 4*8
 10+  A19E 00 20 00 20
 10+  A1A2 8E A1 82 A1    DW T_L3, T_L2
 11+  A1A6              ;Tetromino J
 12+  A1A6 03 02 00 10  T_J1: DB 3, 2, 0, 2*8, 0, 2*8, 2*8, 2*8
 12+  A1AA 00 10 10 10
 12+  A1AE B2 A1 BE A1    DW T_J2, T_J3
 13+  A1B2 02 03 10 10  T_J2: DB 2, 3, 2*8, 2*8, 2*8, 0, 0, 2*8
 13+  A1B6 10 00 00 10
 13+  A1BA CA A1 A6 A1    DW T_J4, T_J1
 14+  A1BE 02 03 10 00  T_J3: DB 2, 3, 2*8, 0, 0, 2*8, 2*8, 2*8
 14+  A1C2 00 10 10 10
 14+  A1C6 A6 A1 CA A1    DW T_J1, T_J4
 15+  A1CA 03 02 10 10  T_J4: DB 3, 2, 2*8, 2*8, 2*8, 0, 2*8, 0
 15+  A1CE 10 00 10 00
 15+  A1D2 BE A1 B2 A1    DW T_J3, T_J2
 16+  A1D6              ;Tetromino T
 17+  A1D6 02 03 28 28  T_T1: DB 2, 3, 5*8, 5*8, 5*8, 0, 5*8, 0
 17+  A1DA 28 00 28 00
 17+  A1DE E2 A1 EE A1    DW T_T2, T_T3
 18+  A1E2 03 02 28 00  T_T2: DB 3, 2, 5*8, 0, 5*8, 5*8, 5*8, 0
 18+  A1E6 28 28 28 00
 18+  A1EA FA A1 D6 A1    DW T_T4, T_T1
 19+  A1EE 03 02 00 28  T_T3: DB 3, 2, 0, 5*8, 5*8, 5*8, 0, 5*8
 19+  A1F2 28 28 00 28
 19+  A1F6 D6 A1 FA A1    DW T_T1, T_T4
 20+  A1FA 02 03 00 28  T_T4: DB 2, 3, 0, 5*8, 0, 5*8, 5*8, 5*8
 20+  A1FE 00 28 28 28
 20+  A202 EE A1 E2 A1    DW T_T3, T_T2
 21+  A206              ;Tetromino I -- era 6*8, el mismo amarillo que la O. Ahora 1*8 (azul).
 22+  A206 04 01 08 08  T_I1: DB 4, 1, 1*8, 1*8, 1*8, 1*8, 0, 0
 22+  A20A 08 08 00 00
 22+  A20E 12 A2 12 A2    DW T_I2, T_I2
 23+  A212 01 04 08 08  T_I2: DB 1, 4, 1*8, 1*8, 1*8, 1*8, 0, 0
 23+  A216 08 08 00 00
 23+  A21A 06 A2 06 A2    DW T_I1, T_I1
 24+  A21E              ;Tetromino Z
 25+  A21E 02 03 38 38  T_Z1: DB 2, 3, 7*8, 7*8, 0, 0, 7*8, 7*8
 25+  A222 00 00 38 38
 25+  A226 2A A2 2A A2    DW T_Z2, T_Z2
 26+  A22A 03 02 00 38  T_Z2: DB 3, 2, 0, 7*8, 7*8, 7*8, 7*8, 0
 26+  A22E 38 38 38 00
 26+  A232 1E A2 1E A2    DW T_Z1, T_Z1
 27+  A236              ;Tetromino S -- era 7*8, el mismo blanco que la Z. Ahora 3*8 (magenta).
 28+  A236 02 03 00 18  T_S1: DB 2, 3, 0, 3*8, 3*8, 3*8, 3*8, 0
 28+  A23A 18 18 18 00
 28+  A23E 42 A2 42 A2    DW T_S2, T_S2
 29+  A242 03 02 18 00  T_S2: DB 3, 2, 3*8, 0, 3*8, 3*8, 0, 3*8
 29+  A246 18 18 00 18
 29+  A24A 36 A2 36 A2    DW T_S1, T_S1
 30+  A24E
 31+  A24E              ; Estados de aparicion, uno por FORMA (no por giro). Son datos de SOLO LECTURA,
 32+  A24E              ; asi que no les afecta el problema de adyacencia que tenia "Medio": al elegir
 33+  A24E              ; de aqui, nada vuelve a indexar aritmeticamente la tabla de registros, con lo
 34+  A24E              ; que desaparece el riesgo de que un indice se pase del ultimo registro.
 35+  A24E 6A A1 76 A1  spawn_table: DW T_0, T_L1, T_J1, T_T1, T_I1, T_Z1, T_S1
 35+  A252 A6 A1 D6 A1
 35+  A256 06 A2 1E A2
 35+  A25A 36 A2
 36+  A25C
 37+  A25C              ; "Medio" (la columna en curso) vivia aqui, incrustado en la imagen de codigo
 38+  A25C              ; justo detras del ultimo registro de pieza y sin ningun margen. Ahora esta en
 39+  A25C              ; variables.asm, con el resto del estado mutable.
 40+  A25C
 41+  A25C              ; Rutina para pintar el tetromino en pantalla
 42+  A25C              pintar_tetromino:
 43+  A25C F5               push af
 44+  A25D FD E5            push iy
 45+  A25F E5               push hl
 46+  A260 D5               push de
 47+  A261 C5               push bc
 48+  A262 F3               di                     ; IY va a apuntar al patron; la ROM ($0038) exige IY=$5C3A
 49+  A263
 50+  A263 CD AB 9B         call CalcularAtributo  ; Calcular la dirección en HL
 51+  A266 DD 46 00         ld b, (ix)             ; Obtener filas en B
 52+  A269 DD 4E 01         ld c, (ix+1)           ; Obtener columnas en C
 53+  A26C DD E5 FD E1      ld iy, ix
 54+  A270 FD 23            inc iy
 54+  A272 FD 23          inc iy        ; Ajustar IY a la dirección del patrón de bits del tetromino
 55+  A274
 56+  A274              pintar_loop:
 57+  A274 FD 7E 00         ld a, (iy)
 58+  A277 FD 23            inc iy
 59+  A279 FE 00            cp 0                   ; Verificar si el byte es cero
 60+  A27B 28 01            jr z, siguiente_byte
 61+  A27D
 62+  A27D 77               ld (hl), a             ; Pintar el byte en pantalla
 63+  A27E              siguiente_byte:
 64+  A27E 23               inc hl                 ; Mover a la siguiente posición en memoria de video
 65+  A27F 0D               dec c                  ; Decrementar el contador de columnas
 66+  A280 20 F2            jr nz, pintar_loop     ; Repetir hasta que C sea cero
 67+  A282
 68+  A282 DD 4E 01         ld c, (ix+1)           ; Resetear C para la siguiente fila
 69+  A285 3E 20            ld a, 32
 70+  A287 91               sub c
 71+  A288 16 00            ld d, 0
 72+  A28A 5F               ld e, a
 73+  A28B 19               add hl, de             ; Mover a la siguiente fila en memoria de video
 74+  A28C 10 E6            djnz pintar_loop       ; Repetir para todas las filas
 75+  A28E
 76+  A28E C1               pop bc
 77+  A28F D1               pop de
 78+  A290 E1               pop hl
 79+  A291 FD E1            pop iy
 80+  A293 FB               ei                     ; IY ya vale lo que tenia el llamante: seguro reanudar
 81+  A294 F1               pop af
 82+  A295
 83+  A295 C9               ret
 84+  A296
# file closed: piezas.asm
 39   A296                  INCLUDE "test_col.asm"
# file opened: test_col.asm
  1+  A296              ;Programa para validar la colision
  2+  A296
  3+  A296              comprobar:
  4+  A296 DD E5            push ix
  5+  A298 FD E5            push iy
  6+  A29A E5               push hl
  7+  A29B D5               push de
  8+  A29C C5               push bc
  9+  A29D F3               di                   ; IY va a apuntar al patron; la ROM ($0038) exige IY=$5C3A
 10+  A29E
 11+  A29E CD AB 9B         CALL CalcularAtributo
 12+  A2A1                  ; Configurar las filas y columnas del tetromino
 13+  A2A1 DD 46 00         ld b, (ix)           ; Filas en B
 14+  A2A4 DD 4E 01         ld c, (ix+1)         ; Columnas en C
 15+  A2A7 DD E5 FD E1      ld iy, ix
 16+  A2AB FD 23            inc iy
 17+  A2AD FD 23            inc iy               ; Ajustar IY a la dirección del patrón de bits del tetromino
 18+  A2AF
 19+  A2AF              validar_fila:
 20+  A2AF FD 7E 00         ld a, (iy)
 21+  A2B2 FD 23            inc iy
 22+  A2B4 B7               or a
 23+  A2B5 28 04            jr z, siguiente_cuadro
 24+  A2B7
 25+  A2B7 7E               ld a, (hl)
 26+  A2B8 B7               or a
 27+  A2B9 20 14            jr nz, colision_detectada
 28+  A2BB
 29+  A2BB              siguiente_cuadro:
 30+  A2BB 23               inc hl
 31+  A2BC 0D               dec c
 32+  A2BD 20 F0            jr nz, validar_fila
 33+  A2BF
 34+  A2BF                  ; Avanzar a la siguiente fila del tetromino
 35+  A2BF DD 4E 01         ld c, (ix+1)
 36+  A2C2 3E 20            ld a, 32
 37+  A2C4 91               sub c
 38+  A2C5 16 00            ld d, 0
 39+  A2C7 5F               ld e, a
 40+  A2C8 19               add hl, de
 41+  A2C9 10 E4            djnz validar_fila
 42+  A2CB
 43+  A2CB 3E 00            ld a, 0              ; No hay colisión
 44+  A2CD 18 02            jr fin_comprobacion
 45+  A2CF
 46+  A2CF              colision_detectada:
 47+  A2CF 3E 01            ld a, 1              ; Colisión detectada
 48+  A2D1
 49+  A2D1              fin_comprobacion:
 50+  A2D1 C1               pop bc
 51+  A2D2 D1               pop de
 52+  A2D3 E1               pop hl
 53+  A2D4 FD E1            pop iy
 54+  A2D6 FB               ei                   ; IY ya vale lo que tenia el llamante: seguro reanudar
 55+  A2D7 DD E1            pop ix               ; AF no se restaura a proposito: A es el valor de retorno
 56+  A2D9
 57+  A2D9 C9               ret
# file closed: test_col.asm
 40   A2DA                  INCLUDE "clear.asm"
# file opened: clear.asm
  1+  A2DA              ; Programa para borrar un tetromino de la pantalla
  2+  A2DA
  3+  A2DA              borrar_tetromino:
  4+  A2DA F5               push af
  5+  A2DB FD E5            push iy
  6+  A2DD E5               push hl
  7+  A2DE D5               push de
  8+  A2DF C5               push bc
  9+  A2E0 F3               di                    ; IY va a apuntar al patron; la ROM ($0038) exige IY=$5C3A
 10+  A2E1
 11+  A2E1 CD AB 9B         call CalcularAtributo
 12+  A2E4 DD 46 00         ld b, (ix)            ; Guardar filas en B
 13+  A2E7 DD 4E 01         ld c, (ix+1)          ; Guardar columnas en C
 14+  A2EA DD E5 FD E1      ld iy, ix
 15+  A2EE FD 23            inc iy
 16+  A2F0 FD 23            inc iy                ; Ajustar IY a la dirección del patrón de bits del tetromino
 17+  A2F2
 18+  A2F2              loop_filas:
 19+  A2F2 DD 4E 01         ld c, (ix+1)          ; Restaurar columnas en C para la nueva fila
 20+  A2F5              loop_columnas:
 21+  A2F5 FD 7E 00         ld a, (iy)            ; Cargar el byte del patrón del tetromino
 22+  A2F8 FD 23            inc iy
 23+  A2FA B7               or a                  ; Verificar si el byte es cero
 24+  A2FB 28 02            jr z, siguiente_columna ; Si es cero, saltar a la siguiente columna
 25+  A2FD
 26+  A2FD 36 00            ld (hl), 0            ; Borrar el byte en pantalla
 27+  A2FF
 28+  A2FF              siguiente_columna:
 29+  A2FF 23               inc hl                ; Mover a la siguiente posición en memoria de video
 30+  A300 0D               dec c                 ; Decrementar el contador de columnas
 31+  A301 20 F2            jr nz, loop_columnas  ; Repetir hasta que C sea cero
 32+  A303
 33+  A303 3E 20            ld a, 32
 34+  A305 DD 96 01         sub (ix+1)            ; Calcular el offset para la siguiente fila
 35+  A308 16 00            ld d, 0
 36+  A30A 5F               ld e, a
 37+  A30B 19               add hl, de            ; Mover a la siguiente fila en memoria de video
 38+  A30C 10 E4            djnz loop_filas       ; Repetir para todas las filas
 39+  A30E
 40+  A30E C1               pop bc
 41+  A30F D1               pop de
 42+  A310 E1               pop hl
 43+  A311 FD E1            pop iy
 44+  A313 FB               ei                    ; IY ya vale lo que tenia el llamante: seguro reanudar
 45+  A314 F1               pop af
 46+  A315
 47+  A315 C9               ret
