  8+  9C53              ; PRINTAT - Print a string in a position and attributes as per registers:
  9+  9C53              ;		IN	A	: Bit 7=1 For Flash / Bit 6=1 For Brigh / Bit 5,4,3 for Paper / Bit 2,1,0 for Ink
 10+  9C53              ;		IN	B	: Row 0..23
 11+  9C53              ;		IN	C	: Column 0..31
 12+  9C53              ;		IN	IX	: Address of text (Text must end in a 0)
 13+  9C53              ; ----------------------------------------------------------------------------------------
 14+  9C53 CD 62 9C     PRINTAT:	CALL PREP_PRT				; Update Attribute var &Screen & Attributes pointers
 15+  9C56              ; ----------------------------------------------------------------------------------------
 16+  9C56              ;		VVV Do not move PRINTSTR below as PRINTAT continues into PRINTSTR routine
 17+  9C56              ; ----------------------------------------------------------------------------------------
 18+  9C56              ; PRINTSTR - Prints String - IX Points to the String start
 19+  9C56              ; ----------------------------------------------------------------------------------------
 20+  9C56 DD 7E 00     PRINTSTR:   LD A,(IX)					; A Contains first char to print
 21+  9C59 B7           			OR A						; check for end of string (0)
 22+  9C5A C8           			RET Z						; Finish printing if 0
 23+  9C5B CD 90 9C     			CALL PRINTCHNUM
 24+  9C5E DD 23        			INC IX						; Move to next char in string
 25+  9C60 18 F4        			JR PRINTSTR					; Start over printing sequence
 26+  9C62              ; ----------------------------------------------------------------------------------------
