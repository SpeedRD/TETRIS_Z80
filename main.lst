 45   A671                  INCLUDE "relleno.asm"
# file opened: relleno.asm
  1+  A671              ; relleno.asm -- animacion de relleno del pozo al perder la partida
  2+  A671              ;
  3+  A671              ; Al llegar a fin_partida (juego.asm) el pozo se llena de bloques de abajo
  4+  A671              ; arriba antes de cortar a la pantalla de fin de partida, en vez del corte seco
  5+  A671              ; de antes.
  6+  A671              ;
  7+  A671              ; TIEMPO. Aqui ya no rige el presupuesto de frame del bucle de juego
  8+  A671              ; (interrupts-and-timing seccion 2): el bucle ha TERMINADO -- fin_partida es lo
  9+  A671              ; ultimo que se ejecuta de la partida -- asi que no hay entrada que leer, ni
 10+  A671              ; gravedad que contar, ni pieza viva que repintar. Lo que si sigue rigiendo es
 11+  A671              ; el desgarro: escribir en el fichero de atributos mientras la ULA esta
 12+  A671              ; leyendo la zona visible se ve. Por eso cada fila se pinta JUSTO detras de un
 13+  A671              ; HALT, en el borde superior, igual que el borrado y el repintado del bucle:
 14+  A671              ; 18 escrituras de atributo (~400 T) caben de sobra en la ventana de ~14.000 T.
 15+  A671              ;
 16+  A671              ; Y sigue rigiendo el estado de interrupciones: HALT solo vuelve si estan
 17+  A671              ; habilitadas. Lo estan -- main.asm:7-10 las deja activas con IY = $5C3A y
 18+  A671              ; ninguna de las parejas di/ei del arbol (piezas.asm, clear.asm, test_col.asm,
 19+  A671              ; tableroJuego.asm) vuelve sin reactivarlas. Esta rutina no toca IY, asi que no
 20+  A671              ; necesita pareja propia.
 21+  A671              ;
 22+  A671              ; Por eso la animacion es frame a frame y no una sola pasada rapida: una pasada
 23+  A671              ; unica no seria mas segura -- solo mas rapida y peor sincronizada -- y contar
 24+  A671              ; frames con HALT es lo que ya hace el juego. Lo que NO se hace en ningun caso
 25+  A671              ; es una espera por bucle vacio: su velocidad depende del emulador
 26+  A671              ; (interrupts-and-timing seccion 4).
 27+  A671              ;
 28+  A671              ; No toca ni PUNTOS, ni LINEAS, ni NIVEL, ni MEJOR: solo escribe en el fichero
 29+  A671              ; de atributos, entre $5800 y $5AFF. La captura del record (ActualizarMejor)
 30+  A671              ; ocurre despues, ya dentro de Pantalla_Final, y lee un PUNTOS intacto.
 31+  A671
 32+  A671              RELL_FILA_BAJA   EQU 21     ; ultima fila del interior del pozo (la 22 es el suelo)
 33+  A671              RELL_COL_IZQ     EQU 7      ; primera columna del interior
 34+  A671              RELL_ANCHO       EQU 18     ; columnas 7-24
 35+  A671              RELL_FRAMES_FILA EQU 3      ; frames por fila: 22 filas x 3 = 66 frames, ~1,3 s
 36+  A671              RELL_PAUSA       EQU 25     ; ~0,5 s con el pozo lleno antes de cambiar de
 37+  A671                                          ;  pantalla, para que se vea el resultado
 38+  A671                                          ; total ~91 frames, ~1,8 s
 39+  A671
 40+  A671              ; relleno_pozo -- llena el interior del pozo de abajo arriba.
 41+  A671              ;   Sin entrada ni salida. Preserva AF, BC, DE, HL, IX, IY.
 42+  A671              relleno_pozo:
 43+  A671 F5               push af
 43+  A672 C5             push bc
 43+  A673 D5             push de
 43+  A674 E5             push hl
 44+  A675 06 15            ld b, RELL_FILA_BAJA
 45+  A677 0E 07            ld c, RELL_COL_IZQ       ; CRtoATTR toma (B,C) y preserva BC
 46+  A679 16 01            ld d, 1                  ; D = color en curso, 1..7
 47+  A67B              rp_fila:
 48+  A67B 1E 03            ld e, RELL_FRAMES_FILA
 49+  A67D              rp_esperar:
 50+  A67D 76               HALT                     ; dormimos hasta el tick de 50 Hz
 51+  A67E 1D               dec e
 52+  A67F 20 FC            jr nz, rp_esperar
 53+  A681
 54+  A681 CD 3D 9D         call CRtoATTR            ; HL = atributo de (B,7), ya en el borde superior
 55+  A684 7A               ld a, d
 56+  A685 87               add a, a
 56+  A686 87             add a, a
 56+  A687 87             add a, a   ; color*8 = PAPEL, tinta 0: la misma
 57+  A688                                                   ;  codificacion que las piezas (piezas.asm)
 58+  A688 1E 12            ld e, RELL_ANCHO
 59+  A68A              rp_celda:
 60+  A68A 77               ld (hl), a
 61+  A68B 23               inc hl
 62+  A68C 1D               dec e
 63+  A68D 20 FB            jr nz, rp_celda
 64+  A68F
 65+  A68F 14               inc d                    ; siguiente color de la paleta de las piezas
 66+  A690 7A               ld a, d
 67+  A691 FE 08            cp 8
 68+  A693 38 02            jr c, rp_fila_hecha
 69+  A695 16 01            ld d, 1                  ; 1..7: los siete que ya usan los tetrominos
 70+  A697              rp_fila_hecha:
 71+  A697 78               ld a, b
 72+  A698 B7               or a
 73+  A699 28 03            jr z, rp_pausa           ; acabamos de pintar la fila 0: el pozo esta lleno
 74+  A69B 05               dec b                    ; subimos una fila
 75+  A69C 18 DD            jr rp_fila
 76+  A69E
 77+  A69E              rp_pausa:
 78+  A69E 06 19            ld b, RELL_PAUSA
 79+  A6A0              rp_pausa_bucle:
 80+  A6A0 76               HALT
 81+  A6A1 10 FD            djnz rp_pausa_bucle
 82+  A6A3 E1               pop hl
 82+  A6A4 D1             pop de
 82+  A6A5 C1             pop bc
 82+  A6A6 F1             pop af
 83+  A6A7 C9               ret
 84+  A6A8
# file closed: relleno.asm
 46   A6A8                  INCLUDE "musica.asm"
# file opened: musica.asm
  1+  A6A8              ; musica.asm -- musica de fondo en el altavoz de 1 bit. Korobeiniki.
  2+  A6A8              ;
  3+  A6A8              ; Diseno, presupuesto y decisiones: MUSIC_DESIGN.md. Lo imprescindible aqui:
  4+  A6A8              ;
  5+  A6A8              ;   * Presupuesto: 48.000 T por trama para el relleno de sonido (MUSIC_DESIGN 5),
  6+  A6A8              ;     de las 69.888 que tiene una trama de 48K. Se gasta EN CADA llamada, no de
  7+  A6A8              ;     media: la cuenta de semiperiodos de cada nota ya viene calculada para que
  8+  A6A8              ;     el producto cuenta x semiperiodo no pase de ahi.
  9+  A6A8              ;   * La llamada va al FINAL del cuerpo del bucle, detras del repintado
 10+  A6A8              ;     (MUSIC_DESIGN 7 regla 1). El par borrar/pintar tiene que seguir pegado al
 11+  A6A8              ;     HALT, dentro del borde superior, o la pieza se desgarra.
 12+  A6A8              ;   * Aqui NO se hace DI (MUSIC_DESIGN 7 regla 2). La interrupcion de la ULA es
 13+  A6A8              ;     un pulso corto: si se tapa no se retrasa, se PIERDE, y el HALT siguiente
 14+  A6A8              ;     espera una trama entera -> 25 fps. Se acepta el hueco de 889 T de la
 15+  A6A8              ;     rutina de la ROM. Este fichero no toca IY, asi que no necesita ninguna
 16+  A6A8              ;     pareja di/ei (interrupts-and-timing 1).
 17+  A6A8              ;   * Una trama que borra lineas va MUDA: ni siquiera un borrado de una fila
 18+  A6A8              ;     cabe con musica (MUSIC_DESIGN 6). Lo pide juego.asm por (musica_silencio).
 19+  A6A8              ;
 20+  A6A8              ; --- los dos drivers -------------------------------------------------------
 21+  A6A8              ;
 22+  A6A8              ; Coste de un semiperiodo, contado opcode a opcode sobre los dos bucles de
 23+  A6A8              ; abajo y confirmado midiendo T-estados en ZEsarUX:
 24+  A6A8              ;
 25+  A6A8              ;   mus_agudo (retardo DJNZ)     : 33 + 13 * C     C  = 1..255
 26+  A6A8              ;   mus_grave (retardo de 16 bits): 42 + 26 * HL   HL = 1..65535
 27+  A6A8              ;
 28+  A6A8              ; Se usa el driver DJNZ siempre que su constante quepa en un byte, porque su
 29+  A6A8              ; granularidad es de 13 T en vez de 26 y afina mejor; por debajo de ~523 Hz la
 30+  A6A8              ; constante pasa de 255 y hay que ir al de 16 bits. La frontera cae entre B4 y
 31+  A6A8              ; C5, la misma que en MUSIC_DESIGN 4.1.
 32+  A6A8              ;
 33+  A6A8              ; Esos dos numeros fijos (33 y 42) son de ESTOS bucles, no los 51,81 y 75,55 de
 34+  A6A8              ; MUSIC_DESIGN 4.1: aquellos venian de un banco de pruebas externo que nunca
 35+  A6A8              ; estuvo en el arbol. Un bucle mas corto necesita una constante de retardo mas
 36+  A6A8              ; larga para la misma nota, asi que las constantes de la tabla salen 1 o 2 por
 37+  A6A8              ; encima de las de la tabla de ejemplo de 4.1. Derivarlas del bucle que las
 38+  A6A8              ; toca es justo lo que mantiene la afinacion: copiar las del documento sobre un
 39+  A6A8              ; bucle mas corto desafinaria cada nota unos 4 cents hacia arriba.
 40+  A6A8              ;
 41+  A6A8              ; Error de afinacion peor de la tabla: -5,02 cents en G#5 (un semitono son 100,
 42+  A6A8              ; y el oido entrenado distingue 5-10 en el mejor de los casos). La tabla se
 43+  A6A8              ; genera y se vuelve a comprobar en tests/test_musica.py.
 44+  A6A8
 45+  A6A8              MUS_BIT     EQU %00010000   ; bit 4 del puerto $FE = altavoz
 46+  A6A8              MUS_BORDE   EQU %00000000   ; bits 0-2 = color del BORDE. NEGRO, decidido en
 47+  A6A8                                          ;  MUSIC_DESIGN 8: escribir $FE pone el borde
 48+  A6A8                                          ;  quieras o no, y no se puede leer para
 49+  A6A8                                          ;  conservarlo, asi que hay que elegir uno. Negro
 50+  A6A8                                          ;  es el papel que ya usan el pozo y los paneles.
 51+  A6A8              MUS_REPOSO  EQU MUS_BORDE   ; byte de reposo: borde negro y altavoz a 0
 52+  A6A8
 53+  A6A8              NOTA_SIL    EQU $FE         ; en la melodia: silencio que dura lo que diga
 54+  A6A8              NOTA_FIN    EQU $FF         ; en la melodia: fin -> se vuelve al principio
 55+  A6A8
 56+  A6A8              ; duraciones en TRAMAS de 50 Hz. Negra = 20 tramas = 400 ms -> 150 BPM, el
 57+  A6A8              ; tempo del original. La ultima trama de cada nota se calla siempre (hueco de
 58+  A6A8              ; articulacion, mas abajo), asi que ninguna duracion puede ser 1.
 59+  A6A8              D_COR       EQU 10          ; corchea
 60+  A6A8              D_NEG       EQU 20          ; negra
 61+  A6A8              D_NGP       EQU 30          ; negra con puntillo
 62+  A6A8              D_BLA       EQU 40          ; blanca
 63+  A6A8
 64+  A6A8              ; indices en tabla_notas. Cromatica de A3 a C6: el rango que pide la melodia.
 65+  A6A8              N_A3  EQU 0
 66+  A6A8              N_AS3 EQU 1
 67+  A6A8              N_B3  EQU 2
 68+  A6A8              N_C4  EQU 3
 69+  A6A8              N_CS4 EQU 4
 70+  A6A8              N_D4  EQU 5
 71+  A6A8              N_DS4 EQU 6
 72+  A6A8              N_E4  EQU 7
 73+  A6A8              N_F4  EQU 8
 74+  A6A8              N_FS4 EQU 9
 75+  A6A8              N_G4  EQU 10
 76+  A6A8              N_GS4 EQU 11
 77+  A6A8              N_A4  EQU 12
 78+  A6A8              N_AS4 EQU 13
 79+  A6A8              N_B4  EQU 14
 80+  A6A8              N_C5  EQU 15
 81+  A6A8              N_CS5 EQU 16
 82+  A6A8              N_D5  EQU 17
 83+  A6A8              N_DS5 EQU 18
 84+  A6A8              N_E5  EQU 19
 85+  A6A8              N_F5  EQU 20
 86+  A6A8              N_FS5 EQU 21
 87+  A6A8              N_G5  EQU 22
 88+  A6A8              N_GS5 EQU 23
 89+  A6A8              N_A5  EQU 24
 90+  A6A8              N_AS5 EQU 25
 91+  A6A8              N_B5  EQU 26
 92+  A6A8              N_C6  EQU 27
 93+  A6A8
 94+  A6A8              ; musica_frame -- avanza la melodia una trama y emite el tono de la nota actual.
 95+  A6A8              ;   Entrada: nada.  Salida: nada.
 96+  A6A8              ;   Preserva AF, BC, DE, HL, IX, IY -- el bucle sigue teniendo la pieza en
 97+  A6A8              ;   B, C e IX cuando esto vuelve (register-protocol). No hace DI ni EI.
 98+  A6A8              ;   Coste MEDIDO (cpu-step-over sobre las 28 notas de la tabla): 362 T de
 99+  A6A8              ;   gestion mas el relleno de tono. Peor relleno 47.920 T (B5) contra un
100+  A6A8              ;   presupuesto de 48.000; peor llamada completa 48.378 T, en la trama en que
101+  A6A8              ;   cambia de nota. Contra las 8.366 T de la peor pasada del juego quedan
102+  A6A8              ;   13.144 T libres en la trama. Las tramas que callan cuestan 202 T (borrado
103+  A6A8              ;   de lineas), 229 T (silencio de la melodia) o 187 T (ultima trama de nota).
104+  A6A8              musica_frame:
105+  A6A8 F5               push af
106+  A6A9 C5               push bc
107+  A6AA D5               push de
108+  A6AB E5               push hl
109+  A6AC
110+  A6AC 21 2B A8         ld hl, musica_silencio  ; la bandera es de UNA trama: se lee y se limpia
111+  A6AF 7E               ld a, (hl)              ;  SIEMPRE, aunque esta trama ya fuera a callar por
112+  A6B0 36 00            ld (hl), 0              ;  otro motivo, o se quedaria pendiente y amordazaria
113+  A6B2 4F               ld c, a                 ;  tambien la siguiente. C != 0 -> muda.
114+  A6B3
115+  A6B3 3A 2A A8         ld a, (musica_frames)   ; la nota anterior se agoto: toca la siguiente
116+  A6B6 B7               or a
117+  A6B7 20 03            jr nz, mf_misma
118+  A6B9 CD 08 A7         call mus_cargar         ; carga musica_nota y musica_frames de la melodia
119+  A6BC              mf_misma:
120+  A6BC 21 2A A8         ld hl, musica_frames
121+  A6BF 35               dec (hl)                ; consumimos esta trama
122+  A6C0 28 41            jr z, mf_fin            ; era la ULTIMA de la nota: se calla, y ese hueco de
123+  A6C2                                          ;  20 ms es lo que articula dos notas seguidas del
124+  A6C2                                          ;  MISMO tono (la melodia tiene tres parejas asi).
125+  A6C2                                          ;  Sin el, "A4 A4" suena como una sola nota larga.
126+  A6C2
127+  A6C2 79               ld a, c
128+  A6C3 B7               or a
129+  A6C4 20 3D            jr nz, mf_fin           ; trama con borrado de lineas: muda (MUSIC_DESIGN 6)
130+  A6C6
131+  A6C6 3A 29 A8         ld a, (musica_nota)
132+  A6C9 FE FE            cp NOTA_SIL
133+  A6CB 28 36            jr z, mf_fin            ; silencio pedido por la propia melodia
134+  A6CD
135+  A6CD 6F               ld l, a                 ; entrada de la nota = tabla_notas + 4*nota
136+  A6CE 26 00            ld h, 0
137+  A6D0 29               add hl, hl
138+  A6D1 29               add hl, hl              ; 28 notas x 4 bytes = 112: 4*nota cabe en un byte
139+  A6D2 01 38 A7         ld bc, tabla_notas      ; (esto se lleva C, pero ya hemos mirado la bandera)
140+  A6D5 09               add hl, bc
141+  A6D6 7E               ld a, (hl)              ; selector: 0 = grave (16 bits), 1 = agudo (DJNZ)
142+  A6D7 23               inc hl
143+  A6D8 5E               ld e, (hl)              ; constante de retardo, byte bajo
144+  A6D9 23               inc hl
145+  A6DA 56               ld d, (hl)              ;  ... y alto: solo lo usa el driver grave
146+  A6DB 23               inc hl
147+  A6DC 46               ld b, (hl)              ; numero de semiperiodos de esta nota
148+  A6DD B7               or a
149+  A6DE 28 0F            jr z, mus_grave
150+  A6E0
151+  A6E0              ; --- driver agudo: retardo DJNZ, granularidad 13 T -------------------------
152+  A6E0              ; semiperiodo = 33 + 13*C.  A = byte del puerto, C = constante, E = cuenta.
153+  A6E0              ; B queda libre porque el retardo lo gasta con djnz.
154+  A6E0              mus_agudo:
155+  A6E0 4B               ld c, e                 ; la constante cabe en un byte en este driver
156+  A6E1 58               ld e, b                 ; E = cuenta de semiperiodos
157+  A6E2 AF               xor a                   ; A = MUS_REPOSO: borde negro, altavoz a 0
158+  A6E3              ma_medio:
159+  A6E3 EE 10            xor MUS_BIT             ;  7  conmutamos el altavoz
160+  A6E5 D3 FE            out ($FE), a            ; 11  y lo sacamos; bits 0-2 = borde negro
161+  A6E7 41               ld b, c                 ;  4  recargamos el retardo
162+  A6E8              ma_espera:
163+  A6E8 10 FE            djnz ma_espera          ; 13*(C-1) + 8
164+  A6EA 1D               dec e                   ;  4
165+  A6EB 20 F6            jr nz, ma_medio         ; 12
166+  A6ED 18 11            jr mf_reposo
167+  A6EF
168+  A6EF              ; --- driver grave: retardo de 16 bits, granularidad 26 T -------------------
169+  A6EF              ; semiperiodo = 42 + 26*HL.  DE = constante, B = cuenta, C = byte del puerto.
170+  A6EF              ; El byte del puerto vive en C y no en A porque el retardo necesita A para
171+  A6EF              ; probar si HL ha llegado a cero (el Z80 no da flags en "dec hl").
172+  A6EF              mus_grave:
173+  A6EF 0E 00            ld c, MUS_REPOSO
174+  A6F1              mg_medio:
175+  A6F1 79               ld a, c                 ;  4
176+  A6F2 EE 10            xor MUS_BIT             ;  7
177+  A6F4 4F               ld c, a                 ;  4
178+  A6F5 D3 FE            out ($FE), a            ; 11
179+  A6F7 62               ld h, d                 ;  4  HL = copia de trabajo de la constante
180+  A6F8 6B               ld l, e                 ;  4
181+  A6F9              mg_espera:
182+  A6F9 2B               dec hl                  ;  6
183+  A6FA 7C               ld a, h                 ;  4
184+  A6FB B5               or l                    ;  4
185+  A6FC 20 FB            jr nz, mg_espera        ; 12
186+  A6FE 10 F1            djnz mg_medio           ; 13
187+  A700
188+  A700              mf_reposo:
189+  A700 AF               xor a                   ; el altavoz queda SIEMPRE en reposo: la cuenta de
190+  A701 D3 FE            out ($FE), a            ;  semiperiodos puede ser impar, y dejarlo a 1 seria
191+  A703                                          ;  continua en el altavoz durante el resto de la
192+  A703                                          ;  trama. Tambien es lo unico que fija el borde.
193+  A703              mf_fin:
194+  A703 E1               pop hl                  ; espejo exacto de los push
195+  A704 D1               pop de
196+  A705 C1               pop bc
197+  A706 F1               pop af
198+  A707 C9               ret
199+  A708
200+  A708              ; mus_cargar -- toma de la melodia la siguiente pareja (nota, duracion).
201+  A708              ;   Entrada: nada.  Salida: (musica_nota) y (musica_frames) cargadas y
202+  A708              ;   (musica_puntero) avanzado.  Preserva BC, DE, IX, IY. Destruye AF y HL.
203+  A708              ;   BC importa: musica_frame lleva ahi la bandera de silencio cuando llama.
204+  A708              mus_cargar:
205+  A708 2A 27 A8         ld hl, (musica_puntero)
206+  A70B 7E               ld a, (hl)
207+  A70C FE FF            cp NOTA_FIN
208+  A70E 20 04            jr nz, mc_nota
209+  A710 21 A8 A7         ld hl, melodia          ; se acabo la melodia: volvemos al principio. Una
210+  A713 7E               ld a, (hl)              ;  sola relectura basta, porque la primera entrada
211+  A714              mc_nota:                    ;  de melodia nunca es NOTA_FIN.
212+  A714 32 29 A8         ld (musica_nota), a
213+  A717 23               inc hl
214+  A718 7E               ld a, (hl)              ; duracion en tramas; nunca 0 (ver D_COR y compania)
215+  A719 32 2A A8         ld (musica_frames), a
216+  A71C 23               inc hl
217+  A71D 22 27 A8         ld (musica_puntero), hl
218+  A720 C9               ret
219+  A721
220+  A721              ; musica_reiniciar -- devuelve el reproductor al principio de la melodia.
221+  A721              ;   Entrada: nada.  Salida: nada.  Preserva AF, BC, DE, HL, IX, IY.
222+  A721              ;   Deja las cuatro variables EXACTAMENTE en el valor inicial que declara
223+  A721              ;   variables.asm, sea cual sea el estado del que venga.
224+  A721              ;
225+  A721              ;   La llama reiniciar_marcador (puntuacion.asm) al empezar cada partida, junto
226+  A721              ;   con el resto del estado por-partida. Hace falta porque un fin de partida no
227+  A721              ;   borra la RAM: Pantalla_Final salta a inicializar, que solo rehace SP, asi
228+  A721              ;   que sin esto la melodia seguia donde la habia dejado la partida anterior.
229+  A721              ;   NO toca MEJOR ni nada del marcador: eso es de la SESION, no de la partida.
230+  A721              ;
231+  A721              ;   OJO -- mus_cargar NO sirve para esto y no hay que llamarla en su lugar.
232+  A721              ;   mus_cargar AVANZA la melodia, no la reinicia: lee la pareja que haya en
233+  A721              ;   musica_puntero (solo rebobina si justo es NOTA_FIN), adelanta el puntero dos
234+  A721              ;   bytes y deja musica_frames con la DURACION de esa nota en vez de 0. Y no
235+  A721              ;   toca musica_silencio. Usarla aqui se comeria una nota de la melodia en cada
236+  A721              ;   partida nueva -- empeorando el fallo en vez de arreglarlo -- y dejaria que
237+  A721              ;   una bandera de borrado de la partida anterior amordazase la primera trama
238+  A721              ;   de la nueva.
239+  A721              musica_reiniciar:
240+  A721 F5               push af
241+  A722 E5               push hl
242+  A723 21 A8 A7         ld hl, melodia
243+  A726 22 27 A8         ld (musica_puntero), hl ; la proxima pareja por leer es la primera
244+  A729 3E FE            ld a, NOTA_SIL
245+  A72B 32 29 A8         ld (musica_nota), a     ; todavia no suena nada
246+  A72E AF               xor a
247+  A72F 32 2A A8         ld (musica_frames), a   ; 0 = agotada, asi que la primera llamada a
248+  A732                                          ;  musica_frame carga ya la primera pareja
249+  A732 32 2B A8         ld (musica_silencio), a ; y esta trama no viene amordazada de antes
250+  A735 E1               pop hl
251+  A736 F1               pop af
252+  A737 C9               ret
253+  A738
254+  A738              ; --- tabla de notas --------------------------------------------------------
255+  A738              ; Datos de solo lectura, detras del ultimo ret. Cuatro bytes por nota:
256+  A738              ;   +0 selector de driver (0 = mus_grave, 1 = mus_agudo)
257+  A738              ;   +1 constante de retardo, byte bajo
258+  A738              ;   +2 constante de retardo, byte alto (0 en todo el tramo agudo)
259+  A738              ;   +3 numero de semiperiodos = 48000 / semiperiodo, truncado
260+  A738              ; La cuenta cambia con la nota para que el TIEMPO se mantenga constante: con
261+  A738              ; una cuenta fija de 8 semiperiodos, A3 costaria 63.632 T y B5 solo 14.176
262+  A738              ; (MUSIC_DESIGN 5). tests/test_musica.py vuelve a derivar los cuatro bytes de
263+  A738              ; cada fila con las dos formulas de la cabecera y los compara byte a byte.
