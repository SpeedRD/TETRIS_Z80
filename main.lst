  1+  A280              ;Programa para validar la colision
  2+  A280
  3+  A280              comprobar:
  4+  A280 DD E5            push ix
  5+  A282 FD E5            push iy
  6+  A284 E5               push hl
  7+  A285 D5               push de
  8+  A286 C5               push bc
  9+  A287 F3               di                   ; IY va a apuntar al patron; la ROM ($0038) exige IY=$5C3A
 10+  A288
 11+  A288 CD AB 9B         CALL CalcularAtributo
 12+  A28B                  ; Configurar las filas y columnas del tetromino
 13+  A28B DD 46 00         ld b, (ix)           ; Filas en B
 14+  A28E DD 4E 01         ld c, (ix+1)         ; Columnas en C
 15+  A291 DD E5 FD E1      ld iy, ix
 16+  A295 FD 23            inc iy
 17+  A297 FD 23            inc iy               ; Ajustar IY a la dirección del patrón de bits del tetromino
 18+  A299
 19+  A299              validar_fila:
 20+  A299 FD 7E 00         ld a, (iy)
 21+  A29C FD 23            inc iy
 22+  A29E B7               or a
 23+  A29F 28 04            jr z, siguiente_cuadro
 24+  A2A1
 25+  A2A1 7E               ld a, (hl)
 26+  A2A2 B7               or a
 27+  A2A3 20 14            jr nz, colision_detectada
 28+  A2A5
 29+  A2A5              siguiente_cuadro:
 30+  A2A5 23               inc hl
 31+  A2A6 0D               dec c
 32+  A2A7 20 F0            jr nz, validar_fila
 33+  A2A9
 34+  A2A9                  ; Avanzar a la siguiente fila del tetromino
 35+  A2A9 DD 4E 01         ld c, (ix+1)
 36+  A2AC 3E 20            ld a, 32
 37+  A2AE 91               sub c
 38+  A2AF 16 00            ld d, 0
 39+  A2B1 5F               ld e, a
 40+  A2B2 19               add hl, de
 41+  A2B3 10 E4            djnz validar_fila
 42+  A2B5
