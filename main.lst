 44   A3FD                  INCLUDE "puntuacion.asm"
# file opened: puntuacion.asm
  1+  A3FD              ; puntuacion.asm -- puntos, lineas, nivel y su marcador en pantalla
  2+  A3FD              ;
  3+  A3FD              ; Las VARIABLES (PUNTOS, LINEAS, NIVEL, PROX_NIVEL, FRAMES_POR_FILA) se
  4+  A3FD              ; declaran en variables.asm y SOLO alli: declararlas tambien aqui es un error
  5+  A3FD              ; de etiqueta duplicada. Este fichero aporta el codigo y sus tablas de solo
  6+  A3FD              ; lectura.
  7+  A3FD              ;
  8+  A3FD              ; El marcador se pinta en las columnas 26-31, FUERA del pozo. Es una
  9+  A3FD              ; restriccion de correccion, no de gusto: "ocupado" significa "byte de
 10+  A3FD              ; atributo distinto de cero", asi que cualquier texto dentro de las columnas
 11+  A3FD              ; 7-24 se convertiria en un muro invisible para comprobar.
 12+  A3FD
 13+  A3FD              NIVEL_MAX EQU 10
 14+  A3FD
 15+  A3FD 00 01 00 03  PUNTOS_POR_LINEA: DW $0100, $0300, $0500, $0800  ; BCD, indice (filas-1)*2
 15+  A401 00 05 00 08
 16+  A405 30 28 21 1B  FRAMES_POR_NIVEL: DB 48,40,33,27,22,18,15,12,10,8,6  ; niveles 0..10, a 50 fps
 16+  A409 16 12 0F 0C
 16+  A40D 0A 08 06
 17+  A410
 18+  A410              ; anotar_lineas -- contabiliza un borrado de lineas.
 19+  A410              ;   Entrada: A = filas eliminadas (0..4). Si es 0 no hace nada.
 20+  A410              ;   Actualiza puntos, lineas, nivel y velocidad, y refresca el marcador.
 21+  A410              ;   Preserva BC, DE, HL, IX, IY. Destruye AF.
 22+  A410              anotar_lineas:
 23+  A410 B7               or a
 24+  A411 C8               ret z                        ; no se elimino ninguna fila
 25+  A412 C5               push bc
 25+  A413 D5             push de
 25+  A414 E5             push hl
 25+  A415 DD E5          push ix
 26+  A417 F5               push af                      ; nos guardamos la cuenta
 27+  A418
 28+  A418 3D               dec a                        ; --- puntos: indice (filas-1)*2
 29+  A419 87               add a, a
 30+  A41A 5F               ld e, a
 30+  A41B 16 00          ld d, 0
 31+  A41D 21 FD A3         ld hl, PUNTOS_POR_LINEA
 32+  A420 19               add hl, de
 33+  A421 5E               ld e, (hl)
 33+  A422 23             inc hl
 33+  A423 56             ld d, (hl)   ; DE = premio en BCD
 34+  A424 CD 57 A4         call SumarPuntos
 35+  A427
 36+  A427 F1               pop af                       ; --- lineas y nivel, una vuelta por fila
 37+  A428 47               ld b, a
 38+  A429              al_bucle:
 39+  A429 3A 84 A5         ld a, (LINEAS)
 39+  A42C 3C             inc a
 39+  A42D 32 84 A5       ld (LINEAS), a
 40+  A430 3A 86 A5         ld a, (PROX_NIVEL)
 40+  A433 3D             dec a
 40+  A434 32 86 A5       ld (PROX_NIVEL), a
 41+  A437 20 10            jr nz, al_siguiente
 42+  A439 3E 0A            ld a, 10
 42+  A43B 32 86 A5       ld (PROX_NIVEL), a      ; otras 10 filas hasta el proximo nivel
 43+  A43E 3A 85 A5         ld a, (NIVEL)
 44+  A441 FE 0A            cp NIVEL_MAX
 45+  A443 30 04            jr nc, al_siguiente                ; ya estamos en el tope
 46+  A445 3C               inc a
 46+  A446 32 85 A5       ld (NIVEL), a
 47+  A449              al_siguiente:
 48+  A449 10 DE            djnz al_bucle
 49+  A44B
 50+  A44B CD 6A A4         call ActualizarVelocidad
 51+  A44E CD EB A4         call ImprimirMarcador
 52+  A451 DD E1            pop ix
 52+  A453 E1             pop hl
 52+  A454 D1             pop de
 52+  A455 C1             pop bc
 53+  A456 C9               ret
 54+  A457
 55+  A457              ; SumarPuntos -- suma DE (BCD de 4 digitos) al marcador de 6 digitos.
 56+  A457              ;   Destruye AF y HL.
 57+  A457              SumarPuntos:
 58+  A457 21 81 A5         LD HL, PUNTOS
 59+  A45A 7E               LD A, (HL)
 59+  A45B 83             ADD A, E
 59+  A45C 27             DAA
 59+  A45D 77             LD (HL), A          ; DAA vuelve decimal la
 60+  A45E 23               INC HL
 60+  A45F 7E             LD A, (HL)
 60+  A460 8A             ADC A, D
 60+  A461 27             DAA
 60+  A462 77             LD (HL), A ;  suma binaria. LD no
 61+  A463 23               INC HL
 61+  A464 7E             LD A, (HL)
 61+  A465 CE 00          ADC A, 0
 61+  A467 27             DAA
 61+  A468 77             LD (HL), A ;  toca flags: el
 62+  A469 C9               RET                                               ;  acarreo sobrevive.
 63+  A46A
 64+  A46A              ; ActualizarVelocidad -- copia la velocidad del nivel actual a la gravedad.
 65+  A46A              ;   Destruye AF, DE y HL.
 66+  A46A              ActualizarVelocidad:
 67+  A46A 3A 85 A5         LD A, (NIVEL)
 68+  A46D FE 0A            CP NIVEL_MAX
 68+  A46F 38 02          JR C, NivelOK
 69+  A471 3E 0A            LD A, NIVEL_MAX             ; tope: nunca indexar mas alla de la tabla
 70+  A473              NivelOK:
 71+  A473 5F               LD E, A
 71+  A474 16 00          LD D, 0
 72+  A476 21 05 A4         LD HL, FRAMES_POR_NIVEL
 72+  A479 19             ADD HL, DE
 73+  A47A 7E               LD A, (HL)
 73+  A47B 32 87 A5       LD (FRAMES_POR_FILA), A   ; suelo de 6 frames (~120 ms):
 74+  A47E C9               RET                                    ;  una tabla no puede dar 0
 75+  A47F
 76+  A47F              ; reiniciar_marcador -- pone el marcador a cero y pinta rotulos y valores.
 77+  A47F              ;   Se llama al empezar una partida, cuando aun no hay ninguna pieza en juego.
 78+  A47F              ;   Preserva AF, BC, DE, HL, IX, IY.
 79+  A47F              reiniciar_marcador:
 80+  A47F F5               push af
 80+  A480 C5             push bc
 80+  A481 D5             push de
 80+  A482 E5             push hl
 80+  A483 DD E5          push ix
