 41   A300                  INCLUDE "giro.asm"
# file opened: giro.asm
  1+  A300              GIRAR:
  2+  A300              ;--------------------------------------------------------------------
  3+  A300              ;Gira la pieza actual: valida, aplica retranqueo (wall kick) y CONFIRMA
  4+  A300              ;aqui dentro. El llamante NO debe volver a comprobar el resultado.
  5+  A300              ;
  6+  A300              ;No lee el teclado ni espera a que se suelte ninguna tecla: el bucle
  7+  A300              ;llama a leer_teclas una vez por pasada y pasa la direccion en A. Leer
  8+  A300              ;aqui dejaria la pieza invisible entre el borrado y el repintado.
  9+  A300              ;
 10+  A300              ;Param. de Entrada: IX = registro actual, B = fila, C = columna,
 11+  A300              ;                   (Medio) = columna, A = 0 girar izquierda (Q),
 12+  A300              ;                   A distinto de 0 girar derecha (W)
 13+  A300              ;Param. de Salida : si cabe -> IX = registro nuevo, C y (Medio) = columna nueva
 14+  A300              ;                   si no cabe -> IX, C y (Medio) intactos
 15+  A300              ;Destruye AF y DE. Preserva B, HL, IY. C es SALIDA si el giro cabe.
 16+  A300              ;--------------------------------------------------------------------
 17+  A300 E5               PUSH HL
 18+  A301 B7               OR  A
 19+  A302 20 08            JR  NZ, giro_der
 20+  A304 DD 56 09         LD  D,(IX + 9)          ; +8/+9 = sucesor al girar a la izquierda
 21+  A307 DD 5E 08         LD  E,(IX + 8)          ;  (byte bajo primero)
 22+  A30A 18 06            JR  giro_probar
 23+  A30C              giro_der:
 24+  A30C DD 56 0B         LD  D,(IX + 11)         ; +10/+11 = sucesor al girar a la derecha
 25+  A30F DD 5E 0A         LD  E,(IX + 10)
 26+  A312
 27+  A312              giro_probar:
 28+  A312 DD E5            PUSH IX                 ; estado al que volver si no cabe en ningun sitio
 29+  A314 DD 7E 01         LD  A,(IX + 1)          ; ancho de la pieza VIEJA: leerlo antes de mover IX
 30+  A317 DD 62 DD 6B      LD  IX, DE              ; IX = estado candidato (instruccion falsa, ver
 31+  A31B                                          ;  assembler-conventions: LD IXH,D : LD IXL,E)
 32+  A31B DD 96 01         SUB (IX + 1)            ; A = ancho_viejo - ancho_nuevo, con signo (-3..+3)
 33+  A31E F2 22 A3         JP  P, giro_media
 34+  A321 3C               INC A                   ; los negativos deben redondear hacia cero, no hacia
 35+  A322              giro_media:                 ;  -infinito, para que girar e desgirar vuelva a la
 36+  A322 CB 2F            SRA A                   ;  misma columna. A = (viejo-nuevo)/2
 37+  A324 81               ADD A, C                ; anclamos por el centro, no por la esquina superior
 38+  A325 5F               LD  E, A                ; E = columna base recentrada: aun es una CANDIDATA
 39+  A326 21 4C A3         LD  HL, giro_kicks
 40+  A329
 41+  A329              giro_bucle:
 42+  A329 7E               LD  A,(HL)
 43+  A32A 23               INC HL
 44+  A32B FE 80            CP  $80                 ; centinela: se han agotado las candidatas
 45+  A32D 28 15            JR  Z, giro_deshacer
 46+  A32F 83               ADD A, E                ; columna candidata = base recentrada + retranqueo
 47+  A330 4F               LD  C, A                ; las dos pruebas leen la fila de B y la columna de C
 48+  A331 CD 77 A3         CALL en_rango           ; PRUEBA 1 geometria: ¿cabe entera en las columnas
 49+  A334 B7               OR  A                   ;  7-24? comprobar no puede ver esto
 50+  A335 20 F2            JR  NZ, giro_bucle
 51+  A337 CD 80 A2         CALL comprobar          ; PRUEBA 2 solape: A=0 cabe, A=1 choca con un bloque
 52+  A33A B7               OR  A                   ;  o con el borde. Preserva BC/DE/HL/IX/IY.
 53+  A33B 20 EC            JR  NZ, giro_bucle
 54+  A33D 79               LD  A, C
 55+  A33E 32 8D A5         LD  (Medio), A          ; CONFIRMAMOS tambien la columna en memoria: el bucle
 56+  A341 D1               POP DE                  ;  recarga C desde Medio y deshariamos el retranqueo.
 57+  A342 18 06            JR  giro_fin            ; descartamos el IX viejo: vale el nuevo
 58+  A344
 59+  A344              giro_deshacer:
 60+  A344 DD E1            POP IX                  ; no cabia en ningun sitio: recuperamos la forma...
 61+  A346 3A 8D A5         LD  A,(Medio)
 62+  A349 4F               LD  C, A                ; ...y la columna. (Medio) es la copia de respaldo de C.
 63+  A34A              giro_fin:
 64+  A34A E1               POP HL
 65+  A34B C9               RET
 66+  A34C
 67+  A34C 00 FF 01 FE  giro_kicks: DB 0, -1, 1, -2, 2, $80   ; en el sitio, luego 1 y luego 2 celdas a
 67+  A350 02 80
 68+  A352                                                    ; cada lado. Datos de solo lectura,
 69+  A352                                                    ; despues del RET: nunca se ejecutan.
 70+  A352
# file closed: giro.asm
 42   A352                  INCLUDE "entrada.asm"
# file opened: entrada.asm
  1+  A352              ; entrada.asm -- lectura de teclado no bloqueante y limite lateral del pozo
  2+  A352              ;
  3+  A352              ; Sustituye a las dos esperas de "soltar tecla" (giro.asm, movimiento.asm), que
  4+  A352              ; congelaban gravedad y dibujado mientras una tecla estuviera pulsada.
  5+  A352
  6+  A352              COL_IZQ_POZO EQU 7    ; primera columna interior del pozo
  7+  A352              COL_DER_POZO EQU 24   ; ultima columna interior del pozo
  8+  A352
  9+  A352              ; leer_teclas -- lectura no bloqueante con deteccion de flanco.
 10+  A352              ;   Llamar UNA sola vez por pasada del bucle.
 11+  A352              ;   Salida: A = mascara de las teclas que han pasado de SUELTA a PULSADA desde
 12+  A352              ;           la llamada anterior:
 13+  A352              ;             bit0 = K (derecha)   bit1 = J (izquierda)
 14+  A352              ;             bit2 = Q (giro izq)  bit3 = W (giro drcha)
 15+  A352              ;           A = 0 si no hay ninguna nueva.
 16+  A352              ;   Preserva BC, DE, HL, IX, IY. Destruye AF.
 17+  A352              leer_teclas:
 18+  A352 C5               push bc
 18+  A353 D5             push de
 18+  A354 E5             push hl
 19+  A355 01 FE BF         ld bc, $BFFE
 19+  A358 ED 78          in a,(c) ; media fila ENTER,L,K,J,H. ACTIVO A NIVEL BAJO:
 20+  A35A 2F               cpl                     ;  una tecla pulsada lee 0, asi que invertimos.
 21+  A35B 0F               rrca
 21+  A35C 0F             rrca             ;  K esta en el bit2 y J en el bit3: los bajamos.
 22+  A35D E6 03            and %00000011           ;  bit0 = K, bit1 = J (descarta bits 5-7, que no
 23+  A35F 5F               ld e, a                 ;  son teclado y tras el cpl valen basura)
 24+  A360 01 FE FB         ld bc, $FBFE
 24+  A363 ED 78          in a,(c) ; media fila Q,W,E,R,T: Q en bit0, W en bit1
 25+  A365 2F               cpl
 26+  A366 07               rlca
 26+  A367 07             rlca             ;  los subimos a los bits 2 y 3
 27+  A368 E6 0C            and %00001100           ;  bit2 = Q, bit3 = W
 28+  A36A B3               or e
 28+  A36B 5F             ld e, a          ; E = las cuatro teclas, 1 = pulsada AHORA
 29+  A36C 21 89 A5         ld hl, teclas_ant       ; un byte: la misma mascara de la llamada anterior
 30+  A36F 7E               ld a,(hl)
 30+  A370 73             ld (hl), e  ; leemos la vieja y guardamos la nueva
 31+  A371 2F               cpl
 31+  A372 A3             and e             ; suelta antes Y pulsada ahora = pulsacion NUEVA
 32+  A373 E1               pop hl
 32+  A374 D1             pop de
 32+  A375 C1             pop bc
 33+  A376 C9               ret
 34+  A377
 35+  A377              ; en_rango -- ¿cabe la pieza IX entera en la columna C?
 36+  A377              ;   comprobar no puede responder a esto: solo ve el borde porque su byte de
 37+  A377              ;   atributo es distinto de cero, asi que una candidata que se haya SALTADO el
 38+  A377              ;   borde lee celdas vacias fuera del pozo y la aceptaria.
 39+  A377              ;   Entrada: C = columna candidata, IX = registro de la pieza; (ix+1) = ancho.
 40+  A377              ;   Salida : A = 0 cabe, A = 1 se sale.
 41+  A377              ;   Preserva BC, DE, HL, IX, IY. Destruye AF.
 42+  A377              en_rango:
 43+  A377 79               ld a, c
 44+  A378 FE 07            cp COL_IZQ_POZO
 45+  A37A 38 0B            jr c, er_fuera          ; C < 7 -> a la izquierda de la pared izquierda
 46+  A37C DD 86 01         add a,(ix+1)            ; A = C + ancho
 47+  A37F 38 06            jr c, er_fuera          ; desbordo los 8 bits: C estaba lejisimos
 48+  A381 FE 1A            cp COL_DER_POZO + 2     ; la ultima celda es C+ancho-1 y debe ser <= 24,
 49+  A383 30 02            jr nc, er_fuera         ;  o sea C+ancho <= 25, o sea C+ancho < 26
 50+  A385 AF               xor a                   ; A = 0: todas las celdas caen entre 7 y 24
 51+  A386 C9               ret
 52+  A387              er_fuera:
 53+  A387 3E 01            ld a, 1
 54+  A389 C9               ret
 55+  A38A
# file closed: entrada.asm
 43   A38A                  INCLUDE "lineas.asm"
# file opened: lineas.asm
  1+  A38A              ; lineas.asm -- deteccion y borrado de lineas completas
  2+  A38A              ;
  3+  A38A              ; El fichero de atributos ES el tablero: una celda esta ocupada si su byte de
  4+  A38A              ; atributo es distinto de cero. El interior del pozo son las columnas 7-24
  5+  A38A              ; (18 celdas) y las filas 0-21; la fila 22 es el suelo y las columnas 6 y 25
  6+  A38A              ; son las paredes. NUNCA se escribe en el borde: nadie lo vuelve a pintar
  7+  A38A              ; despues de dibujar_tablero, y un solo byte suelto abre un agujero permanente.
  8+  A38A
  9+  A38A              COL_IZQ    EQU 7        ; primera columna interior
 10+  A38A              ANCHO_POZO EQU 18       ; ancho interior: columnas 7..24 inclusive
 11+  A38A              FILA_BAJA  EQU 21       ; fila interior mas baja (la 22 es el suelo)
 12+  A38A
 13+  A38A              ; limpiar_lineas -- elimina todas las filas completas y compacta el tablero.
 14+  A38A              ;   Entrada: nada.  Salida: A = numero de filas eliminadas (0..4 en la practica)
 15+  A38A              ;   Preserva BC, DE, HL, IX, IY. Destruye AF.
 16+  A38A              limpiar_lineas:
 17+  A38A C5               push bc
 17+  A38B D5             push de
 17+  A38C E5             push hl
 17+  A38D DD E5          push ix  ; BC = fila/columna de la pieza e
 18+  A38F 0E 00            ld c, 0                  ; C = cuenta de filas eliminadas
 19+  A391 06 15            ld b, FILA_BAJA          ; B = fila a examinar; empezamos abajo y subimos
 20+  A393              ll_probar:
 21+  A393 CD AD A3         call fila_llena
 21+  A396 B7             or a   ; A = 1 si la fila B esta completa
 22+  A397 28 06            jr z, ll_arriba          ; no lo esta -> subimos una fila
 23+  A399 0C               inc c
 24+  A39A CD C9 A3         call bajar_filas         ; bajamos sobre ella todo lo que tenia encima
 25+  A39D 18 F4            jr ll_probar             ; VOLVEMOS A PROBAR LA MISMA FILA B: tras el
 26+  A39F                                           ;  desplazamiento en el indice B hay una fila
 27+  A39F                                           ;  DISTINTA. Poner "dec b" aqui es el fallo
 28+  A39F                                           ;  clasico: un doble hueco borraria una sola fila.
 29+  A39F              ll_arriba:
 30+  A39F 78               ld a, b
 30+  A3A0 B7             or a
 31+  A3A1 28 03            jr z, ll_fin             ; la fila 0 era la ultima por probar -> hemos acabado
 32+  A3A3 05               dec b
 32+  A3A4 18 ED          jr ll_probar
 33+  A3A6              ll_fin:
 34+  A3A6 79               ld a, c                  ; devolvemos la cuenta; la consume puntuacion.asm
 35+  A3A7 DD E1            pop ix
 35+  A3A9 E1             pop hl
 35+  A3AA D1             pop de
 35+  A3AB C1             pop bc   ; espejo exacto de los push
 36+  A3AC C9               ret
 37+  A3AD
 38+  A3AD              ; fila_llena -- Entrada: B = fila 0..21.  Salida: A = 1 completa, 0 no.
 39+  A3AD              ;   Preserva BC, DE, HL. Destruye AF.
 40+  A3AD              fila_llena:
 41+  A3AD C5               push bc
 41+  A3AE D5             push de
 41+  A3AF E5             push hl
 42+  A3B0 0E 07            ld c, COL_IZQ
 43+  A3B2 CD 86 9C         call CRtoATTR            ; HL = $5800 + B*32 + 7. A diferencia de
 44+  A3B5                                           ;  CalcularAtributo, esta PRESERVA BC, que es lo
 45+  A3B5                                           ;  que mantiene vivo el contador de filas.
 46+  A3B5 1E 12            ld e, ANCHO_POZO         ; exactamente 18 celdas: nunca 32, o los bytes de
 47+  A3B7              fl_celda:                    ;  la pared (siempre 55) darian toda fila por llena
 48+  A3B7 7E               ld a, (hl)
 48+  A3B8 B7             or a
 49+  A3B9 28 08            jr z, fl_hueco           ; con una celda vacia basta: la fila no esta completa
 50+  A3BB 23               inc hl
 50+  A3BC 1D             dec e
 51+  A3BD 20 F8            jr nz, fl_celda          ; dec e fija los flags; inc hl no los toca
 52+  A3BF 3E 01            ld a, 1
 52+  A3C1 18 02          jr fl_fin
 53+  A3C3              fl_hueco:
 54+  A3C3 3E 00            ld a, 0
 55+  A3C5              fl_fin:
 56+  A3C5 E1               pop hl
 56+  A3C6 D1             pop de
 56+  A3C7 C1             pop bc
 57+  A3C8 C9               ret
 58+  A3C9
 59+  A3C9              ; bajar_filas -- Entrada: B = la fila recien eliminada (0..21).
 60+  A3C9              ;   Copia una fila hacia abajo todo lo que hay encima y deja la fila 0 vacia.
 61+  A3C9              ;   Preserva AF, BC, DE, HL.
 62+  A3C9              bajar_filas:
 63+  A3C9 F5               push af
 63+  A3CA C5             push bc
 63+  A3CB D5             push de
 63+  A3CC E5             push hl
 64+  A3CD 78               ld a, b
 64+  A3CE B7             or a           ; A = numero de copias a hacer = B
 65+  A3CF 28 19            jr z, bf_fila0           ; se elimino la fila 0: no hay nada encima
 66+  A3D1 0E 07            ld c, COL_IZQ
 67+  A3D3 CD 86 9C         call CRtoATTR            ; HL = destino = $5800 + B*32 + 7
 68+  A3D6 EB               ex de, hl                ; DE = destino
 69+  A3D7 21 E0 FF         ld hl, -32
 69+  A3DA 19             add hl, de  ; HL = origen = destino - 32 = una fila mas arriba
 70+  A3DB              bf_copiar:
 71+  A3DB 01 12 00         ld bc, ANCHO_POZO
 72+  A3DE ED B0            ldir                     ; 18 bytes (HL)->(DE); ambos avanzan 18, BC -> 0
 73+  A3E0 01 CE FF         ld bc, -(ANCHO_POZO + 32); deshacemos los 18 y subimos una fila mas
 74+  A3E3 09               add hl, bc               ; HL -= 50
 75+  A3E4 EB               ex de, hl
 75+  A3E5 09             add hl, bc
 75+  A3E6 EB             ex de, hl   ; DE -= 50 (el Z80 no tiene "add de,bc")
 76+  A3E7 3D               dec a                    ; add hl,bc no toca Z; dec a si
 77+  A3E8 20 F1            jr nz, bf_copiar
 78+  A3EA              bf_fila0:
 79+  A3EA 06 00            ld b, 0
 79+  A3EC 0E 07          ld c, COL_IZQ  ; vaciamos las 18 celdas de la fila 0, o la fila
 80+  A3EE CD 86 9C         call CRtoATTR            ;  de arriba se duplicaria hacia abajo para siempre
 81+  A3F1 06 12            ld b, ANCHO_POZO
 82+  A3F3              bf_cero:
 83+  A3F3 36 00            ld (hl), 0
 83+  A3F5 23             inc hl
 84+  A3F6 10 FB            djnz bf_cero
 85+  A3F8 E1               pop hl
 85+  A3F9 D1             pop de
 85+  A3FA C1             pop bc
 85+  A3FB F1             pop af
 86+  A3FC C9               ret
 87+  A3FD
