 29   A224                  INCLUDE "caida.asm"
# file opened: C:\UFV Segundo~Tercero\Arquitectura\Practicas\TETRIS_E (2)\TETRIS_E\caida.asm
  1+  A224              ; Programa que calcula la caida de la pieza
  2+  A224
  3+  A224
  4+  A224              ; Constantes para el cálculo del tiempo
  5+  A224              TIEMPO_BASE       EQU 0x11FF  ; Tiempo base de espera
  6+  A224              REDUCCION_TIEMPO  EQU 10      ; Reducción de tiempo por nivel
  7+  A224              TIEMPO_MINIMO     EQU 200     ; Tiempo mínimo de espera
  8+  A224
  9+  A224              ; Variables de tiempo
 10+  A224              TIEMPO_CAIDA      EQU 0x7000  ; Dirección de la variable del tiempo de caída
 11+  A224              NIVEL_ACTUAL      EQU 0x7002  ; Dirección de la variable del nivel actual
 12+  A224
 13+  A224              ; Función para calcular y esperar el tiempo de caída
 14+  A224              Tiempo:
 15+  A224                  ; Guardar registros que vamos a usar
 16+  A224 F5               PUSH AF
 17+  A225 C5               PUSH BC
 18+  A226 D5               PUSH DE
 19+  A227 E5               PUSH HL
 20+  A228
 21+  A228                  ; Calcular el tiempo de caída basado en el nivel actual
 22+  A228 3A 02 70         LD A, (NIVEL_ACTUAL)
 23+  A22B 21 FF 11         LD HL, TIEMPO_BASE
 24+  A22E 97               SUB A
 25+  A22F 06 00            LD B, 0
 26+  A231 4F               LD C, A
 27+  A232 11 0A 00         LD DE, REDUCCION_TIEMPO
 28+  A235 3E 00            LD A, 0
 29+  A237 ED 42            SBC HL, BC ; Calcular el tiempo de caída: TIEMPO_BASE - (NIVEL_ACTUAL * REDUCCION_TIEMPO)
 30+  A239 7C               LD A, H
 31+  A23A B7               OR A
 32+  A23B 20 06            JR NZ, SkipMinCheck
 33+  A23D BD               CP L
 34+  A23E 30 03            JR NC, SkipMinCheck
 35+  A240 21 C8 00         LD HL, TIEMPO_MINIMO
 36+  A243
 37+  A243              SkipMinCheck:
 38+  A243 22 00 70         LD (TIEMPO_CAIDA), HL ; Guardar el tiempo calculado
 39+  A246
 40+  A246                  ; Esperar el tiempo de caída
 41+  A246
 42+  A246              EsperarCaida:
 43+  A246 ED 5B 00 70      LD DE, (TIEMPO_CAIDA)
 44+  A24A
 45+  A24A              EsperarLoop:
 46+  A24A 1B               DEC DE
 47+  A24B 7A               LD A, D
 48+  A24C B7               OR A
 49+  A24D 20 FB            JR NZ, EsperarLoop
 50+  A24F 7B               LD A, E
 51+  A250 B7               OR A
 52+  A251 20 F7            JR NZ, EsperarLoop
 53+  A253
 54+  A253                  ; Restaurar registros usados
 55+  A253 E1               POP HL
 56+  A254 D1               POP DE
 57+  A255 C1               POP BC
 58+  A256 F1               POP AF
 59+  A257
 60+  A257 C9               RET
 61+  A258
 62+  A258              ; Función para inicializar el tiempo de caída
 63+  A258              InicializarTiempo:
 64+  A258 21 FF 11         LD HL, TIEMPO_BASE
 65+  A25B 22 00 70         LD (TIEMPO_CAIDA), HL
 66+  A25E C9               RET
 67+  A25F
