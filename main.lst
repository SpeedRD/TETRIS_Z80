109+  A5B2 06 03          ld b, 3
109+  A5B4 0E 1A          ld c, 26
109+  A5B6 DD 21 60 A6    ld ix, MsgLineas
109+  A5BA CD 13 9D       call PRINTAT
110+  A5BD 3E 06            ld a, 6
110+  A5BF 06 06          ld b, 6
110+  A5C1 0E 1A          ld c, 26
110+  A5C3 DD 21 66 A6    ld ix, MsgNivel
110+  A5C7 CD 13 9D       call PRINTAT
111+  A5CA 3E 06            ld a, 6
111+  A5CC 06 09          ld b, 9
111+  A5CE 0E 1A          ld c, 26
111+  A5D0 DD 21 6C A6    ld ix, MsgProxima
111+  A5D4 CD 13 9D       call PRINTAT
112+  A5D7 C1               pop bc
112+  A5D8 DD E1          pop ix
113+  A5DA C9               ret
114+  A5DB
115+  A5DB              ; ImprimirMarcador -- refresca los tres valores. Solo se llama cuando alguno
116+  A5DB              ;   ha cambiado: repintar texto en cada frame es puro desperdicio.
117+  A5DB              ;   Preserva BC e IX, que son la posicion y el puntero de la pieza en curso.
118+  A5DB              ImprimirMarcador:
119+  A5DB DD E5            push ix
119+  A5DD C5             push bc
120+  A5DE 3E 07            ld a, 7
120+  A5E0 06 01          ld b, 1
120+  A5E2 0E 1A          ld c, 26
121+  A5E4 CD 22 9D         call PREP_PRT                      ; fija atributo y los dos cursores
122+  A5E7 3A 18 A8         ld a, (PUNTOS+2)
122+  A5EA CD 1B A6       call ImprimirBCD ; el par mas significativo primero
123+  A5ED 3A 17 A8         ld a, (PUNTOS+1)
123+  A5F0 CD 1B A6       call ImprimirBCD
124+  A5F3 3A 16 A8         ld a, (PUNTOS)
124+  A5F6 CD 1B A6       call ImprimirBCD
125+  A5F9 3E 07            ld a, 7
125+  A5FB 06 04          ld b, 4
125+  A5FD 0E 1A          ld c, 26
126+  A5FF CD 22 9D         call PREP_PRT
127+  A602 3A 19 A8         ld a, (LINEAS)
127+  A605 CD 2F A6       call ImprimirDec3
128+  A608 3E 07            ld a, 7
128+  A60A 06 07          ld b, 7
128+  A60C 0E 1A          ld c, 26
129+  A60E CD 22 9D         call PREP_PRT
130+  A611 3A 1A A8         ld a, (NIVEL)
130+  A614 CD 2F A6       call ImprimirDec3
131+  A617 C1               pop bc
131+  A618 DD E1          pop ix
132+  A61A C9               ret
133+  A61B
134+  A61B              ; ImprimirBCD -- imprime los dos digitos del byte BCD en A.
135+  A61B              ;   El cursor debe estar ya puesto. Destruye AF, B, DE, HL. Preserva C, IX, IY.
136+  A61B              ImprimirBCD:
137+  A61B F5               PUSH AF
138+  A61C 0F               RRCA
138+  A61D 0F             RRCA
138+  A61E 0F             RRCA
138+  A61F 0F             RRCA   ; nibble alto a los bits 0-3
139+  A620 E6 0F            AND $0F
139+  A622 C6 30          ADD A, '0'        ; valor del digito -> codigo ASCII
140+  A624 CD 50 9D         CALL PRINTCHNUM
