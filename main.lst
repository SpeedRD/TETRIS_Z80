 91+  A590 DD E1            pop ix
 91+  A592 E1             pop hl
 91+  A593 D1             pop de
 91+  A594 C1             pop bc
 91+  A595 F1             pop af
 92+  A596 C9               ret
 93+  A597
 94+  A597              ; ImprimirEtiquetas -- rotulos fijos, una sola vez por partida.
 95+  A597              ImprimirEtiquetas:
 96+  A597 DD E5            push ix
 96+  A599 C5             push bc                  ; IX = pieza, B/C = posicion de la pieza
 97+  A59A 3E 06            ld a, 6
 97+  A59C 06 00          ld b, 0
 97+  A59E 0E 1A          ld c, 26
 97+  A5A0 DD 21 51 A6    ld ix, MsgPuntos
 97+  A5A4 CD 13 9D       call PRINTAT
 98+  A5A7 3E 06            ld a, 6
 98+  A5A9 06 03          ld b, 3
 98+  A5AB 0E 1A          ld c, 26
 98+  A5AD DD 21 57 A6    ld ix, MsgLineas
 98+  A5B1 CD 13 9D       call PRINTAT
 99+  A5B4 3E 06            ld a, 6
 99+  A5B6 06 06          ld b, 6
 99+  A5B8 0E 1A          ld c, 26
 99+  A5BA DD 21 5D A6    ld ix, MsgNivel
 99+  A5BE CD 13 9D       call PRINTAT
100+  A5C1 3E 06            ld a, 6
100+  A5C3 06 09          ld b, 9
100+  A5C5 0E 1A          ld c, 26
100+  A5C7 DD 21 63 A6    ld ix, MsgProxima
100+  A5CB CD 13 9D       call PRINTAT
101+  A5CE C1               pop bc
101+  A5CF DD E1          pop ix
102+  A5D1 C9               ret
103+  A5D2
104+  A5D2              ; ImprimirMarcador -- refresca los tres valores. Solo se llama cuando alguno
105+  A5D2              ;   ha cambiado: repintar texto en cada frame es puro desperdicio.
106+  A5D2              ;   Preserva BC e IX, que son la posicion y el puntero de la pieza en curso.
107+  A5D2              ImprimirMarcador:
108+  A5D2 DD E5            push ix
108+  A5D4 C5             push bc
109+  A5D5 3E 07            ld a, 7
109+  A5D7 06 01          ld b, 1
109+  A5D9 0E 1A          ld c, 26
110+  A5DB CD 22 9D         call PREP_PRT                      ; fija atributo y los dos cursores
111+  A5DE 3A A1 A6         ld a, (PUNTOS+2)
111+  A5E1 CD 12 A6       call ImprimirBCD ; el par mas significativo primero
112+  A5E4 3A A0 A6         ld a, (PUNTOS+1)
112+  A5E7 CD 12 A6       call ImprimirBCD
113+  A5EA 3A 9F A6         ld a, (PUNTOS)
113+  A5ED CD 12 A6       call ImprimirBCD
114+  A5F0 3E 07            ld a, 7
114+  A5F2 06 04          ld b, 4
114+  A5F4 0E 1A          ld c, 26
115+  A5F6 CD 22 9D         call PREP_PRT
116+  A5F9 3A A2 A6         ld a, (LINEAS)
116+  A5FC CD 26 A6       call ImprimirDec3
117+  A5FF 3E 07            ld a, 7
117+  A601 06 07          ld b, 7
117+  A603 0E 1A          ld c, 26
118+  A605 CD 22 9D         call PREP_PRT
119+  A608 3A A3 A6         ld a, (NIVEL)
119+  A60B CD 26 A6       call ImprimirDec3
120+  A60E C1               pop bc
120+  A60F DD E1          pop ix
121+  A611 C9               ret
122+  A612
123+  A612              ; ImprimirBCD -- imprime los dos digitos del byte BCD en A.
124+  A612              ;   El cursor debe estar ya puesto. Destruye AF, B, DE, HL. Preserva C, IX, IY.
125+  A612              ImprimirBCD:
126+  A612 F5               PUSH AF
127+  A613 0F               RRCA
127+  A614 0F             RRCA
127+  A615 0F             RRCA
127+  A616 0F             RRCA   ; nibble alto a los bits 0-3
128+  A617 E6 0F            AND $0F
128+  A619 C6 30          ADD A, '0'        ; valor del digito -> codigo ASCII
129+  A61B CD 50 9D         CALL PRINTCHNUM
