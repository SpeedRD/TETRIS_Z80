 51+  A53B CD DB A5         call ImprimirMarcador
 52+  A53E DD E1            pop ix
 52+  A540 E1             pop hl
 52+  A541 D1             pop de
 52+  A542 C1             pop bc
 53+  A543 C9               ret
 54+  A544
 55+  A544              ; SumarPuntos -- suma DE (BCD de 4 digitos) al marcador de 6 digitos.
 56+  A544              ;   Destruye AF y HL.
 57+  A544              SumarPuntos:
 58+  A544 21 16 A8         LD HL, PUNTOS
 59+  A547 7E               LD A, (HL)
 59+  A548 83             ADD A, E
 59+  A549 27             DAA
 59+  A54A 77             LD (HL), A          ; DAA vuelve decimal la
 60+  A54B 23               INC HL
 60+  A54C 7E             LD A, (HL)
 60+  A54D 8A             ADC A, D
 60+  A54E 27             DAA
 60+  A54F 77             LD (HL), A ;  suma binaria. LD no
 61+  A550 23               INC HL
 61+  A551 7E             LD A, (HL)
 61+  A552 CE 00          ADC A, 0
 61+  A554 27             DAA
 61+  A555 77             LD (HL), A ;  toca flags: el
 62+  A556 C9               RET                                               ;  acarreo sobrevive.
 63+  A557
 64+  A557              ; ActualizarVelocidad -- copia la velocidad del nivel actual a la gravedad.
 65+  A557              ;   Destruye AF, DE y HL.
 66+  A557              ActualizarVelocidad:
 67+  A557 3A 1A A8         LD A, (NIVEL)
 68+  A55A FE 0A            CP NIVEL_MAX
 68+  A55C 38 02          JR C, NivelOK
 69+  A55E 3E 0A            LD A, NIVEL_MAX             ; tope: nunca indexar mas alla de la tabla
 70+  A560              NivelOK:
