# file opened: main.asm
  1   0000              ;Programa principal del juego
  2   0000
  3   0000                  DEVICE ZXSPECTRUM48
  4   0000                  ORG $8000
  5   8000 31 00 00         LD SP, 0
  6   8003
  7   8003 F3               DI                    ;fijamos el estado de interrupciones en vez de heredarlo
  8   8004 FD 21 3A 5C      LD IY, $5C3A          ;base de las variables del sistema: la rutina de la ROM en
  9   8008 ED 56            IM 1                  ; $0038 direcciona con (IY+n) y la corrompe si IY no es esto
 10   800A FB               EI                    ;el tick de 50 Hz queda disponible para HALT
 11   800B
 12   800B CD 1C 80         CALL InicioDePantalla ;pantalla de inicio
 13   800E
 14   800E              inicializar:
 15   800E 31 00 00         LD SP, 0              ;reinicio limpio. Aqui no hay ningun marco vivo: se
 16   8011                                        ; llega por JP desde Pantalla_Final. Hace falta
 17   8011                                        ; porque el CALL iniciar de abajo NUNCA retorna (el
 18   8011                                        ; fin de partida salta a Pantalla_Final), asi que
 19   8011                                        ; cada partida dejaria 2 bytes de pila sin recuperar.
 20   8011
 21   8011 CD 41 9B         CALL Pantalla_Ini ;mensaje de inicio
 22   8014
 23   8014 CD C0 A0         CALL dibujar_tablero
 24   8017
 25   8017 CD F4 A0         CALL iniciar
 26   801A
 27   801A              fin_del_programa:         ;iniciar no deberia volver (el fin de partida salta a
 28   801A 18 FE            JR fin_del_programa   ; Pantalla_Final). Si vuelve, paramos aqui: sin este
 29   801C                                        ; terminador la ejecucion caia en InicioDePantalla.
 30   801C
 31   801C                  INCLUDE "titulo.asm"
# file opened: titulo.asm
  1+  801C              ;Pinta la pantalla de inicio del Tetris
  2+  801C
  3+  801C              InicioDePantalla:
  4+  801C 21 41 80         ld hl, datosPantalla
  5+  801F CD 23 80         call PintarPantalla ; Abajo definimos esto
  6+  8022 C9               ret
  7+  8023
  8+  8023              PintarPantalla:
  9+  8023 C5               push bc
 10+  8024 D5               push de
 11+  8025
 12+  8025 11 00 40         ld de, $4000    ;Direccion de la video RAM
 13+  8028 01 00 1B         ld bc, 6912     ;Size de la video RAM
 14+  802B ED B0            ldir            ;Mueve datos de hl hasta de hasta que bc sea 0
 15+  802D
 16+  802D D1               pop de          ;Recupera registros usados
 17+  802E C1               pop bc
 18+  802F
 19+  802F              EsperarEntrada:
 20+  802F 01 FE FB         ld bc, $FBFE
 21+  8032 ED 78            in a, (c)               ; Leer el puerto de entrada del teclado
 22+  8034 CB 47            bit 0, a                ; ¿Está pulsada la Q? Activo a nivel bajo: 0 = pulsada.
 23+  8036 20 F7            jr nz, EsperarEntrada   ; Todavía no: seguir esperando
 24+  8038
 25+  8038              LiberarTecla:               ; Pulsada: ahora esperamos a que la suelten
 26+  8038 ED 78            in a, (c)
 27+  803A E6 1F            and $1F                 ; solo los bits 0-4 son teclado; el bit 6 (EAR) no es fiable
 28+  803C FE 1F            cp $1F                  ; $1F = ninguna tecla pulsada en esta media fila
 29+  803E 20 F8            jr nz, LiberarTecla
 30+  8040 C9               ret
 31+  8041
 32+  8041              datosPantalla: INCBIN "TETRIS.scr"  ; Contenido de la pantalla de inicio "TETRIS.scr"
# file closed: titulo.asm
 32   9B41                  INCLUDE "pantallas.asm"
# file opened: pantallas.asm
  1+  9B41              ;Pinta las pantallas principales (Inicio, Final, etc)
  2+  9B41              ;
  3+  9B41              ; Las tres pantallas hablan ahora el mismo lenguaje visual que el marcador de
  4+  9B41              ; la partida: paneles enmarcados con el MISMO byte de atributo que el borde del
  5+  9B41              ; pozo (ATRIB_MARCO = 6*8+7 = 55, tableroJuego.asm:10), rotulos en amarillo
  6+  9B41              ; (tinta 6) y textos y valores en blanco (tinta 7), igual que
  7+  9B41              ; ImprimirEtiquetas e ImprimirMarcador (puntuacion.asm:95,107). Antes cada
  8+  9B41              ; pantalla llevaba su propia combinacion -- verde, magenta, azul, cian -- y
  9+  9B41              ; ninguna se parecia al marcador; ahora convergen las tres.
 10+  9B41              ;
 11+  9B41              ; Los TEXTOS no cambian: esto es un cambio de presentacion, no una reescritura.
 12+  9B41              ;
 13+  9B41              ; El dibujo esta separado de la espera de teclado: pintar_ini, pintar_final y
 14+  9B41              ; pintar_gracias pintan y vuelven, sin tocar el teclado, asi que se pueden
 15+  9B41              ; probar sin nadie delante (tests/test_pantallas.py). Pantalla_Ini y
 16+  9B41              ; Pantalla_Final siguen siendo los puntos de entrada de siempre.
 17+  9B41              ;
 18+  9B41              ; El marco se dibuja SOLO con bytes de atributo, como el pozo y como el
 19+  9B41              ; recuadro de la vista previa: no hace falta ningun glifo de dibujo de cajas,
 20+  9B41              ; que ademas charset.bin no tiene (solo ASCII 32-127).
 21+  9B41
 22+  9B41              PANEL_ALTO   EQU 5          ; marco / hueco / texto / hueco / marco
 23+  9B41              ATRIB_MARCO  EQU 6 * 8 + 7  ; 55: papel amarillo, tinta blanca -- el borde del pozo
 24+  9B41              TINTA_ROTULO EQU 6          ; amarillo, como las etiquetas SCORE/LINES/LEVEL/NEXT
 25+  9B41              TINTA_TEXTO  EQU 7          ; blanco, como los valores del marcador
 26+  9B41              TINTA_CURSOR EQU 6 + $80    ; amarillo parpadeante: la celda que sigue al prompt.
 27+  9B41                                          ;  El bit 7 es FLASH; antes era verde (2+$80) en la
 28+  9B41                                          ;  pantalla de inicio y azul (1+$80) en la de fin
 29+  9B41
 30+  9B41              MEJOR_COL_ROTULO EQU 4      ; "MEJOR PUNTUACION" ocupa las columnas 4-19
 31+  9B41              MEJOR_COL_VALOR  EQU 22     ; los seis digitos ocupan las columnas 22-27
 32+  9B41
 33+  9B41              Pantalla_Ini:
 34+  9B41 CD 7E 9B         call pintar_ini
 35+  9B44 CD 59 9B         call EsperarTecla        ; Leer el teclado hasta que se pulse S o N
 36+  9B47 C9               ret
 37+  9B48
 38+  9B48              Pantalla_Final:
 39+  9B48 CD 58 9C         call ActualizarMejor     ; PUNTOS todavia vale lo de esta partida: es aqui,
 40+  9B4B                                           ;  antes de que reiniciar_marcador lo ponga a cero
 41+  9B4B                                           ;  en la siguiente, donde puede haber record
 42+  9B4B CD B4 9B         call pintar_final
 43+  9B4E CD 61 9B         call LeerTecla           ; Wait for a key press (S or N)
 44+  9B51
 45+  9B51 C3 0E 80         jp inicializar            ; Restart the game. JP y no CALL: con CALL cada
 46+  9B54                                            ; reinicio dejaba 2 bytes de pila sin recuperar,
 47+  9B54                                            ; y lo que hubiera detras era codigo muerto.
 48+  9B54
 49+  9B54
 50+  9B54              FinDelJuego:
 51+  9B54 CD EA 9B         call pintar_gracias
 52+  9B57
 53+  9B57 18 FE        fin:    JR fin
 54+  9B59
 55+  9B59
 56+  9B59              EsperarTecla:
 57+  9B59 CD 61 9B         call LeerTecla
 58+  9B5C FE 1F            cp $1F              ; SoltarTecla devuelve el puerto enmascarado a los bits 0-4
 59+  9B5E 20 F9            jr nz,EsperarTecla  ; Esperar hasta que no haya tecla pulsada
 60+  9B60 C9               ret
 61+  9B61
 62+  9B61              LeerTecla:
 63+  9B61 01 FE 7F         ld bc,$7FFE         ; Escanear línea B,N,M,SYMB,Space
 64+  9B64 ED 78            in a,(c)
 65+  9B66 CB 5F            bit 3,a
 66+  9B68 28 EA            jr z,FinDelJuego    ; Han pulsado N
 67+  9B6A 01 FE FD         ld bc,$FDFE         ; Escanear línea G,F,D,S,A
 68+  9B6D ED 78            in a,(c)
 69+  9B6F CB 4F            bit 1,a
 70+  9B71 20 EE            jr nz,LeerTecla     ; No han pulsado 'S'
 71+  9B73 18 00            jr SoltarTecla
 72+  9B75
 73+  9B75              SoltarTecla:
 74+  9B75 ED 78            in a,(c)            ; Leer del puerto que se ha definido en LeerTecla
 75+  9B77 E6 1F            and $1F             ; solo los bits 0-4 son teclado; el bit 6 (EAR) no es fiable
 76+  9B79 FE 1F            cp $1F              ; Comprobar que no hay tecla pulsada
 77+  9B7B 20 F8            jr nz,SoltarTecla   ; Esperar hasta que no haya tecla pulsada
 78+  9B7D C9               ret
 79+  9B7E
 80+  9B7E
 81+  9B7E              ; ---------------------------------------------------------------------------
 82+  9B7E              ; Dibujo de las pantallas. Ninguna lee el teclado y ninguna vuelve con estado
 83+  9B7E              ; a medias, asi que las tres se pueden llamar sueltas desde los tests.
 84+  9B7E              ;
 85+  9B7E              ; Los tres paneles de cada pantalla miden lo mismo (32 columnas x 5 filas) y
 86+  9B7E              ; van a las mismas columnas, para que las pantallas se lean como una familia.
 87+  9B7E              ; El texto va siempre en la fila central del panel (fila del panel + 2) y
 88+  9B7E              ; centrado en el interior, que son las columnas 1-30.
 89+  9B7E
 90+  9B7E              ; pintar_ini -- pantalla previa a la partida: tipo de juego, mejor puntuacion
 91+  9B7E              ;   de la sesion y peticion de confirmacion.
 92+  9B7E              ;   Destruye AF, BC, DE, HL, IX.
 93+  9B7E              pintar_ini:
 94+  9B7E CD 84 9D         call CLEARSCR       ;borramos pantalla
 95+  9B81
 96+  9B81 06 01            ld b, 1             ; panel del titulo: filas 1-5
 97+  9B83 CD 00 9C         call pintar_marco
 98+  9B86 3E 06            ld a, TINTA_ROTULO  ;Letra amarilla
 99+  9B88 06 03            ld b, 3             ;Coordenadas para el mensaje de bienvenida
100+  9B8A 0E 05            ld c, 5             ; 21 caracteres centrados en las columnas 1-30
101+  9B8C DD 21 C1 9C      ld ix, MensajeJuego
102+  9B90 CD 13 9D         call PRINTAT
103+  9B93
104+  9B93 06 08            ld b, 8             ; panel de la mejor puntuacion: filas 8-12
105+  9B95 CD 27 9C         call pintar_mejor   ;  primero de los DOS sitios que leen MEJOR
106+  9B98
107+  9B98 06 0F            ld b, 15            ; panel del prompt: filas 15-19
108+  9B9A CD 00 9C         call pintar_marco
109+  9B9D 3E 07            ld a, TINTA_TEXTO   ;Letra blanca
110+  9B9F 06 11            ld b, 17            ;Coordenadas para el mensaje de inicio
111+  9BA1 0E 01            ld c, 1             ; 29 caracteres: columnas 1-29
112+  9BA3 DD 21 A3 9C      ld ix, MensajeIniciar
113+  9BA7 CD 13 9D         call PRINTAT
114+  9BAA
115+  9BAA 06 11            ld b, 17                  ; Para colocar el cursor: la celda que sigue al
116+  9BAC 0E 1E            ld c, 30                  ;  prompt, todavia dentro del panel
117+  9BAE CD 3D 9D         call CRtoATTR             ; Calcular la dirección del atributo (preserva BC)
118+  9BB1 36 86            ld (hl), TINTA_CURSOR     ; Establecer el atributo
119+  9BB3 C9               ret
120+  9BB4
121+  9BB4              ; pintar_final -- pantalla de fin de partida. NO calcula el record: eso lo hace
122+  9BB4              ;   ActualizarMejor una sola vez, antes de entrar aqui. Esta rutina solo lee.
123+  9BB4              ;   Destruye AF, BC, DE, HL, IX.
124+  9BB4              pintar_final:
125+  9BB4 CD 84 9D         call CLEARSCR  ; Clear the screen
126+  9BB7
127+  9BB7 06 03            ld b, 3               ; panel del aviso: filas 3-7
128+  9BB9 CD 00 9C         call pintar_marco
129+  9BBC 3E 06            ld a, TINTA_ROTULO    ; Set color to yellow on black
130+  9BBE 06 05            ld b, 5               ; Row position
131+  9BC0 0E 08            ld c, 8               ; Column position: 16 caracteres centrados
132+  9BC2 DD 21 F1 9C      ld ix, MensajeGameOver  ; Address of the message
133+  9BC6 CD 13 9D         call PRINTAT  ; Print the message
134+  9BC9
135+  9BC9 06 0A            ld b, 10              ; panel de la mejor puntuacion: filas 10-14
136+  9BCB CD 27 9C         call pintar_mejor     ;  segundo de los DOS sitios que leen MEJOR
137+  9BCE
138+  9BCE 06 11            ld b, 17              ; panel del prompt: filas 17-21
139+  9BD0 CD 00 9C         call pintar_marco
140+  9BD3 3E 07            ld a, TINTA_TEXTO     ; Set color to white on black
141+  9BD5 06 13            ld b, 19              ; Row position
142+  9BD7 0E 03            ld c, 3               ; Column position: 25 caracteres centrados
143+  9BD9 DD 21 D7 9C      ld ix, MensajeReiniciar  ; Address of the message (antes cargaba
144+  9BDD CD 13 9D         call PRINTAT             ;  MensajeGameOver por segunda vez)
145+  9BE0
146+  9BE0                  ; Set cursor attribute to blinking yellow
147+  9BE0 06 13            ld b, 19              ; Row position for attribute
148+  9BE2 0E 1C            ld c, 28              ; Column position for attribute: tras el texto
149+  9BE4 CD 3D 9D         call CRtoATTR         ; Calculate attribute address (preserva BC)
150+  9BE7 36 86            ld (hl), TINTA_CURSOR ; Set the attribute
151+  9BE9 C9               ret
152+  9BEA
153+  9BEA              ; pintar_gracias -- pantalla de despedida. Un solo panel, centrado.
154+  9BEA              ;   Destruye AF, BC, DE, HL, IX.
155+  9BEA              pintar_gracias:
156+  9BEA CD 84 9D         call CLEARSCR
157+  9BED
158+  9BED 06 09            ld b, 9                  ; panel unico: filas 9-13
159+  9BEF CD 00 9C         call pintar_marco
160+  9BF2 3E 06            ld a, TINTA_ROTULO       ; Letra amarilla (antes cian parpadeante)
161+  9BF4 06 0B            ld b, 11                 ; Coordenadas para el mensaje final
162+  9BF6 0E 07            ld c, 7                  ; 17 caracteres centrados
163+  9BF8 DD 21 91 9C      ld ix, MensajeFinal
164+  9BFC CD 13 9D         call PRINTAT
165+  9BFF C9               ret
166+  9C00
167+  9C00              ; pintar_marco -- marco de un panel: un rectangulo hueco de celdas de atributo,
168+  9C00              ;   de 32 columnas por PANEL_ALTO filas, con la esquina superior izquierda en
169+  9C00              ;   la columna 0 de la fila B.
170+  9C00              ;   Entrada: B = fila superior (0..23-PANEL_ALTO+1).
171+  9C00              ;   Preserva AF, BC, DE, HL, IX, IY.
172+  9C00              ;
173+  9C00              ;   Se pinta con atributos y nada mas, igual que el borde del pozo: el fichero
174+  9C00              ;   de pixeles queda a cero (CLEARSCR) y una celda de papel amarillo se ve como
175+  9C00              ;   un bloque solido. CRtoATTR en vez de CalcularAtributo porque preserva BC,
176+  9C00              ;   que aqui es la fila del panel (register-protocol).
177+  9C00              pintar_marco:
178+  9C00 F5               push af
178+  9C01 C5             push bc
178+  9C02 D5             push de
178+  9C03 E5             push hl
179+  9C04 0E 00            ld c, 0
180+  9C06 CD 3D 9D         call CRtoATTR            ; HL = atributo de (B,0); BC intacto
181+  9C09 3E 37            ld a, ATRIB_MARCO
182+  9C0B 11 1F 00         ld de, 31                ; salto de la columna 0 a la 31 de la misma fila
183+  9C0E 06 20            ld b, 32
184+  9C10              pm_arriba:
185+  9C10 77               ld (hl), a               ; fila superior completa
186+  9C11 23               inc hl
187+  9C12 10 FC            djnz pm_arriba           ; HL queda en la columna 0 de la fila siguiente
188+  9C14 06 03            ld b, PANEL_ALTO - 2
189+  9C16              pm_lados:
190+  9C16 77               ld (hl), a               ; columna 0
191+  9C17 19               add hl, de
192+  9C18 77               ld (hl), a               ; columna 31
193+  9C19 23               inc hl                   ; columna 0 de la fila siguiente
194+  9C1A 10 FA            djnz pm_lados            ; djnz solo mira B: add hl,de no le afecta
195+  9C1C 06 20            ld b, 32
196+  9C1E              pm_abajo:
197+  9C1E 77               ld (hl), a               ; fila inferior completa
198+  9C1F 23               inc hl
199+  9C20 10 FC            djnz pm_abajo
200+  9C22 E1               pop hl
200+  9C23 D1             pop de
200+  9C24 C1             pop bc
200+  9C25 F1             pop af
201+  9C26 C9               ret
202+  9C27
203+  9C27              ; ---------------------------------------------------------------------------
204+  9C27              ; Mejor puntuacion de la sesion
205+  9C27              ;
206+  9C27              ; MEJOR (variables.asm) es la puntuacion mas alta desde que se cargo el juego:
207+  9C27              ; tres bytes de BCD empaquetado, exactamente el mismo formato que PUNTOS, para
208+  9C27              ; poder reutilizar ImprimirBCD (puntuacion.asm:125) sin convertir nada.
209+  9C27              ;
210+  9C27              ; Se ESCRIBE en un solo sitio, ActualizarMejor, al entrar en Pantalla_Final.
211+  9C27              ; Se LEE en dos, y los dos pasan por pintar_mejor: la pantalla de inicio y la
212+  9C27              ; de fin de partida. Nada mas la toca; no hay una tabla de records ni entrada
213+  9C27              ; de nombre, es un unico numero.
214+  9C27
215+  9C27              ; pintar_mejor -- panel completo de la mejor puntuacion: marco, rotulo y valor.
216+  9C27              ;   Entrada: B = fila superior del panel.
217+  9C27              ;   Destruye AF, BC, DE, HL, IX.
218+  9C27              pintar_mejor:
219+  9C27 CD 00 9C         call pintar_marco
220+  9C2A C5               push bc                  ; PRINTAT deja B a cero (register-protocol)
221+  9C2B 3E 06            ld a, TINTA_ROTULO
222+  9C2D 04               inc b
222+  9C2E 04             inc b            ; la fila del texto es la central del panel
223+  9C2F 0E 04            ld c, MEJOR_COL_ROTULO
224+  9C31 DD 21 02 9D      ld ix, MsgMejor
225+  9C35 CD 13 9D         call PRINTAT
226+  9C38 C1               pop bc
227+  9C39 04               inc b
227+  9C3A 04             inc b
228+  9C3B 0E 16            ld c, MEJOR_COL_VALOR
229+  9C3D CD 41 9C         call ImprimirMejor
230+  9C40 C9               ret
231+  9C41
232+  9C41              ; ImprimirMejor -- imprime los seis digitos de MEJOR. Solo lee.
233+  9C41              ;   Entrada: B = fila, C = columna.
234+  9C41              ;   Destruye AF, B, DE, HL. Preserva C, IX, IY.
235+  9C41              ImprimirMejor:
236+  9C41 3E 07            ld a, TINTA_TEXTO        ; blanco, como los valores del marcador
237+  9C43 CD 22 9D         call PREP_PRT            ; fija atributo y los dos cursores
238+  9C46 3A 1E A8         ld a, (MEJOR+2)
238+  9C49 CD 1B A6       call ImprimirBCD   ; el par mas significativo primero
239+  9C4C 3A 1D A8         ld a, (MEJOR+1)
239+  9C4F CD 1B A6       call ImprimirBCD
240+  9C52 3A 1C A8         ld a, (MEJOR)
240+  9C55 C3 1B A6       jp ImprimirBCD     ; salto final: imprime y vuelve
241+  9C58
242+  9C58              ; ActualizarMejor -- si la puntuacion de la partida que acaba de terminar supera
243+  9C58              ;   a MEJOR, la copia. Se llama UNA vez, al entrar en Pantalla_Final.
244+  9C58              ;   Destruye AF, BC, DE, HL.
245+  9C58              ;
246+  9C58              ;   La comparacion va del par de digitos mas significativo al menos: en BCD
247+  9C58              ;   empaquetado cada byte lleva dos digitos decimales, asi que el orden de los
248+  9C58              ;   bytes coincide con el orden numerico y basta un CP normal.
249+  9C58              ActualizarMejor:
250+  9C58 21 18 A8         ld hl, PUNTOS + 2
251+  9C5B 11 1E A8         ld de, MEJOR + 2
252+  9C5E 06 03            ld b, 3
253+  9C60              am_comparar:
254+  9C60 1A               ld a, (de)               ; A = par de digitos de MEJOR
255+  9C61 BE               cp (hl)                  ; MEJOR - PUNTOS
256+  9C62 38 06            jr c, am_copiar          ; MEJOR < PUNTOS: hay record nuevo
257+  9C64 C0               ret nz                   ; MEJOR > PUNTOS: no lo hay, y no seguimos mirando
258+  9C65 2B               dec hl
258+  9C66 1B             dec de          ; iguales hasta aqui: decide el par siguiente
259+  9C67 10 F7            djnz am_comparar
260+  9C69 C9               ret                      ; empate exacto: no hay nada que copiar
261+  9C6A              am_copiar:
262+  9C6A 21 16 A8         ld hl, PUNTOS
263+  9C6D 11 1C A8         ld de, MEJOR
264+  9C70 01 03 00         ld bc, 3
265+  9C73 ED B0            ldir
266+  9C75 C9               ret
267+  9C76
268+  9C76
269+  9C76              CalcularAtributo:
270+  9C76                                      ; Rutina que recibe en B,C las coordenadas de la pantalla (fila, columna)
271+  9C76                                      ; y devuelve en HL la dirección del atributo correspondiente
272+  9C76 F5               PUSH AF             ; Guardamos A en el stack
273+  9C77 60               LD H,b              ; Los bits 4,5 de B deben ser los bits 0,1 de H
274+  9C78 CB 3C            SRL H
274+  9C7A CB 3C          SRL H
274+  9C7C CB 3C          SRL H
275+  9C7E 78               LD A,B              ; Los bits 0,1,2 de B deben ser los bits 5,6,7 de L
276+  9C7F CB 27            SLA A
276+  9C81 CB 27          SLA A
276+  9C83 CB 27          SLA A
276+  9C85 CB 27          SLA A
276+  9C87 CB 27          SLA a
277+  9C89 B1               OR c                ; Y C son los bits 0-4 de L
278+  9C8A 6F               LD L,A
279+  9C8B 01 00 58         LD BC, $5800        ; Le sumamos la dirección de comienzo de los atributos
280+  9C8E 09               ADD HL,BC
281+  9C8F F1               POP AF
282+  9C90 C9               RET
283+  9C91
284+  9C91
285+  9C91
286+  9C91
287+  9C91 47 72 61 63  MensajeFinal:     db "Gracias por jugar",0         ; Mensaje de agradecimiento
287+  9C95 69 61 73 20
287+  9C99 70 6F 72 20
