  8+  9B48 0E 06            ld c, 6
  9+  9B4A DD 21 1B 9C      ld ix, MensajeJuego
 10+  9B4E CD 5C 9C         call PRINTAT
 11+  9B51
 12+  9B51 3E 02            ld a, 2     ;Letra verde
 13+  9B53 06 0B            ld b, 11    ;Coordenadas para el mensaje de inicio
 14+  9B55 0E 02            LD c, 2
 15+  9B57 DD 21 FD 9B      ld ix, MensajeIniciar
 16+  9B5B CD 5C 9C         call PRINTAT
 17+  9B5E
 18+  9B5E 06 0B            ld b, 11
