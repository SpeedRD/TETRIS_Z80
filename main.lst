 40   A39A                  INCLUDE "clear.asm"
# file opened: clear.asm
  1+  A39A              ; Programa para borrar un tetromino de la pantalla
  2+  A39A
  3+  A39A              borrar_tetromino:
  4+  A39A F5               push af
  5+  A39B FD E5            push iy
  6+  A39D E5               push hl
  7+  A39E D5               push de
  8+  A39F C5               push bc
  9+  A3A0 F3               di                    ; IY va a apuntar al patron; la ROM ($0038) exige IY=$5C3A
 10+  A3A1
 11+  A3A1 CD 76 9C         call CalcularAtributo
 12+  A3A4 DD 46 00         ld b, (ix)            ; Guardar filas en B
 13+  A3A7 DD 4E 01         ld c, (ix+1)          ; Guardar columnas en C
 14+  A3AA DD E5 FD E1      ld iy, ix
 15+  A3AE FD 23            inc iy
 16+  A3B0 FD 23            inc iy                ; Ajustar IY a la dirección del patrón de bits del tetromino
 17+  A3B2
 18+  A3B2              loop_filas:
 19+  A3B2 DD 4E 01         ld c, (ix+1)          ; Restaurar columnas en C para la nueva fila
 20+  A3B5              loop_columnas:
 21+  A3B5 FD 7E 00         ld a, (iy)            ; Cargar el byte del patrón del tetromino
 22+  A3B8 FD 23            inc iy
 23+  A3BA B7               or a                  ; Verificar si el byte es cero
 24+  A3BB 28 02            jr z, siguiente_columna ; Si es cero, saltar a la siguiente columna
 25+  A3BD
 26+  A3BD 36 00            ld (hl), 0            ; Borrar el byte en pantalla
 27+  A3BF
 28+  A3BF              siguiente_columna:
 29+  A3BF 23               inc hl                ; Mover a la siguiente posición en memoria de video
 30+  A3C0 0D               dec c                 ; Decrementar el contador de columnas
 31+  A3C1 20 F2            jr nz, loop_columnas  ; Repetir hasta que C sea cero
 32+  A3C3
 33+  A3C3 3E 20            ld a, 32
 34+  A3C5 DD 96 01         sub (ix+1)            ; Calcular el offset para la siguiente fila
 35+  A3C8 16 00            ld d, 0
 36+  A3CA 5F               ld e, a
 37+  A3CB 19               add hl, de            ; Mover a la siguiente fila en memoria de video
 38+  A3CC 10 E4            djnz loop_filas       ; Repetir para todas las filas
 39+  A3CE
 40+  A3CE C1               pop bc
 41+  A3CF D1               pop de
 42+  A3D0 E1               pop hl
 43+  A3D1 FD E1            pop iy
 44+  A3D3 FB               ei                    ; IY ya vale lo que tenia el llamante: seguro reanudar
 45+  A3D4 F1               pop af
 46+  A3D5
 47+  A3D5 C9               ret
 48+  A3D6
# file closed: clear.asm
 41   A3D6                  INCLUDE "giro.asm"
# file opened: giro.asm
  1+  A3D6              GIRAR:
  2+  A3D6              ;--------------------------------------------------------------------
  3+  A3D6              ;Gira la pieza actual: valida, aplica retranqueo (wall kick) y CONFIRMA
  4+  A3D6              ;aqui dentro. El llamante NO debe volver a comprobar el resultado.
  5+  A3D6              ;
  6+  A3D6              ;No lee el teclado ni espera a que se suelte ninguna tecla: el bucle
  7+  A3D6              ;llama a leer_teclas una vez por pasada y pasa la direccion en A. Leer
  8+  A3D6              ;aqui dejaria la pieza invisible entre el borrado y el repintado.
  9+  A3D6              ;
 10+  A3D6              ;Param. de Entrada: IX = registro actual, B = fila, C = columna,
 11+  A3D6              ;                   (Medio) = columna, A = 0 girar izquierda (Q),
 12+  A3D6              ;                   A distinto de 0 girar derecha (W)
 13+  A3D6              ;Param. de Salida : si cabe -> IX = registro nuevo, C y (Medio) = columna nueva
 14+  A3D6              ;                   si no cabe -> IX, C y (Medio) intactos
 15+  A3D6              ;Destruye AF y DE. Preserva B, HL, IY. C es SALIDA si el giro cabe.
 16+  A3D6              ;--------------------------------------------------------------------
 17+  A3D6 E5               PUSH HL
 18+  A3D7 B7               OR  A
 19+  A3D8 20 08            JR  NZ, giro_der
 20+  A3DA DD 56 09         LD  D,(IX + 9)          ; +8/+9 = sucesor al girar a la izquierda
 21+  A3DD DD 5E 08         LD  E,(IX + 8)          ;  (byte bajo primero)
 22+  A3E0 18 06            JR  giro_probar
 23+  A3E2              giro_der:
 24+  A3E2 DD 56 0B         LD  D,(IX + 11)         ; +10/+11 = sucesor al girar a la derecha
 25+  A3E5 DD 5E 0A         LD  E,(IX + 10)
 26+  A3E8
 27+  A3E8              giro_probar:
 28+  A3E8 DD E5            PUSH IX                 ; estado al que volver si no cabe en ningun sitio
 29+  A3EA DD 7E 01         LD  A,(IX + 1)          ; ancho de la pieza VIEJA: leerlo antes de mover IX
 30+  A3ED DD 62 DD 6B      LD  IX, DE              ; IX = estado candidato (instruccion falsa, ver
 31+  A3F1                                          ;  assembler-conventions: LD IXH,D : LD IXL,E)
 32+  A3F1 DD 96 01         SUB (IX + 1)            ; A = ancho_viejo - ancho_nuevo, con signo (-3..+3)
 33+  A3F4 F2 F8 A3         JP  P, giro_media
 34+  A3F7 3C               INC A                   ; los negativos deben redondear hacia cero, no hacia
 35+  A3F8              giro_media:                 ;  -infinito, para que girar e desgirar vuelva a la
 36+  A3F8 CB 2F            SRA A                   ;  misma columna. A = (viejo-nuevo)/2
 37+  A3FA 81               ADD A, C                ; anclamos por el centro, no por la esquina superior
 38+  A3FB 5F               LD  E, A                ; E = columna base recentrada: aun es una CANDIDATA
 39+  A3FC 21 22 A4         LD  HL, giro_kicks
 40+  A3FF
 41+  A3FF              giro_bucle:
 42+  A3FF 7E               LD  A,(HL)
 43+  A400 23               INC HL
 44+  A401 FE 80            CP  $80                 ; centinela: se han agotado las candidatas
 45+  A403 28 15            JR  Z, giro_deshacer
 46+  A405 83               ADD A, E                ; columna candidata = base recentrada + retranqueo
 47+  A406 4F               LD  C, A                ; las dos pruebas leen la fila de B y la columna de C
 48+  A407 CD 62 A4         CALL en_rango           ; PRUEBA 1 geometria: ¿cabe entera en las columnas
 49+  A40A B7               OR  A                   ;  7-24? comprobar no puede ver esto
 50+  A40B 20 F2            JR  NZ, giro_bucle
 51+  A40D CD 56 A3         CALL comprobar          ; PRUEBA 2 solape: A=0 cabe, A=1 choca con un bloque
 52+  A410 B7               OR  A                   ;  o con el borde. Preserva BC/DE/HL/IX/IY.
 53+  A411 20 EC            JR  NZ, giro_bucle
 54+  A413 79               LD  A, C
 55+  A414 32 26 A8         LD  (Medio), A          ; CONFIRMAMOS tambien la columna en memoria: el bucle
 56+  A417 D1               POP DE                  ;  recarga C desde Medio y deshariamos el retranqueo.
 57+  A418 18 06            JR  giro_fin            ; descartamos el IX viejo: vale el nuevo
 58+  A41A
 59+  A41A              giro_deshacer:
 60+  A41A DD E1            POP IX                  ; no cabia en ningun sitio: recuperamos la forma...
 61+  A41C 3A 26 A8         LD  A,(Medio)
 62+  A41F 4F               LD  C, A                ; ...y la columna. (Medio) es la copia de respaldo de C.
 63+  A420              giro_fin:
 64+  A420 E1               POP HL
 65+  A421 C9               RET
 66+  A422
 67+  A422 00 FF 01 FE  giro_kicks: DB 0, -1, 1, -2, 2, $80   ; en el sitio, luego 1 y luego 2 celdas a
 67+  A426 02 80
 68+  A428                                                    ; cada lado. Datos de solo lectura,
 69+  A428                                                    ; despues del RET: nunca se ejecutan.
 70+  A428
# file closed: giro.asm
 42   A428                  INCLUDE "entrada.asm"
# file opened: entrada.asm
  1+  A428              ; entrada.asm -- lectura de teclado no bloqueante y limite lateral del pozo
  2+  A428              ;
  3+  A428              ; Sustituye a las dos esperas de "soltar tecla" (giro.asm, movimiento.asm), que
  4+  A428              ; congelaban gravedad y dibujado mientras una tecla estuviera pulsada.
  5+  A428
  6+  A428              COL_IZQ_POZO EQU 7    ; primera columna interior del pozo
  7+  A428              COL_DER_POZO EQU 24   ; ultima columna interior del pozo
  8+  A428
  9+  A428              ; leer_teclas -- lectura no bloqueante. Llamar UNA sola vez por pasada del
 10+  A428              ;   bucle. El resultado mezcla dos convenios distintos en el mismo byte:
 11+  A428              ;   Salida: A = bit0 = K (derecha)   bit1 = J (izquierda)   } FLANCO: 1 solo
 12+  A428              ;                bit2 = Q (giro izq)  bit3 = W (giro drcha)  } en la pasada en
 13+  A428              ;                                                             que pasan de
 14+  A428              ;                                                             SUELTA a PULSADA
 15+  A428              ;               bit4 = SPACE (caida rapida / soft drop)     } ESTADO: 1 en
 16+  A428              ;                                                             TODAS las
 17+  A428              ;                                                             pasadas mientras
 18+  A428              ;                                                             siga pulsada, 0
 19+  A428              ;                                                             en cuanto suelta
 20+  A428              ;           A = 0 si no hay tecla nueva ni SPACE pulsada.
 21+  A428              ;   SPACE es a proposito de nivel y no de flanco: gravedad rapida (juego.asm)
 22+  A428              ;   necesita saber que SIGUE pulsada en cada pasada, no solo la primera.
 23+  A428              ;   Preserva BC, DE, HL, IX, IY. Destruye AF.
 24+  A428              leer_teclas:
 25+  A428 C5               push bc
 25+  A429 D5             push de
 25+  A42A E5             push hl
 26+  A42B 01 FE BF         ld bc, $BFFE
 26+  A42E ED 78          in a,(c) ; media fila ENTER,L,K,J,H. ACTIVO A NIVEL BAJO:
 27+  A430 2F               cpl                     ;  una tecla pulsada lee 0, asi que invertimos.
 28+  A431 0F               rrca
 28+  A432 0F             rrca             ;  K esta en el bit2 y J en el bit3: los bajamos.
 29+  A433 E6 03            and %00000011           ;  bit0 = K, bit1 = J (descarta bits 5-7, que no
 30+  A435 5F               ld e, a                 ;  son teclado y tras el cpl valen basura)
 31+  A436 01 FE FB         ld bc, $FBFE
 31+  A439 ED 78          in a,(c) ; media fila Q,W,E,R,T: Q en bit0, W en bit1
 32+  A43B 2F               cpl
 33+  A43C 07               rlca
 33+  A43D 07             rlca             ;  los subimos a los bits 2 y 3
 34+  A43E E6 0C            and %00001100           ;  bit2 = Q, bit3 = W
 35+  A440 B3               or e
 35+  A441 5F             ld e, a          ; E = K/J/Q/W, 1 = pulsada AHORA
 36+  A442 01 FE 7F         ld bc, $7FFE
 36+  A445 ED 78          in a,(c) ; media fila SPACE,SYM SHIFT,M,N,B: SPACE en bit0
 37+  A447 2F               cpl
 38+  A448 E6 01            and %00000001           ;  nos quedamos solo con SPACE
 39+  A44A 07               rlca
 39+  A44B 07             rlca
 39+  A44C 07             rlca
 39+  A44D 07             rlca ; lo subimos al bit4
 40+  A44E B3               or e
 40+  A44F 5F             ld e, a          ; E = mascara ACTUAL completa (bits0-4), 1 =
 41+  A450                                          ;  pulsada AHORA MISMO -- esto es ESTADO, todavia
 42+  A450                                          ;  no flanco
 43+  A450 21 22 A8         ld hl, teclas_ant       ; un byte: la misma mascara de la llamada anterior
 44+  A453 7E               ld a,(hl)
 44+  A454 73             ld (hl), e  ; leemos la vieja y guardamos la nueva
 45+  A455 2F               cpl
 45+  A456 A3             and e             ; A = flanco nuevo de los CINCO bits; valido para
 46+  A457                                          ;  K/J/Q/W (bits0-3), pero el bit4 tambien saldria
 47+  A457                                          ;  de flanco aqui y SPACE no quiere eso
 48+  A457 E6 0F            and %00001111           ; nos quedamos solo con el flanco de K/J/Q/W
 49+  A459 57               ld d, a                 ; D = flanco K/J/Q/W, bit4 a cero
 50+  A45A 7B               ld a, e
 51+  A45B E6 10            and %00010000           ; A = SOLO el estado actual de SPACE (bit4)
 52+  A45D B2               or d                    ; resultado: bits0-3 flanco, bit4 estado (nivel)
 53+  A45E E1               pop hl
 53+  A45F D1             pop de
 53+  A460 C1             pop bc
 54+  A461 C9               ret
 55+  A462
 56+  A462              ; en_rango -- ¿cabe la pieza IX entera en la columna C?
 57+  A462              ;   comprobar no puede responder a esto: solo ve el borde porque su byte de
 58+  A462              ;   atributo es distinto de cero, asi que una candidata que se haya SALTADO el
 59+  A462              ;   borde lee celdas vacias fuera del pozo y la aceptaria.
 60+  A462              ;   Entrada: C = columna candidata, IX = registro de la pieza; (ix+1) = ancho.
 61+  A462              ;   Salida : A = 0 cabe, A = 1 se sale.
 62+  A462              ;   Preserva BC, DE, HL, IX, IY. Destruye AF.
 63+  A462              en_rango:
 64+  A462 79               ld a, c
 65+  A463 FE 07            cp COL_IZQ_POZO
 66+  A465 38 0B            jr c, er_fuera          ; C < 7 -> a la izquierda de la pared izquierda
 67+  A467 DD 86 01         add a,(ix+1)            ; A = C + ancho
 68+  A46A 38 06            jr c, er_fuera          ; desbordo los 8 bits: C estaba lejisimos
 69+  A46C FE 1A            cp COL_DER_POZO + 2     ; la ultima celda es C+ancho-1 y debe ser <= 24,
 70+  A46E 30 02            jr nc, er_fuera         ;  o sea C+ancho <= 25, o sea C+ancho < 26
 71+  A470 AF               xor a                   ; A = 0: todas las celdas caen entre 7 y 24
 72+  A471 C9               ret
 73+  A472              er_fuera:
 74+  A472 3E 01            ld a, 1
 75+  A474 C9               ret
 76+  A475
# file closed: entrada.asm
 43   A475                  INCLUDE "lineas.asm"
# file opened: lineas.asm
  1+  A475              ; lineas.asm -- deteccion y borrado de lineas completas
  2+  A475              ;
  3+  A475              ; El fichero de atributos ES el tablero: una celda esta ocupada si su byte de
  4+  A475              ; atributo es distinto de cero. El interior del pozo son las columnas 7-24
  5+  A475              ; (18 celdas) y las filas 0-21; la fila 22 es el suelo y las columnas 6 y 25
  6+  A475              ; son las paredes. NUNCA se escribe en el borde: nadie lo vuelve a pintar
  7+  A475              ; despues de dibujar_tablero, y un solo byte suelto abre un agujero permanente.
  8+  A475
  9+  A475              COL_IZQ    EQU 7        ; primera columna interior
 10+  A475              ANCHO_POZO EQU 18       ; ancho interior: columnas 7..24 inclusive
 11+  A475              FILA_BAJA  EQU 21       ; fila interior mas baja (la 22 es el suelo)
 12+  A475
 13+  A475              ; limpiar_lineas -- elimina todas las filas completas y compacta el tablero.
 14+  A475              ;   Entrada: nada.  Salida: A = numero de filas eliminadas (0..4 en la practica)
 15+  A475              ;   Preserva BC, DE, HL, IX, IY. Destruye AF.
 16+  A475              limpiar_lineas:
 17+  A475 C5               push bc
 17+  A476 D5             push de
 17+  A477 E5             push hl
 17+  A478 DD E5          push ix  ; BC = fila/columna de la pieza e
 18+  A47A 0E 00            ld c, 0                  ; C = cuenta de filas eliminadas
 19+  A47C 06 15            ld b, FILA_BAJA          ; B = fila a examinar; empezamos abajo y subimos
 20+  A47E              ll_probar:
 21+  A47E CD 98 A4         call fila_llena
 21+  A481 B7             or a   ; A = 1 si la fila B esta completa
 22+  A482 28 06            jr z, ll_arriba          ; no lo esta -> subimos una fila
 23+  A484 0C               inc c
 24+  A485 CD B4 A4         call bajar_filas         ; bajamos sobre ella todo lo que tenia encima
 25+  A488 18 F4            jr ll_probar             ; VOLVEMOS A PROBAR LA MISMA FILA B: tras el
 26+  A48A                                           ;  desplazamiento en el indice B hay una fila
 27+  A48A                                           ;  DISTINTA. Poner "dec b" aqui es el fallo
 28+  A48A                                           ;  clasico: un doble hueco borraria una sola fila.
 29+  A48A              ll_arriba:
 30+  A48A 78               ld a, b
 30+  A48B B7             or a
 31+  A48C 28 03            jr z, ll_fin             ; la fila 0 era la ultima por probar -> hemos acabado
 32+  A48E 05               dec b
 32+  A48F 18 ED          jr ll_probar
 33+  A491              ll_fin:
 34+  A491 79               ld a, c                  ; devolvemos la cuenta; la consume puntuacion.asm
 35+  A492 DD E1            pop ix
 35+  A494 E1             pop hl
 35+  A495 D1             pop de
 35+  A496 C1             pop bc   ; espejo exacto de los push
 36+  A497 C9               ret
 37+  A498
 38+  A498              ; fila_llena -- Entrada: B = fila 0..21.  Salida: A = 1 completa, 0 no.
 39+  A498              ;   Preserva BC, DE, HL. Destruye AF.
 40+  A498              fila_llena:
 41+  A498 C5               push bc
 41+  A499 D5             push de
 41+  A49A E5             push hl
 42+  A49B 0E 07            ld c, COL_IZQ
 43+  A49D CD 3D 9D         call CRtoATTR            ; HL = $5800 + B*32 + 7. A diferencia de
 44+  A4A0                                           ;  CalcularAtributo, esta PRESERVA BC, que es lo
 45+  A4A0                                           ;  que mantiene vivo el contador de filas.
 46+  A4A0 1E 12            ld e, ANCHO_POZO         ; exactamente 18 celdas: nunca 32, o los bytes de
 47+  A4A2              fl_celda:                    ;  la pared (siempre 55) darian toda fila por llena
 48+  A4A2 7E               ld a, (hl)
 48+  A4A3 B7             or a
 49+  A4A4 28 08            jr z, fl_hueco           ; con una celda vacia basta: la fila no esta completa
 50+  A4A6 23               inc hl
 50+  A4A7 1D             dec e
 51+  A4A8 20 F8            jr nz, fl_celda          ; dec e fija los flags; inc hl no los toca
 52+  A4AA 3E 01            ld a, 1
 52+  A4AC 18 02          jr fl_fin
 53+  A4AE              fl_hueco:
 54+  A4AE 3E 00            ld a, 0
 55+  A4B0              fl_fin:
 56+  A4B0 E1               pop hl
 56+  A4B1 D1             pop de
 56+  A4B2 C1             pop bc
 57+  A4B3 C9               ret
 58+  A4B4
 59+  A4B4              ; bajar_filas -- Entrada: B = la fila recien eliminada (0..21).
 60+  A4B4              ;   Copia una fila hacia abajo todo lo que hay encima y deja la fila 0 vacia.
 61+  A4B4              ;   Preserva AF, BC, DE, HL.
 62+  A4B4              bajar_filas:
 63+  A4B4 F5               push af
 63+  A4B5 C5             push bc
 63+  A4B6 D5             push de
 63+  A4B7 E5             push hl
 64+  A4B8 78               ld a, b
 64+  A4B9 B7             or a           ; A = numero de copias a hacer = B
 65+  A4BA 28 1B            jr z, bf_fila0           ; se elimino la fila 0: no hay nada encima
 66+  A4BC 0E 07            ld c, COL_IZQ
 67+  A4BE F5               push af                  ; CRtoATTR TERMINA EN "LD A,L" (L30.3 - printat.asm):
 68+  A4BF CD 3D 9D         call CRtoATTR            ;  destruye A. Sin este push la cuenta de copias se
 69+  A4C2 F1               pop af                   ;  perdia y el bucle giraba (bajo de $5800+B*32+7)
 70+  A4C3                                           ;  veces en vez de B: 167 en vez de 21 para la fila
 71+  A4C3                                           ;  21. Las 146 vueltas de mas seguian copiando por
 72+  A4C3                                           ;  debajo del fichero de atributos y ensuciaban 230
 73+  A4C3                                           ;  bytes del fichero de pixeles en cada linea hecha.
 74+  A4C3                                           ;  El tablero acababa bien -- bf_cero repara la fila
 75+  A4C3                                           ;  0 -- asi que el fallo solo se veia como fondo
 76+  A4C3                                           ;  corrupto y como un frame de 119.000 T en vez de
 77+  A4C3                                           ;  38.000. Preservar AF, y no fiarlo a que CRtoATTR
 78+  A4C3                                           ;  respete B, es lo que mantiene esto a salvo si
 79+  A4C3                                           ;  alguien cambia la rutina de direccion.
 80+  A4C3 EB               ex de, hl                ; DE = destino
 81+  A4C4 21 E0 FF         ld hl, -32
 81+  A4C7 19             add hl, de  ; HL = origen = destino - 32 = una fila mas arriba
 82+  A4C8              bf_copiar:
 83+  A4C8 01 12 00         ld bc, ANCHO_POZO
 84+  A4CB ED B0            ldir                     ; 18 bytes (HL)->(DE); ambos avanzan 18, BC -> 0
 85+  A4CD 01 CE FF         ld bc, -(ANCHO_POZO + 32); deshacemos los 18 y subimos una fila mas
 86+  A4D0 09               add hl, bc               ; HL -= 50
 87+  A4D1 EB               ex de, hl
 87+  A4D2 09             add hl, bc
 87+  A4D3 EB             ex de, hl   ; DE -= 50 (el Z80 no tiene "add de,bc")
 88+  A4D4 3D               dec a                    ; add hl,bc no toca Z; dec a si
 89+  A4D5 20 F1            jr nz, bf_copiar
 90+  A4D7              bf_fila0:
 91+  A4D7 06 00            ld b, 0
 91+  A4D9 0E 07          ld c, COL_IZQ  ; vaciamos las 18 celdas de la fila 0, o la fila
 92+  A4DB CD 3D 9D         call CRtoATTR            ;  de arriba se duplicaria hacia abajo para siempre
 93+  A4DE 06 12            ld b, ANCHO_POZO
 94+  A4E0              bf_cero:
 95+  A4E0 36 00            ld (hl), 0
 95+  A4E2 23             inc hl
 96+  A4E3 10 FB            djnz bf_cero
 97+  A4E5 E1               pop hl
 97+  A4E6 D1             pop de
 97+  A4E7 C1             pop bc
 97+  A4E8 F1             pop af
 98+  A4E9 C9               ret
 99+  A4EA
# file closed: lineas.asm
 44   A4EA                  INCLUDE "puntuacion.asm"
# file opened: puntuacion.asm
  1+  A4EA              ; puntuacion.asm -- puntos, lineas, nivel y su marcador en pantalla
  2+  A4EA              ;
  3+  A4EA              ; Las VARIABLES (PUNTOS, LINEAS, NIVEL, PROX_NIVEL, FRAMES_POR_FILA) se
  4+  A4EA              ; declaran en variables.asm y SOLO alli: declararlas tambien aqui es un error
  5+  A4EA              ; de etiqueta duplicada. Este fichero aporta el codigo y sus tablas de solo
  6+  A4EA              ; lectura.
  7+  A4EA              ;
  8+  A4EA              ; El marcador se pinta en las columnas 26-31, FUERA del pozo. Es una
  9+  A4EA              ; restriccion de correccion, no de gusto: "ocupado" significa "byte de
 10+  A4EA              ; atributo distinto de cero", asi que cualquier texto dentro de las columnas
 11+  A4EA              ; 7-24 se convertiria en un muro invisible para comprobar.
 12+  A4EA
 13+  A4EA              NIVEL_MAX EQU 10
 14+  A4EA
 15+  A4EA 00 01 00 03  PUNTOS_POR_LINEA: DW $0100, $0300, $0500, $0800  ; BCD, indice (filas-1)*2
 15+  A4EE 00 05 00 08
 16+  A4F2 30 28 21 1B  FRAMES_POR_NIVEL: DB 48,40,33,27,22,18,15,12,10,8,6  ; niveles 0..10, a 50 fps
 16+  A4F6 16 12 0F 0C
 16+  A4FA 0A 08 06
 17+  A4FD
 18+  A4FD              ; anotar_lineas -- contabiliza un borrado de lineas.
 19+  A4FD              ;   Entrada: A = filas eliminadas (0..4). Si es 0 no hace nada.
 20+  A4FD              ;   Actualiza puntos, lineas, nivel y velocidad, y refresca el marcador.
 21+  A4FD              ;   Preserva BC, DE, HL, IX, IY. Destruye AF.
 22+  A4FD              anotar_lineas:
 23+  A4FD B7               or a
 24+  A4FE C8               ret z                        ; no se elimino ninguna fila
 25+  A4FF C5               push bc
 25+  A500 D5             push de
 25+  A501 E5             push hl
 25+  A502 DD E5          push ix
 26+  A504 F5               push af                      ; nos guardamos la cuenta
 27+  A505
 28+  A505 3D               dec a                        ; --- puntos: indice (filas-1)*2
 29+  A506 87               add a, a
 30+  A507 5F               ld e, a
 30+  A508 16 00          ld d, 0
 31+  A50A 21 EA A4         ld hl, PUNTOS_POR_LINEA
