294+  A7A8              ; --- melodia ---------------------------------------------------------------
295+  A7A8              ; Korobeiniki completa: la parte A (8 compases, la que todo el mundo reconoce)
296+  A7A8              ; y la parte B (8 compases, la lenta), y al llegar a NOTA_FIN se vuelve al
297+  A7A8              ; principio. 16 compases de 4/4 a 80 tramas cada uno = 1.280 tramas = 25,6 s
298+  A7A8              ; por vuelta. 54 notas, 110 bytes: la imagen tiene RAM libre de sobra por
299+  A7A8              ; encima, asi que no hay ningun motivo para recortar la melodia
300+  A7A8              ; (MUSIC_DESIGN 8 punto 3).
301+  A7A8              ;
302+  A7A8              ; Parejas (nota, duracion en tramas). Cada compas es una linea; la suma de
303+  A7A8              ; cada compas es 80 y tests/test_musica.py lo comprueba.
304+  A7A8              melodia:
305+  A7A8              ; -- parte A ----------------------------------------------------------------
306+  A7A8 13 14            DB N_E5,D_NEG
306+  A7AA 0E 0A          DB N_B4,D_COR
306+  A7AC 0F 0A          DB N_C5,D_COR
306+  A7AE 11 14          DB N_D5,D_NEG
306+  A7B0 0F 0A          DB N_C5,D_COR
306+  A7B2 0E 0A          DB N_B4,D_COR
307+  A7B4 0C 14            DB N_A4,D_NEG
307+  A7B6 0C 0A          DB N_A4,D_COR
307+  A7B8 0F 0A          DB N_C5,D_COR
307+  A7BA 13 14          DB N_E5,D_NEG
307+  A7BC 11 0A          DB N_D5,D_COR
307+  A7BE 0F 0A          DB N_C5,D_COR
308+  A7C0 0E 1E            DB N_B4,D_NGP
308+  A7C2 0F 0A          DB N_C5,D_COR
308+  A7C4 11 14          DB N_D5,D_NEG
308+  A7C6 13 14          DB N_E5,D_NEG
309+  A7C8 0F 14            DB N_C5,D_NEG
309+  A7CA 0C 14          DB N_A4,D_NEG
309+  A7CC 0C 28          DB N_A4,D_BLA
310+  A7CE 11 1E            DB N_D5,D_NGP
310+  A7D0 14 0A          DB N_F5,D_COR
