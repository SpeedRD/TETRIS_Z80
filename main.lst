 35+  A31A F6 A2
 36+  A31C
 37+  A31C              ; "Medio" (la columna en curso) vivia aqui, incrustado en la imagen de codigo
 38+  A31C              ; justo detras del ultimo registro de pieza y sin ningun margen. Ahora esta en
 39+  A31C              ; variables.asm, con el resto del estado mutable.
 40+  A31C
 41+  A31C              ; Rutina para pintar el tetromino en pantalla
 42+  A31C              pintar_tetromino:
 43+  A31C F5               push af
 44+  A31D FD E5            push iy
 45+  A31F E5               push hl
 46+  A320 D5               push de
 47+  A321 C5               push bc
 48+  A322 F3               di                     ; IY va a apuntar al patron; la ROM ($0038) exige IY=$5C3A
 49+  A323
 50+  A323 CD 76 9C         call CalcularAtributo  ; Calcular la dirección en HL
 51+  A326 DD 46 00         ld b, (ix)             ; Obtener filas en B
 52+  A329 DD 4E 01         ld c, (ix+1)           ; Obtener columnas en C
 53+  A32C DD E5 FD E1      ld iy, ix
 54+  A330 FD 23            inc iy
 54+  A332 FD 23          inc iy        ; Ajustar IY a la dirección del patrón de bits del tetromino
 55+  A334
 56+  A334              pintar_loop:
 57+  A334 FD 7E 00         ld a, (iy)
 58+  A337 FD 23            inc iy
 59+  A339 FE 00            cp 0                   ; Verificar si el byte es cero
 60+  A33B 28 01            jr z, siguiente_byte
 61+  A33D
 62+  A33D 77               ld (hl), a             ; Pintar el byte en pantalla
 63+  A33E              siguiente_byte:
 64+  A33E 23               inc hl                 ; Mover a la siguiente posición en memoria de video
 65+  A33F 0D               dec c                  ; Decrementar el contador de columnas
 66+  A340 20 F2            jr nz, pintar_loop     ; Repetir hasta que C sea cero
 67+  A342
 68+  A342 DD 4E 01         ld c, (ix+1)           ; Resetear C para la siguiente fila
 69+  A345 3E 20            ld a, 32
 70+  A347 91               sub c
 71+  A348 16 00            ld d, 0
 72+  A34A 5F               ld e, a
 73+  A34B 19               add hl, de             ; Mover a la siguiente fila en memoria de video
 74+  A34C 10 E6            djnz pintar_loop       ; Repetir para todas las filas
 75+  A34E
 76+  A34E C1               pop bc
 77+  A34F D1               pop de
 78+  A350 E1               pop hl
 79+  A351 FD E1            pop iy
 80+  A353 FB               ei                     ; IY ya vale lo que tenia el llamante: seguro reanudar
 81+  A354 F1               pop af
 82+  A355
 83+  A355 C9               ret
 84+  A356
