134+  9D76              ; INK2PAPER - moves ink of attribute stored in (PRINT_ATTR) to paper and sets ink to 0
135+  9D76              ; 				Sets bright 1 and flash 0
136+  9D76              ; ----------------------------------------------------------------------------------------
137+  9D76 3A 96 9D     INK2PAPER:	LD A, (PRINT_ATTR)		    ; Get storedAttribute
138+  9D79 E6 07                    AND 7						; get Attr INK in A
139+  9D7B 07           			RLCA
140+  9D7C 07           			RLCA
141+  9D7D 07           			RLCA						; move Ink to Paper
142+  9D7E F6 40        			OR 64						; ink 0 bright 1
143+  9D80 32 96 9D     			LD (PRINT_ATTR),A		    ; Get storedAttribute
144+  9D83 C9           			RET
