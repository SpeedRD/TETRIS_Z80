 21+  A3AF FD 7E 00         ld a, (iy)            ; Cargar el byte del patrón del tetromino
 22+  A3B2 FD 23            inc iy
 23+  A3B4 B7               or a                  ; Verificar si el byte es cero
 24+  A3B5 28 02            jr z, siguiente_columna ; Si es cero, saltar a la siguiente columna
 25+  A3B7
 26+  A3B7 36 00            ld (hl), 0            ; Borrar el byte en pantalla
 27+  A3B9
 28+  A3B9              siguiente_columna:
 29+  A3B9 23               inc hl                ; Mover a la siguiente posición en memoria de video
 30+  A3BA 0D               dec c                 ; Decrementar el contador de columnas
 31+  A3BB 20 F2            jr nz, loop_columnas  ; Repetir hasta que C sea cero
 32+  A3BD
 33+  A3BD 3E 20            ld a, 32
 34+  A3BF DD 96 01         sub (ix+1)            ; Calcular el offset para la siguiente fila
 35+  A3C2 16 00            ld d, 0
 36+  A3C4 5F               ld e, a
 37+  A3C5 19               add hl, de            ; Mover a la siguiente fila en memoria de video
 38+  A3C6 10 E4            djnz loop_filas       ; Repetir para todas las filas
 39+  A3C8
 40+  A3C8 C1               pop bc
 41+  A3C9 D1               pop de
 42+  A3CA E1               pop hl
 43+  A3CB FD E1            pop iy
 44+  A3CD FB               ei                    ; IY ya vale lo que tenia el llamante: seguro reanudar
 45+  A3CE F1               pop af
 46+  A3CF
 47+  A3CF C9               ret
 48+  A3D0
# file closed: clear.asm
 41   A3D0                  INCLUDE "giro.asm"
# file opened: giro.asm
  1+  A3D0              GIRAR:
  2+  A3D0              ;--------------------------------------------------------------------
  3+  A3D0              ;Gira la pieza actual: valida, aplica retranqueo (wall kick) y CONFIRMA
  4+  A3D0              ;aqui dentro. El llamante NO debe volver a comprobar el resultado.
  5+  A3D0              ;
  6+  A3D0              ;No lee el teclado ni espera a que se suelte ninguna tecla: el bucle
  7+  A3D0              ;llama a leer_teclas una vez por pasada y pasa la direccion en A. Leer
  8+  A3D0              ;aqui dejaria la pieza invisible entre el borrado y el repintado.
  9+  A3D0              ;
 10+  A3D0              ;Param. de Entrada: IX = registro actual, B = fila, C = columna,
 11+  A3D0              ;                   (Medio) = columna, A = 0 girar izquierda (Q),
 12+  A3D0              ;                   A distinto de 0 girar derecha (W)
 13+  A3D0              ;Param. de Salida : si cabe -> IX = registro nuevo, C y (Medio) = columna nueva
 14+  A3D0              ;                   si no cabe -> IX, C y (Medio) intactos
 15+  A3D0              ;Destruye AF y DE. Preserva B, HL, IY. C es SALIDA si el giro cabe.
 16+  A3D0              ;--------------------------------------------------------------------
 17+  A3D0 E5               PUSH HL
 18+  A3D1 B7               OR  A
 19+  A3D2 20 08            JR  NZ, giro_der
 20+  A3D4 DD 56 09         LD  D,(IX + 9)          ; +8/+9 = sucesor al girar a la izquierda
 21+  A3D7 DD 5E 08         LD  E,(IX + 8)          ;  (byte bajo primero)
 22+  A3DA 18 06            JR  giro_probar
 23+  A3DC              giro_der:
 24+  A3DC DD 56 0B         LD  D,(IX + 11)         ; +10/+11 = sucesor al girar a la derecha
 25+  A3DF DD 5E 0A         LD  E,(IX + 10)
 26+  A3E2
 27+  A3E2              giro_probar:
 28+  A3E2 DD E5            PUSH IX                 ; estado al que volver si no cabe en ningun sitio
 29+  A3E4 DD 7E 01         LD  A,(IX + 1)          ; ancho de la pieza VIEJA: leerlo antes de mover IX
 30+  A3E7 DD 62 DD 6B      LD  IX, DE              ; IX = estado candidato (instruccion falsa, ver
 31+  A3EB                                          ;  assembler-conventions: LD IXH,D : LD IXL,E)
 32+  A3EB DD 96 01         SUB (IX + 1)            ; A = ancho_viejo - ancho_nuevo, con signo (-3..+3)
 33+  A3EE F2 F2 A3         JP  P, giro_media
 34+  A3F1 3C               INC A                   ; los negativos deben redondear hacia cero, no hacia
 35+  A3F2              giro_media:                 ;  -infinito, para que girar e desgirar vuelva a la
 36+  A3F2 CB 2F            SRA A                   ;  misma columna. A = (viejo-nuevo)/2
 37+  A3F4 81               ADD A, C                ; anclamos por el centro, no por la esquina superior
 38+  A3F5 5F               LD  E, A                ; E = columna base recentrada: aun es una CANDIDATA
 39+  A3F6 21 1C A4         LD  HL, giro_kicks
 40+  A3F9
 41+  A3F9              giro_bucle:
 42+  A3F9 7E               LD  A,(HL)
 43+  A3FA 23               INC HL
 44+  A3FB FE 80            CP  $80                 ; centinela: se han agotado las candidatas
 45+  A3FD 28 15            JR  Z, giro_deshacer
 46+  A3FF 83               ADD A, E                ; columna candidata = base recentrada + retranqueo
 47+  A400 4F               LD  C, A                ; las dos pruebas leen la fila de B y la columna de C
 48+  A401 CD 5C A4         CALL en_rango           ; PRUEBA 1 geometria: ¿cabe entera en las columnas
 49+  A404 B7               OR  A                   ;  7-24? comprobar no puede ver esto
 50+  A405 20 F2            JR  NZ, giro_bucle
 51+  A407 CD 50 A3         CALL comprobar          ; PRUEBA 2 solape: A=0 cabe, A=1 choca con un bloque
 52+  A40A B7               OR  A                   ;  o con el borde. Preserva BC/DE/HL/IX/IY.
 53+  A40B 20 EC            JR  NZ, giro_bucle
 54+  A40D 79               LD  A, C
 55+  A40E 32 AF A6         LD  (Medio), A          ; CONFIRMAMOS tambien la columna en memoria: el bucle
 56+  A411 D1               POP DE                  ;  recarga C desde Medio y deshariamos el retranqueo.
 57+  A412 18 06            JR  giro_fin            ; descartamos el IX viejo: vale el nuevo
 58+  A414
 59+  A414              giro_deshacer:
 60+  A414 DD E1            POP IX                  ; no cabia en ningun sitio: recuperamos la forma...
 61+  A416 3A AF A6         LD  A,(Medio)
 62+  A419 4F               LD  C, A                ; ...y la columna. (Medio) es la copia de respaldo de C.
 63+  A41A              giro_fin:
 64+  A41A E1               POP HL
 65+  A41B C9               RET
 66+  A41C
 67+  A41C 00 FF 01 FE  giro_kicks: DB 0, -1, 1, -2, 2, $80   ; en el sitio, luego 1 y luego 2 celdas a
 67+  A420 02 80
 68+  A422                                                    ; cada lado. Datos de solo lectura,
 69+  A422                                                    ; despues del RET: nunca se ejecutan.
 70+  A422
# file closed: giro.asm
 42   A422                  INCLUDE "entrada.asm"
# file opened: entrada.asm
  1+  A422              ; entrada.asm -- lectura de teclado no bloqueante y limite lateral del pozo
  2+  A422              ;
  3+  A422              ; Sustituye a las dos esperas de "soltar tecla" (giro.asm, movimiento.asm), que
  4+  A422              ; congelaban gravedad y dibujado mientras una tecla estuviera pulsada.
  5+  A422
  6+  A422              COL_IZQ_POZO EQU 7    ; primera columna interior del pozo
  7+  A422              COL_DER_POZO EQU 24   ; ultima columna interior del pozo
  8+  A422
  9+  A422              ; leer_teclas -- lectura no bloqueante. Llamar UNA sola vez por pasada del
 10+  A422              ;   bucle. El resultado mezcla dos convenios distintos en el mismo byte:
 11+  A422              ;   Salida: A = bit0 = K (derecha)   bit1 = J (izquierda)   } FLANCO: 1 solo
 12+  A422              ;                bit2 = Q (giro izq)  bit3 = W (giro drcha)  } en la pasada en
 13+  A422              ;                                                             que pasan de
 14+  A422              ;                                                             SUELTA a PULSADA
 15+  A422              ;               bit4 = SPACE (caida rapida / soft drop)     } ESTADO: 1 en
 16+  A422              ;                                                             TODAS las
 17+  A422              ;                                                             pasadas mientras
 18+  A422              ;                                                             siga pulsada, 0
 19+  A422              ;                                                             en cuanto suelta
 20+  A422              ;           A = 0 si no hay tecla nueva ni SPACE pulsada.
 21+  A422              ;   SPACE es a proposito de nivel y no de flanco: gravedad rapida (juego.asm)
 22+  A422              ;   necesita saber que SIGUE pulsada en cada pasada, no solo la primera.
 23+  A422              ;   Preserva BC, DE, HL, IX, IY. Destruye AF.
 24+  A422              leer_teclas:
 25+  A422 C5               push bc
 25+  A423 D5             push de
 25+  A424 E5             push hl
 26+  A425 01 FE BF         ld bc, $BFFE
 26+  A428 ED 78          in a,(c) ; media fila ENTER,L,K,J,H. ACTIVO A NIVEL BAJO:
 27+  A42A 2F               cpl                     ;  una tecla pulsada lee 0, asi que invertimos.
 28+  A42B 0F               rrca
 28+  A42C 0F             rrca             ;  K esta en el bit2 y J en el bit3: los bajamos.
 29+  A42D E6 03            and %00000011           ;  bit0 = K, bit1 = J (descarta bits 5-7, que no
 30+  A42F 5F               ld e, a                 ;  son teclado y tras el cpl valen basura)
 31+  A430 01 FE FB         ld bc, $FBFE
 31+  A433 ED 78          in a,(c) ; media fila Q,W,E,R,T: Q en bit0, W en bit1
 32+  A435 2F               cpl
 33+  A436 07               rlca
 33+  A437 07             rlca             ;  los subimos a los bits 2 y 3
 34+  A438 E6 0C            and %00001100           ;  bit2 = Q, bit3 = W
 35+  A43A B3               or e
 35+  A43B 5F             ld e, a          ; E = K/J/Q/W, 1 = pulsada AHORA
 36+  A43C 01 FE 7F         ld bc, $7FFE
 36+  A43F ED 78          in a,(c) ; media fila SPACE,SYM SHIFT,M,N,B: SPACE en bit0
 37+  A441 2F               cpl
 38+  A442 E6 01            and %00000001           ;  nos quedamos solo con SPACE
 39+  A444 07               rlca
 39+  A445 07             rlca
 39+  A446 07             rlca
 39+  A447 07             rlca ; lo subimos al bit4
 40+  A448 B3               or e
 40+  A449 5F             ld e, a          ; E = mascara ACTUAL completa (bits0-4), 1 =
 41+  A44A                                          ;  pulsada AHORA MISMO -- esto es ESTADO, todavia
 42+  A44A                                          ;  no flanco
 43+  A44A 21 AB A6         ld hl, teclas_ant       ; un byte: la misma mascara de la llamada anterior
 44+  A44D 7E               ld a,(hl)
 44+  A44E 73             ld (hl), e  ; leemos la vieja y guardamos la nueva
 45+  A44F 2F               cpl
 45+  A450 A3             and e             ; A = flanco nuevo de los CINCO bits; valido para
 46+  A451                                          ;  K/J/Q/W (bits0-3), pero el bit4 tambien saldria
 47+  A451                                          ;  de flanco aqui y SPACE no quiere eso
 48+  A451 E6 0F            and %00001111           ; nos quedamos solo con el flanco de K/J/Q/W
 49+  A453 57               ld d, a                 ; D = flanco K/J/Q/W, bit4 a cero
 50+  A454 7B               ld a, e
 51+  A455 E6 10            and %00010000           ; A = SOLO el estado actual de SPACE (bit4)
 52+  A457 B2               or d                    ; resultado: bits0-3 flanco, bit4 estado (nivel)
 53+  A458 E1               pop hl
 53+  A459 D1             pop de
 53+  A45A C1             pop bc
 54+  A45B C9               ret
 55+  A45C
 56+  A45C              ; en_rango -- ¿cabe la pieza IX entera en la columna C?
 57+  A45C              ;   comprobar no puede responder a esto: solo ve el borde porque su byte de
 58+  A45C              ;   atributo es distinto de cero, asi que una candidata que se haya SALTADO el
 59+  A45C              ;   borde lee celdas vacias fuera del pozo y la aceptaria.
 60+  A45C              ;   Entrada: C = columna candidata, IX = registro de la pieza; (ix+1) = ancho.
 61+  A45C              ;   Salida : A = 0 cabe, A = 1 se sale.
 62+  A45C              ;   Preserva BC, DE, HL, IX, IY. Destruye AF.
 63+  A45C              en_rango:
 64+  A45C 79               ld a, c
 65+  A45D FE 07            cp COL_IZQ_POZO
 66+  A45F 38 0B            jr c, er_fuera          ; C < 7 -> a la izquierda de la pared izquierda
 67+  A461 DD 86 01         add a,(ix+1)            ; A = C + ancho
 68+  A464 38 06            jr c, er_fuera          ; desbordo los 8 bits: C estaba lejisimos
 69+  A466 FE 1A            cp COL_DER_POZO + 2     ; la ultima celda es C+ancho-1 y debe ser <= 24,
 70+  A468 30 02            jr nc, er_fuera         ;  o sea C+ancho <= 25, o sea C+ancho < 26
 71+  A46A AF               xor a                   ; A = 0: todas las celdas caen entre 7 y 24
 72+  A46B C9               ret
 73+  A46C              er_fuera:
 74+  A46C 3E 01            ld a, 1
 75+  A46E C9               ret
 76+  A46F
# file closed: entrada.asm
 43   A46F                  INCLUDE "lineas.asm"
# file opened: lineas.asm
  1+  A46F              ; lineas.asm -- deteccion y borrado de lineas completas
  2+  A46F              ;
  3+  A46F              ; El fichero de atributos ES el tablero: una celda esta ocupada si su byte de
  4+  A46F              ; atributo es distinto de cero. El interior del pozo son las columnas 7-24
  5+  A46F              ; (18 celdas) y las filas 0-21; la fila 22 es el suelo y las columnas 6 y 25
  6+  A46F              ; son las paredes. NUNCA se escribe en el borde: nadie lo vuelve a pintar
  7+  A46F              ; despues de dibujar_tablero, y un solo byte suelto abre un agujero permanente.
  8+  A46F
  9+  A46F              COL_IZQ    EQU 7        ; primera columna interior
 10+  A46F              ANCHO_POZO EQU 18       ; ancho interior: columnas 7..24 inclusive
 11+  A46F              FILA_BAJA  EQU 21       ; fila interior mas baja (la 22 es el suelo)
 12+  A46F
 13+  A46F              ; limpiar_lineas -- elimina todas las filas completas y compacta el tablero.
 14+  A46F              ;   Entrada: nada.  Salida: A = numero de filas eliminadas (0..4 en la practica)
 15+  A46F              ;   Preserva BC, DE, HL, IX, IY. Destruye AF.
 16+  A46F              limpiar_lineas:
 17+  A46F C5               push bc
 17+  A470 D5             push de
 17+  A471 E5             push hl
 17+  A472 DD E5          push ix  ; BC = fila/columna de la pieza e
 18+  A474 0E 00            ld c, 0                  ; C = cuenta de filas eliminadas
 19+  A476 06 15            ld b, FILA_BAJA          ; B = fila a examinar; empezamos abajo y subimos
 20+  A478              ll_probar:
 21+  A478 CD 92 A4         call fila_llena
 21+  A47B B7             or a   ; A = 1 si la fila B esta completa
 22+  A47C 28 06            jr z, ll_arriba          ; no lo esta -> subimos una fila
 23+  A47E 0C               inc c
 24+  A47F CD AE A4         call bajar_filas         ; bajamos sobre ella todo lo que tenia encima
 25+  A482 18 F4            jr ll_probar             ; VOLVEMOS A PROBAR LA MISMA FILA B: tras el
 26+  A484                                           ;  desplazamiento en el indice B hay una fila
 27+  A484                                           ;  DISTINTA. Poner "dec b" aqui es el fallo
 28+  A484                                           ;  clasico: un doble hueco borraria una sola fila.
 29+  A484              ll_arriba:
 30+  A484 78               ld a, b
 30+  A485 B7             or a
 31+  A486 28 03            jr z, ll_fin             ; la fila 0 era la ultima por probar -> hemos acabado
 32+  A488 05               dec b
 32+  A489 18 ED          jr ll_probar
 33+  A48B              ll_fin:
 34+  A48B 79               ld a, c                  ; devolvemos la cuenta; la consume puntuacion.asm
 35+  A48C DD E1            pop ix
 35+  A48E E1             pop hl
 35+  A48F D1             pop de
 35+  A490 C1             pop bc   ; espejo exacto de los push
 36+  A491 C9               ret
 37+  A492
 38+  A492              ; fila_llena -- Entrada: B = fila 0..21.  Salida: A = 1 completa, 0 no.
 39+  A492              ;   Preserva BC, DE, HL. Destruye AF.
 40+  A492              fila_llena:
 41+  A492 C5               push bc
 41+  A493 D5             push de
 41+  A494 E5             push hl
 42+  A495 0E 07            ld c, COL_IZQ
 43+  A497 CD 3D 9D         call CRtoATTR            ; HL = $5800 + B*32 + 7. A diferencia de
 44+  A49A                                           ;  CalcularAtributo, esta PRESERVA BC, que es lo
 45+  A49A                                           ;  que mantiene vivo el contador de filas.
 46+  A49A 1E 12            ld e, ANCHO_POZO         ; exactamente 18 celdas: nunca 32, o los bytes de
 47+  A49C              fl_celda:                    ;  la pared (siempre 55) darian toda fila por llena
 48+  A49C 7E               ld a, (hl)
 48+  A49D B7             or a
 49+  A49E 28 08            jr z, fl_hueco           ; con una celda vacia basta: la fila no esta completa
 50+  A4A0 23               inc hl
 50+  A4A1 1D             dec e
 51+  A4A2 20 F8            jr nz, fl_celda          ; dec e fija los flags; inc hl no los toca
 52+  A4A4 3E 01            ld a, 1
 52+  A4A6 18 02          jr fl_fin
 53+  A4A8              fl_hueco:
 54+  A4A8 3E 00            ld a, 0
 55+  A4AA              fl_fin:
 56+  A4AA E1               pop hl
 56+  A4AB D1             pop de
 56+  A4AC C1             pop bc
 57+  A4AD C9               ret
 58+  A4AE
 59+  A4AE              ; bajar_filas -- Entrada: B = la fila recien eliminada (0..21).
 60+  A4AE              ;   Copia una fila hacia abajo todo lo que hay encima y deja la fila 0 vacia.
 61+  A4AE              ;   Preserva AF, BC, DE, HL.
 62+  A4AE              bajar_filas:
 63+  A4AE F5               push af
 63+  A4AF C5             push bc
 63+  A4B0 D5             push de
 63+  A4B1 E5             push hl
 64+  A4B2 78               ld a, b
 64+  A4B3 B7             or a           ; A = numero de copias a hacer = B
 65+  A4B4 28 1B            jr z, bf_fila0           ; se elimino la fila 0: no hay nada encima
 66+  A4B6 0E 07            ld c, COL_IZQ
 67+  A4B8 F5               push af                  ; CRtoATTR TERMINA EN "LD A,L" (L30.3 - printat.asm):
 68+  A4B9 CD 3D 9D         call CRtoATTR            ;  destruye A. Sin este push la cuenta de copias se
 69+  A4BC F1               pop af                   ;  perdia y el bucle giraba (bajo de $5800+B*32+7)
 70+  A4BD                                           ;  veces en vez de B: 167 en vez de 21 para la fila
 71+  A4BD                                           ;  21. Las 146 vueltas de mas seguian copiando por
 72+  A4BD                                           ;  debajo del fichero de atributos y ensuciaban 230
 73+  A4BD                                           ;  bytes del fichero de pixeles en cada linea hecha.
 74+  A4BD                                           ;  El tablero acababa bien -- bf_cero repara la fila
 75+  A4BD                                           ;  0 -- asi que el fallo solo se veia como fondo
 76+  A4BD                                           ;  corrupto y como un frame de 119.000 T en vez de
 77+  A4BD                                           ;  38.000. Preservar AF, y no fiarlo a que CRtoATTR
 78+  A4BD                                           ;  respete B, es lo que mantiene esto a salvo si
 79+  A4BD                                           ;  alguien cambia la rutina de direccion.
 80+  A4BD EB               ex de, hl                ; DE = destino
 81+  A4BE 21 E0 FF         ld hl, -32
 81+  A4C1 19             add hl, de  ; HL = origen = destino - 32 = una fila mas arriba
 82+  A4C2              bf_copiar:
 83+  A4C2 01 12 00         ld bc, ANCHO_POZO
 84+  A4C5 ED B0            ldir                     ; 18 bytes (HL)->(DE); ambos avanzan 18, BC -> 0
 85+  A4C7 01 CE FF         ld bc, -(ANCHO_POZO + 32); deshacemos los 18 y subimos una fila mas
 86+  A4CA 09               add hl, bc               ; HL -= 50
 87+  A4CB EB               ex de, hl
 87+  A4CC 09             add hl, bc
 87+  A4CD EB             ex de, hl   ; DE -= 50 (el Z80 no tiene "add de,bc")
 88+  A4CE 3D               dec a                    ; add hl,bc no toca Z; dec a si
 89+  A4CF 20 F1            jr nz, bf_copiar
 90+  A4D1              bf_fila0:
 91+  A4D1 06 00            ld b, 0
 91+  A4D3 0E 07          ld c, COL_IZQ  ; vaciamos las 18 celdas de la fila 0, o la fila
 92+  A4D5 CD 3D 9D         call CRtoATTR            ;  de arriba se duplicaria hacia abajo para siempre
 93+  A4D8 06 12            ld b, ANCHO_POZO
 94+  A4DA              bf_cero:
 95+  A4DA 36 00            ld (hl), 0
 95+  A4DC 23             inc hl
 96+  A4DD 10 FB            djnz bf_cero
 97+  A4DF E1               pop hl
 97+  A4E0 D1             pop de
 97+  A4E1 C1             pop bc
 97+  A4E2 F1             pop af
 98+  A4E3 C9               ret
 99+  A4E4
# file closed: lineas.asm
 44   A4E4                  INCLUDE "puntuacion.asm"
# file opened: puntuacion.asm
  1+  A4E4              ; puntuacion.asm -- puntos, lineas, nivel y su marcador en pantalla
  2+  A4E4              ;
  3+  A4E4              ; Las VARIABLES (PUNTOS, LINEAS, NIVEL, PROX_NIVEL, FRAMES_POR_FILA) se
  4+  A4E4              ; declaran en variables.asm y SOLO alli: declararlas tambien aqui es un error
  5+  A4E4              ; de etiqueta duplicada. Este fichero aporta el codigo y sus tablas de solo
  6+  A4E4              ; lectura.
  7+  A4E4              ;
  8+  A4E4              ; El marcador se pinta en las columnas 26-31, FUERA del pozo. Es una
  9+  A4E4              ; restriccion de correccion, no de gusto: "ocupado" significa "byte de
 10+  A4E4              ; atributo distinto de cero", asi que cualquier texto dentro de las columnas
 11+  A4E4              ; 7-24 se convertiria en un muro invisible para comprobar.
 12+  A4E4
 13+  A4E4              NIVEL_MAX EQU 10
 14+  A4E4
 15+  A4E4 00 01 00 03  PUNTOS_POR_LINEA: DW $0100, $0300, $0500, $0800  ; BCD, indice (filas-1)*2
 15+  A4E8 00 05 00 08
 16+  A4EC 30 28 21 1B  FRAMES_POR_NIVEL: DB 48,40,33,27,22,18,15,12,10,8,6  ; niveles 0..10, a 50 fps
 16+  A4F0 16 12 0F 0C
 16+  A4F4 0A 08 06
 17+  A4F7
 18+  A4F7              ; anotar_lineas -- contabiliza un borrado de lineas.
 19+  A4F7              ;   Entrada: A = filas eliminadas (0..4). Si es 0 no hace nada.
 20+  A4F7              ;   Actualiza puntos, lineas, nivel y velocidad, y refresca el marcador.
 21+  A4F7              ;   Preserva BC, DE, HL, IX, IY. Destruye AF.
