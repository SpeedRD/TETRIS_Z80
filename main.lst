  1+  A097 FF 81 81 85  Tetro_3D:   DB $FF, $81, $81, $85, $85, $9D, $81, $FF ; Patrón para los bloques
  1+  A09B 85 9D 81 FF
  2+  A09F
  3+  A09F              Tetris_3D:
  4+  A09F 16 03            LD D,3              ; Los 3 bloques de píxeles
  5+  A0A1 DD 21 00 40      LD IX,$4000         ; Dirección de comienzo de la VRAM
  6+  A0A5
  7+  A0A5              T3D3:
  8+  A0A5
  9+  A0A5 FD 21 97 A0      LD IY,Tetro_3D      ; Primer byte del patrón
 10+  A0A9
 11+  A0A9 0E 08            LD C,8              ; 8 bytes del patrón
 12+  A0AB              T3D2:
 13+  A0AB 06 00            LD B,0              ; 256 bytes de cada línea del patrón
 14+  A0AD FD 7E 00         LD a,(IY)           ; Cargo el valor del patrón
 15+  A0B0              T3D1:
 16+  A0B0 DD 77 00         LD (IX),a           ; Cargo el patrón en la VideoRam
 17+  A0B3 DD 23            INC IX              ; Siguientes 8 pixels
 18+  A0B5 10 F9            DJNZ T3D1           ; Fin del bucle
 19+  A0B7
 20+  A0B7 0D               DEC C               ; Fin del 2º Bucle
 21+  A0B8 FD 23            inc IY              ; Siguiente byte del patrón
 22+  A0BA 20 EF            JR NZ,T3D2
 23+  A0BC
 24+  A0BC 15               DEC D               ; Fin del 3º bucle
 25+  A0BD 20 E6            JR NZ, T3D3
 26+  A0BF
 27+  A0BF C9               RET
 28+  A0C0
# file closed: L35 - Tetris_3D.asm
 35   A0C0                  INCLUDE "tableroJuego.asm"
# file opened: tableroJuego.asm
  1+  A0C0              ; Programa para pintar el área de juego del Tetris
  2+  A0C0
  3+  A0C0              ; Rutina para dibujar el tablero de juego
  4+  A0C0              dibujar_tablero:
  5+  A0C0 CD 84 9D         call CLEARSCR   ; Limpiar toda la pantalla
  6+  A0C3
  7+  A0C3                  ; Dibujar el borde izquierdo
  8+  A0C3 21 06 58         ld hl, $5800 + 0 * 32 + 6 ; Dirección de memoria de la pantalla para el borde izquierdo
  9+  A0C6 11 20 00         ld de, $0020              ; Posición vertical (Y)
 10+  A0C9 3E 37            ld a, 6 * 8 + 7            ; Color del borde
 11+  A0CB 06 16            ld b, 22                  ; Número de filas del borde izquierdo
 12+  A0CD
 13+  A0CD              borde_izquierdo:
 14+  A0CD 77               ld (hl), a               ; Escribir el color en la pantalla
 15+  A0CE 19               add hl, de               ; Mover la posición a la siguiente fila
 16+  A0CF 10 FC            djnz borde_izquierdo     ; Decrementar B y repetir hasta que B sea cero
 17+  A0D1
 18+  A0D1                  ; Dibujar el borde derecho
 19+  A0D1 21 19 58         ld hl, $5800 + 0 * 32 + 25 ; Dirección de memoria de la pantalla para el borde derecho
 20+  A0D4 11 20 00         ld de, $0020               ; Posición vertical (Y)
 21+  A0D7 3E 37            ld a, 6 * 8 + 7            ; Color del borde
 22+  A0D9 06 16            ld b, 22                   ; Número de filas del borde derecho
 23+  A0DB
 24+  A0DB              borde_derecho:
 25+  A0DB 77               ld (hl), a               ; Escribir el color en la pantalla
 26+  A0DC 19               add hl, de               ; Mover la posición a la siguiente fila
 27+  A0DD 10 FC            djnz borde_derecho       ; Decrementar B y repetir hasta que B sea cero
 28+  A0DF
 29+  A0DF                  ; Dibujar la base
 30+  A0DF 21 C6 5A         ld hl, $5800 + 22 * 32 + 6 ; Dirección de memoria de la pantalla para la base
 31+  A0E2 3E 37            ld a, 6 * 8 + 7            ; Color de la base
 32+  A0E4 06 14            ld b, 20                   ; Número de columnas de la base
 33+  A0E6
 34+  A0E6              base:
 35+  A0E6 77               ld (hl), a               ; Escribir el color en la pantalla
 36+  A0E7 23               inc hl                   ; Mover la posición a la siguiente columna
 37+  A0E8 10 FC            djnz base                ; Decrementar B y repetir hasta que B sea cero
 38+  A0EA
 39+  A0EA F3               di                       ; Tetris_3D deja IY en $9FDF y no lo restaura
 40+  A0EB CD 9F A0         call Tetris_3D           ; Aplicar el efecto 3D a los bloques
 41+  A0EE FD 21 3A 5C      ld iy, $5C3A             ; devolvemos IY a la base de variables del sistema
 42+  A0F2 FB               ei
 43+  A0F3
 44+  A0F3
 45+  A0F3 C9               ret
# file closed: tableroJuego.asm
 36   A0F4                  INCLUDE "juego.asm"
# file opened: juego.asm
  1+  A0F4              ;Funcionamiento del juego -- bucle principal
  2+  A0F4              ;
  3+  A0F4              ;REGLA: se comprueba EXACTAMENTE la posicion que se va a pintar, con
  4+  A0F4              ;EXACTAMENTE el IX que se va a pintar. El bucle antiguo validaba con la
  5+  A0F4              ;columna de la pasada ANTERIOR y giraba DESPUES de comprobar, asi que
  6+  A0F4              ;validaba una posicion que la pieza no llegaba a ocupar nunca.
  7+  A0F4              ;
  8+  A0F4              ;Estado global mientras cae una pieza:
  9+  A0F4              ;   B  = fila       C  = columna      IX = registro de la pieza
 10+  A0F4              ;   (Medio) = copia en memoria de C; debe coincidir con C en cada comprobar
 11+  A0F4              ;   D  = desplazamiento lateral pedido en esta pasada (0, +1 o -1)
 12+  A0F4              ;   E  = mascara de leer_teclas: bits0-3 flanco nuevo (K/J/Q/W), bit4 = SPACE
 13+  A0F4              ;        mantenida AHORA (caida rapida / soft drop), no flanco
 14+  A0F4              ;   H  = 1 si en esta pasada toca bajar una fila, 0 si no
 15+  A0F4              ;HL, DE y AF son libres para las rutinas llamadas; B, C e IX no lo son.
 16+  A0F4
 17+  A0F4              FRAMES_CAIDA_RAPIDA EQU 4   ; frames entre caidas mientras SPACE esta pulsada.
 18+  A0F4                                          ; Mas rapido que cualquier nivel normal (la tabla
 19+  A0F4                                          ; FRAMES_POR_NIVEL de puntuacion.asm no baja de 6),
 20+  A0F4                                          ; pero no instantaneo: esto es soft drop, no hard
 21+  A0F4                                          ; drop.
 22+  A0F4
 23+  A0F4              iniciar:
 24+  A0F4 CD D6 A1         CALL iniciar_secuencia  ; semilla del azar y primera pieza anunciada
 25+  A0F7
 26+  A0F7 CD 6C A5         CALL reiniciar_marcador ; puntos/lineas/nivel a cero y rotulos en pantalla.
 27+  A0FA                                          ;  Aqui todavia no hay ninguna pieza, asi que es el
 28+  A0FA                                          ;  unico sitio donde imprimir es gratis.
 29+  A0FA
 30+  A0FA CD E3 A1         CALL seleccionar_pieza  ; IX = pieza, B = 0, C = 15
 31+  A0FD CD FA A1         CALL pintar_siguiente   ; muestra la que viene detras
 32+  A100 79               LD A, C
 33+  A101 32 26 A8         LD (Medio), A           ; Medio siempre refleja C
 34+  A104
 35+  A104 CD 56 A3         CALL comprobar          ; fin de partida = la pieza nueva no cabe en su
 36+  A107 B7               OR A                    ;  posicion de aparicion. Antes esto se hacia con
 37+  A108 C2 A5 A1         JP NZ, fin_partida      ;  B=255, que leia RAM fuera de la pantalla ($77EF).
 38+  A10B                                          ;  JP, no JR: fin_partida ha quedado fuera de rango
 39+  A10B
 40+  A10B CD 1C A3         CALL pintar_tetromino   ; pintamos una vez, para que el primer borrado
 41+  A10E                                          ;  del bucle tenga algo que borrar
 42+  A10E              paso:
 43+  A10E 76               HALT                    ; dormimos hasta el tick de 50 Hz. El borrado y el
 44+  A10F                                          ;  repintado caen justo detras, en el borde superior.
 45+  A10F 26 00            LD H, 0                 ; por defecto esta pasada no baja
 46+  A111
 47+  A111 CD 28 A4         CALL leer_teclas        ; A = teclas; nunca bloquea. Se lee YA aqui, antes
 48+  A114                                          ;  del borrado, porque la gravedad rapida de abajo
 49+  A114                                          ;  necesita el bit4 (SPACE) de esta misma pasada.
 50+  A114                                          ;  borrar_tetromino preserva DE, asi que E aguanta.
 51+  A114 5F               LD E, A                 ; E sobrevive a borrar_tetromino, en_rango,
 52+  A115 16 00            LD D, 0                 ;  comprobar y GIRAR. D = desplazamiento lateral
 53+  A117
 54+  A117 3A 20 A8         LD A,(contador_frames)  ; gravedad NORMAL: cuenta siempre, la mantenga o
 55+  A11A 3D               DEC A                   ;  no SPACE pulsada, para que soltar la tecla
 56+  A11B 32 20 A8         LD (contador_frames), A ;  vuelva a la velocidad normal sin ningun salto
 57+  A11E 20 08            JR NZ, comprobar_rapida
 58+  A120 3A 1F A8         LD A,(FRAMES_POR_FILA)  ; se agoto la cuenta: recargamos y pedimos bajada
 59+  A123 32 20 A8         LD (contador_frames), A
 60+  A126 26 01            LD H, 1
 61+  A128              comprobar_rapida:
 62+  A128 CB 63            BIT 4, E                ; gravedad RAPIDA (soft drop): SUMA una bajada
 63+  A12A 28 10            JR Z, sin_gravedad       ;  mas si toca, nunca sustituye a la de arriba.
 64+  A12C 3A 21 A8         LD A,(contador_rapido)  ;  Solo se decuenta mientras SPACE sigue pulsada:
 65+  A12F 3D               DEC A                   ;  al soltarla la cuenta se queda congelada donde
 66+  A130 32 21 A8         LD (contador_rapido), A ;  estaba, lista para retomarse la proxima vez.
 67+  A133 20 07            JR NZ, sin_gravedad
 68+  A135 3E 04            LD A, FRAMES_CAIDA_RAPIDA
 69+  A137 32 21 A8         LD (contador_rapido), A
 70+  A13A 26 01            LD H, 1
 71+  A13C              sin_gravedad:
 72+  A13C CD 9A A3         CALL borrar_tetromino   ; borra en el (B,C) ACTUAL con el IX ACTUAL
 73+  A13F
 74+  A13F CB 43            BIT 0, E
 75+  A141 28 01            JR Z, no_derecha
 76+  A143 14               INC D                   ; K -> una columna a la derecha
 77+  A144              no_derecha:
 78+  A144 CB 4B            BIT 1, E
 79+  A146 28 01            JR Z, lateral
 80+  A148 15               DEC D                   ; J -> una columna a la izquierda
 81+  A149                                          ;  (las dos a la vez se anulan: D = 0)
 82+  A149              lateral:
 83+  A149 7A               LD A, D
 84+  A14A B7               OR A
 85+  A14B 28 18            JR Z, sin_lateral
 86+  A14D 79               LD A, C
 87+  A14E 82               ADD A, D
 88+  A14F 4F               LD C, A                 ; C = columna candidata
 89+  A150 CD 62 A4         CALL en_rango           ; 1. ¿sigue dentro de las columnas 7-24?
 90+  A153 B7               OR A
 91+  A154 20 06            JR NZ, lat_no
 92+  A156 CD 56 A3         CALL comprobar          ; 2. ¿libre de bloques ya asentados?
 93+  A159 B7               OR A
 94+  A15A 28 05            JR Z, lat_si
 95+  A15C              lat_no:
 96+  A15C 79               LD A, C                 ; bloqueada: devolvemos la columna vieja. NO se
 97+  A15D 92               SUB D                   ;  salta la gravedad de esta pasada.
 98+  A15E 4F               LD C, A
 99+  A15F 18 04            JR sin_lateral
100+  A161              lat_si:
101+  A161 79               LD A, C
102+  A162 32 26 A8         LD (Medio), A           ; Medio se actualiza en cada confirmacion
103+  A165              sin_lateral:
104+  A165
105+  A165 7B               LD A, E
106+  A166 E6 0C            AND %00001100           ; ¿ni Q ni W recien pulsadas?
107+  A168 28 0A            JR Z, sin_giro
108+  A16A CB 53            BIT 2, E
109+  A16C 3E 00            LD A, 0                 ; Q -> A = 0, girar a la izquierda
110+  A16E 20 01            JR NZ, girar_ya         ;  (LD no toca los flags de BIT)
111+  A170 3C               INC A                   ; W -> A = 1, girar a la derecha
112+  A171              girar_ya:
113+  A171 CD D6 A3         CALL GIRAR              ; comprueba limites, retranquea, valida y CONFIRMA
114+  A174              sin_giro:                   ;  el solo. NUNCA envolverlo en comprobar.
115+  A174
116+  A174 7C               LD A, H
117+  A175 B7               OR A
118+  A176 28 24            JR Z, dibujar           ; no es pasada de gravedad: solo repintar
119+  A178
120+  A178 04               INC B                   ; B = fila candidata
121+  A179 CD 56 A3         CALL comprobar
122+  A17C B7               OR A
123+  A17D 28 1D            JR Z, dibujar           ; libre: la caida queda confirmada
124+  A17F
125+  A17F 05               DEC B                   ; bloqueada: deshacemos la caida, la pieza se queda
126+  A180 CD 1C A3         CALL pintar_tetromino   ; y la fijamos en el fichero de atributos
127+  A183
128+  A183 CD 75 A4         CALL limpiar_lineas     ; A = filas eliminadas (0..4)
129+  A186 32 2B A8         LD (musica_silencio), A ; una trama que borra filas va MUDA: ni un borrado
130+  A189                                          ;  de una sola fila cabe junto al relleno de sonido
131+  A189                                          ;  (MUSIC_DESIGN.md 6). LD (nn),A no toca A ni los
132+  A189                                          ;  flags, asi que anotar_lineas sigue recibiendo
133+  A189                                          ;  intacta la cuenta que acaba de devolver.
134+  A189 CD FD A4         CALL anotar_lineas      ; puntua, sube de nivel y refresca el marcador
135+  A18C
136+  A18C CD E3 A1         CALL seleccionar_pieza  ; IX = pieza siguiente, B = 0, C = 15
137+  A18F CD FA A1         CALL pintar_siguiente   ; refresca el recuadro con la nueva anunciada
138+  A192 79               LD A, C
139+  A193 32 26 A8         LD (Medio), A
140+  A196 CD 56 A3         CALL comprobar          ; fin de partida = la nueva no cabe al aparecer
141+  A199 B7               OR A
142+  A19A 20 09            JR NZ, fin_partida
143+  A19C
144+  A19C              dibujar:
145+  A19C CD 1C A3         CALL pintar_tetromino   ; pintamos el (B, C, IX) ya validado
146+  A19F
147+  A19F CD A8 A6         CALL musica_frame       ; el relleno de sonido va AQUI, al final del cuerpo
148+  A1A2                                          ;  y DETRAS del repintado (MUSIC_DESIGN.md 7 regla
149+  A1A2                                          ;  1): el par borrar/pintar tiene que seguir pegado
150+  A1A2                                          ;  al HALT, dentro del borde superior, o la pieza se
151+  A1A2                                          ;  desgarra. Delante del repintado lo echaria fuera
152+  A1A2                                          ;  de esa ventana; detras es inofensivo.
153+  A1A2                                          ;  Preserva AF, BC, DE, HL, IX e IY, y no hace DI.
154+  A1A2 C3 0E A1         JP paso                 ; JP, no JR: paso ha quedado fuera de rango
155+  A1A5
156+  A1A5              fin_partida:
157+  A1A5 CD 71 A6         CALL relleno_pozo       ; el pozo se llena de bloques antes de cortar a la
158+  A1A8                                          ;  pantalla final (relleno.asm). Aqui el bucle ya
159+  A1A8                                          ;  ha terminado: no hay presupuesto de frame que
160+  A1A8                                          ;  respetar, solo el borde superior para no
161+  A1A8                                          ;  desgarrar. No toca PUNTOS ni MEJOR.
162+  A1A8 C3 48 9B         JP Pantalla_Final       ; JP, no CALL: no vuelve nunca
163+  A1AB
# file closed: juego.asm
 37   A1AB                  INCLUDE "tetromino_next.asm"
# file opened: tetromino_next.asm
  1+  A1AB              ;Programa para seleccionar y posicionar la proxima pieza
  2+  A1AB
  3+  A1AB              ; La version anterior elegia un ESTADO DE GIRO al azar entre los 19 registros,
  4+  A1AB              ; no una pieza: las piezas aparecian giradas al azar y las formas con 4 estados
  5+  A1AB              ; (L, J, T) salian el 75% de las veces. Ademas usaba "ld a,r" como fuente de
  6+  A1AB              ; azar (el contador de refresco, que avanza de forma casi fija por un camino de
  7+  A1AB              ; instrucciones fijo) y plegaba 19..31 sobre 0..12, con lo que los indices 0-12
  8+  A1AB              ; salian el doble que los 13-18.
  9+  A1AB              ;
 10+  A1AB              ; Ahora se elige una FORMA de una tabla de 7 estados de aparicion, todos
 11+  A1AB              ; verticales/canonicos, con un LFSR de 8 bits.
 12+  A1AB
 13+  A1AB              ; sembrar_azar -- toma una semilla del contador de refresco. Se llama una vez
 14+  A1AB              ;   por partida, justo despues de que el jugador pulse S, asi que el numero de
 15+  A1AB              ;   vueltas de la espera de teclado la hace realmente variable.
 16+  A1AB              ;   Destruye AF.
 17+  A1AB              sembrar_azar:
 18+  A1AB ED 5F            ld a, r                 ; contador de refresco: 0..127
 19+  A1AD B7               or a
 20+  A1AE 20 02            jr nz, sembrar_ok
 21+  A1B0 3E A5            ld a, $A5               ; un LFSR que valga cero se queda en cero para siempre
 22+  A1B2              sembrar_ok:
 23+  A1B2 32 23 A8         ld (semilla), a
 24+  A1B5 C9               ret
 25+  A1B6
 26+  A1B6              ; nueva_pieza -- sortea una forma y devuelve su registro de aparicion.
 27+  A1B6              ;   Salida: DE = direccion del registro. Destruye AF y DE. Preserva BC, HL, IX, IY.
 28+  A1B6              nueva_pieza:
 29+  A1B6 E5               push hl
 30+  A1B7              np_tirar:
 31+  A1B7 3A 23 A8         ld a, (semilla)         ; LFSR de Galois de 8 bits, periodo 255, nunca da 0
 32+  A1BA CB 3F            srl a                   ; desplaza a la derecha, el bit bajo va al acarreo
 33+  A1BC 30 02            jr nc, np_sin_tap
 34+  A1BE EE B4            xor $B4                 ; polinomio de realimentacion
 35+  A1C0              np_sin_tap:
 36+  A1C0 32 23 A8         ld (semilla), a
 37+  A1C3 E6 07            and 7
 38+  A1C5 FE 07            cp 7
 39+  A1C7 28 EE            jr z, np_tirar          ; descartamos el 7 -> uniforme 0..6. El reintento
 40+  A1C9                                          ;  queda por DEBAJO del push: no hay fuga de pila.
 41+  A1C9 87               add a, a                ; *2: cada entrada de la tabla son 2 bytes
 42+  A1CA 21 0E A3         ld hl, spawn_table
 43+  A1CD 16 00            ld d, 0
 43+  A1CF 5F             ld e, a
 44+  A1D0 19               add hl, de
 45+  A1D1 5E               ld e, (hl)
 45+  A1D2 23             inc hl
 45+  A1D3 56             ld d, (hl)
 46+  A1D4 E1               pop hl
 47+  A1D5 C9               ret
 48+  A1D6
 49+  A1D6              ; iniciar_secuencia -- semilla y primera pieza anunciada. Una vez por partida,
 50+  A1D6              ;   antes del primer seleccionar_pieza. Destruye AF.
 51+  A1D6              iniciar_secuencia:
 52+  A1D6 CD AB A1         call sembrar_azar
 53+  A1D9 D5               push de
 54+  A1DA CD B6 A1         call nueva_pieza
 55+  A1DD ED 53 24 A8      ld (siguiente_pieza), de
 56+  A1E1 D1               pop de
 57+  A1E2 C9               ret
 58+  A1E3
 59+  A1E3              ; seleccionar_pieza -- pone en juego la pieza ya anunciada y sortea la
 60+  A1E3              ;   siguiente, de modo que el jugador siempre ve una por adelantado.
 61+  A1E3              ;   Salida: IX = registro de aparicion, B = 0 (fila), C = 15 (columna).
 62+  A1E3              ;   Destruye AF, BC, DE, IX. Preserva HL e IY.
 63+  A1E3              ;   C = 15 es la UNICA definicion de la columna de aparicion; (Medio) se deriva
 64+  A1E3              ;   de ella en juego.asm.
 65+  A1E3              seleccionar_pieza:
 66+  A1E3 E5               push hl                 ; la version anterior preservaba HL: lo mantenemos
 67+  A1E4 2A 24 A8         ld hl, (siguiente_pieza)
 68+  A1E7 E5               push hl                 ; la anunciada pasa a jugarse
 69+  A1E8 CD B6 A1         call nueva_pieza        ; DE = la proxima a anunciar
 70+  A1EB ED 53 24 A8      ld (siguiente_pieza), de
 71+  A1EF D1               pop de                  ; DE = la que toca jugar ahora
 72+  A1F0 DD 62 DD 6B      ld ix, de               ; instruccion falsa de sjasmplus -> LD IXH,D : LD IXL,E
 73+  A1F4 E1               pop hl
 74+  A1F5 06 00            ld b, 0                 ; fila de aparicion
 75+  A1F7 0E 0F            ld c, 15                ; columna de aparicion
 76+  A1F9 C9               ret
 77+  A1FA
 78+  A1FA              ; ---------------------------------------------------------------------------
 79+  A1FA              ; Vista previa de la proxima pieza
 80+  A1FA              ;
 81+  A1FA              ; Se dibuja FUERA del pozo a proposito: "ocupado" es "byte de atributo distinto
 82+  A1FA              ; de cero", asi que cualquier cosa pintada en las columnas 7-24 se convertiria
 83+  A1FA              ; en geometria solida. en_rango mantiene la pieza en juego dentro de esas
 84+  A1FA              ; columnas, asi que el recuadro no puede tocarse nunca.
 85+  A1FA              PREV_FILA EQU 10        ; esquina superior izquierda del recuadro
 86+  A1FA              PREV_COL  EQU 27        ; columnas 27-30, filas 10-13: caja de 4x4
 87+  A1FA
 88+  A1FA              ; pintar_siguiente -- borra el recuadro y dibuja en el la pieza anunciada.
 89+  A1FA              ;   Preserva AF, BC, DE, HL, IX, IY.
 90+  A1FA              pintar_siguiente:
 91+  A1FA F5               push af
 91+  A1FB C5             push bc
 91+  A1FC D5             push de
 91+  A1FD E5             push hl
 91+  A1FE DD E5          push ix
 92+  A200 06 0A            ld b, PREV_FILA
 93+  A202 16 04            ld d, 4                 ; 4 filas que limpiar
 94+  A204              ps_fila:
 95+  A204 0E 1B            ld c, PREV_COL
 96+  A206 CD 3D 9D         call CRtoATTR           ; HL = direccion del atributo; PRESERVA BC
 97+  A209 36 00            ld (hl), 0
 97+  A20B 23             inc hl     ; las 4 celdas de la fila, a cero (negro), igual
 98+  A20C 36 00            ld (hl), 0
 98+  A20E 23             inc hl     ;  que el interior del pozo
 99+  A20F 36 00            ld (hl), 0
 99+  A211 23             inc hl
100+  A212 36 00            ld (hl), 0
101+  A214 04               inc b
102+  A215 15               dec d
103+  A216 20 EC            jr nz, ps_fila
104+  A218
105+  A218 DD 2A 24 A8      ld ix, (siguiente_pieza)
106+  A21C 06 0A            ld b, PREV_FILA
107+  A21E 0E 1B            ld c, PREV_COL
108+  A220 CD 1C A3         call pintar_tetromino
109+  A223 DD E1            pop ix
109+  A225 E1             pop hl
109+  A226 D1             pop de
109+  A227 C1             pop bc
109+  A228 F1             pop af
110+  A229 C9               ret
111+  A22A
# file closed: tetromino_next.asm
