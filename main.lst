 39+  A519 3C             inc a
 39+  A51A 32 19 A8       ld (LINEAS), a
 40+  A51D 3A 1B A8         ld a, (PROX_NIVEL)
 40+  A520 3D             dec a
 40+  A521 32 1B A8       ld (PROX_NIVEL), a
 41+  A524 20 10            jr nz, al_siguiente
 42+  A526 3E 0A            ld a, 10
 42+  A528 32 1B A8       ld (PROX_NIVEL), a      ; otras 10 filas hasta el proximo nivel
 43+  A52B 3A 1A A8         ld a, (NIVEL)
 44+  A52E FE 0A            cp NIVEL_MAX
 45+  A530 30 04            jr nc, al_siguiente                ; ya estamos en el tope
 46+  A532 3C               inc a
 46+  A533 32 1A A8       ld (NIVEL), a
 47+  A536              al_siguiente:
 48+  A536 10 DE            djnz al_bucle
