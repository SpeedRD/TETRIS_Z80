 72+  A566 19             ADD HL, DE
 73+  A567 7E               LD A, (HL)
 73+  A568 32 1F A8       LD (FRAMES_POR_FILA), A   ; suelo de 6 frames (~120 ms):
 74+  A56B C9               RET                                    ;  una tabla no puede dar 0
 75+  A56C
 76+  A56C              ; reiniciar_marcador -- pone a cero TODO el estado de una partida y pinta los
 77+  A56C              ;   rotulos y los valores. Es el unico sitio donde se reinicia estado por
 78+  A56C              ;   partida: hay uno solo, asi que no se puede olvidar (memory-map 6a).
 79+  A56C              ;   Se llama al empezar una partida, cuando aun no hay ninguna pieza en juego.
 80+  A56C              ;   NO toca MEJOR: la mejor puntuacion es de la SESION y sobrevive a
 81+  A56C              ;   inicializar; la escribe solo ActualizarMejor. Zapearla aqui borraria
 82+  A56C              ;   justo lo que existe para conservar.
 83+  A56C              ;   Preserva AF, BC, DE, HL, IX, IY.
 84+  A56C              reiniciar_marcador:
 85+  A56C F5               push af
 85+  A56D C5             push bc
 85+  A56E D5             push de
 85+  A56F E5             push hl
 85+  A570 DD E5          push ix
 86+  A572 AF               xor a
 87+  A573 32 16 A8         ld (PUNTOS), a
 87+  A576 32 17 A8       ld (PUNTOS+1), a
 87+  A579 32 18 A8       ld (PUNTOS+2), a
 88+  A57C 32 19 A8         ld (LINEAS), a
 89+  A57F 32 1A A8         ld (NIVEL), a
 90+  A582 3E 0A            ld a, 10
 90+  A584 32 1B A8       ld (PROX_NIVEL), a
 91+  A587 CD 57 A5         call ActualizarVelocidad           ; FRAMES_POR_FILA = tabla[0] = 48
