 45   A668                  INCLUDE "relleno.asm"
# file opened: relleno.asm
  1+  A668              ; relleno.asm -- animacion de relleno del pozo al perder la partida
  2+  A668              ;
  3+  A668              ; Al llegar a fin_partida (juego.asm) el pozo se llena de bloques de abajo
  4+  A668              ; arriba antes de cortar a la pantalla de fin de partida, en vez del corte seco
  5+  A668              ; de antes.
  6+  A668              ;
  7+  A668              ; TIEMPO. Aqui ya no rige el presupuesto de frame del bucle de juego
  8+  A668              ; (interrupts-and-timing seccion 2): el bucle ha TERMINADO -- fin_partida es lo
  9+  A668              ; ultimo que se ejecuta de la partida -- asi que no hay entrada que leer, ni
 10+  A668              ; gravedad que contar, ni pieza viva que repintar. Lo que si sigue rigiendo es
 11+  A668              ; el desgarro: escribir en el fichero de atributos mientras la ULA esta
 12+  A668              ; leyendo la zona visible se ve. Por eso cada fila se pinta JUSTO detras de un
 13+  A668              ; HALT, en el borde superior, igual que el borrado y el repintado del bucle:
 14+  A668              ; 18 escrituras de atributo (~400 T) caben de sobra en la ventana de ~14.000 T.
 15+  A668              ;
 16+  A668              ; Y sigue rigiendo el estado de interrupciones: HALT solo vuelve si estan
 17+  A668              ; habilitadas. Lo estan -- main.asm:7-10 las deja activas con IY = $5C3A y
 18+  A668              ; ninguna de las parejas di/ei del arbol (piezas.asm, clear.asm, test_col.asm,
 19+  A668              ; tableroJuego.asm) vuelve sin reactivarlas. Esta rutina no toca IY, asi que no
 20+  A668              ; necesita pareja propia.
 21+  A668              ;
 22+  A668              ; Por eso la animacion es frame a frame y no una sola pasada rapida: una pasada
 23+  A668              ; unica no seria mas segura -- solo mas rapida y peor sincronizada -- y contar
 24+  A668              ; frames con HALT es lo que ya hace el juego. Lo que NO se hace en ningun caso
 25+  A668              ; es una espera por bucle vacio: su velocidad depende del emulador
 26+  A668              ; (interrupts-and-timing seccion 4).
 27+  A668              ;
 28+  A668              ; No toca ni PUNTOS, ni LINEAS, ni NIVEL, ni MEJOR: solo escribe en el fichero
 29+  A668              ; de atributos, entre $5800 y $5AFF. La captura del record (ActualizarMejor)
 30+  A668              ; ocurre despues, ya dentro de Pantalla_Final, y lee un PUNTOS intacto.
 31+  A668
 32+  A668              RELL_FILA_BAJA   EQU 21     ; ultima fila del interior del pozo (la 22 es el suelo)
 33+  A668              RELL_COL_IZQ     EQU 7      ; primera columna del interior
 34+  A668              RELL_ANCHO       EQU 18     ; columnas 7-24
 35+  A668              RELL_FRAMES_FILA EQU 3      ; frames por fila: 22 filas x 3 = 66 frames, ~1,3 s
 36+  A668              RELL_PAUSA       EQU 25     ; ~0,5 s con el pozo lleno antes de cambiar de
 37+  A668                                          ;  pantalla, para que se vea el resultado
 38+  A668                                          ; total ~91 frames, ~1,8 s
 39+  A668
 40+  A668              ; relleno_pozo -- llena el interior del pozo de abajo arriba.
 41+  A668              ;   Sin entrada ni salida. Preserva AF, BC, DE, HL, IX, IY.
 42+  A668              relleno_pozo:
 43+  A668 F5               push af
 43+  A669 C5             push bc
 43+  A66A D5             push de
 43+  A66B E5             push hl
 44+  A66C 06 15            ld b, RELL_FILA_BAJA
 45+  A66E 0E 07            ld c, RELL_COL_IZQ       ; CRtoATTR toma (B,C) y preserva BC
 46+  A670 16 01            ld d, 1                  ; D = color en curso, 1..7
 47+  A672              rp_fila:
 48+  A672 1E 03            ld e, RELL_FRAMES_FILA
 49+  A674              rp_esperar:
 50+  A674 76               HALT                     ; dormimos hasta el tick de 50 Hz
 51+  A675 1D               dec e
 52+  A676 20 FC            jr nz, rp_esperar
 53+  A678
 54+  A678 CD 3D 9D         call CRtoATTR            ; HL = atributo de (B,7), ya en el borde superior
 55+  A67B 7A               ld a, d
 56+  A67C 87               add a, a
 56+  A67D 87             add a, a
 56+  A67E 87             add a, a   ; color*8 = PAPEL, tinta 0: la misma
 57+  A67F                                                   ;  codificacion que las piezas (piezas.asm)
 58+  A67F 1E 12            ld e, RELL_ANCHO
 59+  A681              rp_celda:
 60+  A681 77               ld (hl), a
 61+  A682 23               inc hl
 62+  A683 1D               dec e
 63+  A684 20 FB            jr nz, rp_celda
 64+  A686
 65+  A686 14               inc d                    ; siguiente color de la paleta de las piezas
 66+  A687 7A               ld a, d
 67+  A688 FE 08            cp 8
 68+  A68A 38 02            jr c, rp_fila_hecha
 69+  A68C 16 01            ld d, 1                  ; 1..7: los siete que ya usan los tetrominos
 70+  A68E              rp_fila_hecha:
 71+  A68E 78               ld a, b
 72+  A68F B7               or a
 73+  A690 28 03            jr z, rp_pausa           ; acabamos de pintar la fila 0: el pozo esta lleno
 74+  A692 05               dec b                    ; subimos una fila
 75+  A693 18 DD            jr rp_fila
 76+  A695
 77+  A695              rp_pausa:
 78+  A695 06 19            ld b, RELL_PAUSA
 79+  A697              rp_pausa_bucle:
 80+  A697 76               HALT
 81+  A698 10 FD            djnz rp_pausa_bucle
 82+  A69A E1               pop hl
 82+  A69B D1             pop de
 82+  A69C C1             pop bc
 82+  A69D F1             pop af
 83+  A69E C9               ret
 84+  A69F
# file closed: relleno.asm
 46   A69F                  INCLUDE "variables.asm"   ; SIEMPRE el ultimo: el estado mutable va al final
# file opened: variables.asm
  1+  A69F              ; variables.asm -- TODO el estado mutable nuevo del juego, en un solo sitio.
  2+  A69F              ;
  3+  A69F              ; Se INCLUDE el ULTIMO en main.asm, asi que aterriza en $A2C7, el primer byte
  4+  A69F              ; libre despues de la imagen del programa: memoria no contendida, separada del
  5+  A69F              ; codigo y de la tabla de piezas, y referenciada siempre por etiqueta.
  6+  A69F              ;
  7+  A69F              ; NO declarar ninguna de estas variables en otro fichero: una segunda
  8+  A69F              ; declaracion es un error de etiqueta duplicada.
  9+  A69F              ; NO copiar el patron de "Medio" (piezas.asm:31), que vive incrustado en la
 10+  A69F              ; imagen de codigo justo detras del ultimo registro de pieza y sin margen.
 11+  A69F
 12+  A69F              ; --- puntuacion ------------------------------------------------------------
 13+  A69F 00 00 00     PUNTOS:          DB 0, 0, 0 ; BCD empaquetado, 6 digitos: pares 1-2, 3-4, 5-6
 14+  A6A2 00           LINEAS:          DB 0       ; total de filas eliminadas (binario de 8 bits)
 15+  A6A3 00           NIVEL:           DB 0       ; nivel actual (binario de 8 bits)
 16+  A6A4 0A           PROX_NIVEL:      DB 10      ; filas que faltan para subir de nivel
 17+  A6A5 00 00 00     MEJOR:           DB 0, 0, 0 ; mejor puntuacion de la SESION, mismo formato que
 18+  A6A8                                          ; PUNTOS (BCD empaquetado, 6 digitos) para poder
 19+  A6A8                                          ; reutilizar ImprimirBCD. Se escribe en un solo
 20+  A6A8                                          ; sitio -- ActualizarMejor, al entrar en
 21+  A6A8                                          ; Pantalla_Final -- y se lee en dos, la pantalla de
 22+  A6A8                                          ; inicio y la de fin de partida. Sobrevive a
 23+  A6A8                                          ; inicializar: nadie lo pone a cero, y por eso es de
 24+  A6A8                                          ; la sesion y no de la partida
 25+  A6A8
 26+  A6A8              ; --- gravedad --------------------------------------------------------------
 27+  A6A8 30           FRAMES_POR_FILA: DB 48      ; frames entre dos caidas de una fila (nivel 0)
 28+  A6A9 30           contador_frames: DB 48      ; frames que faltan para la proxima caida
 29+  A6AA 04           contador_rapido: DB 4       ; frames que faltan para la proxima caida RAPIDA
 30+  A6AB                                          ; (soft drop, SPACE mantenida). Solo se decuenta
 31+  A6AB                                          ; mientras SPACE esta pulsada -- juego.asm; no
 32+  A6AB                                          ; toca ni reemplaza a contador_frames, que sigue
 33+  A6AB                                          ; su cuenta normal por debajo sin interrupcion
 34+  A6AB
 35+  A6AB              ; --- entrada ---------------------------------------------------------------
 36+  A6AB 00           teclas_ant:      DB 0       ; mascara de la lectura anterior de leer_teclas.
 37+  A6AC                                          ; Convenio de leer_teclas: bit a 1 = tecla PULSADA
 38+  A6AC                                          ; (ya invertida), por eso el valor inicial es 0.
 39+  A6AC
 40+  A6AC              ; --- seleccion y posicion de pieza -----------------------------------------
 41+  A6AC A5           semilla:         DB $A5     ; estado del LFSR. DEBE ser distinto de cero: un
 42+  A6AD                                          ; LFSR que llega a cero se queda en cero para siempre
 43+  A6AD 24 A2        siguiente_pieza: DW T_0     ; puntero al registro de la proxima pieza (preview).
 44+  A6AF                                          ; Arranca en un registro VALIDO, no en 0: iniciar
 45+  A6AF                                          ; siempre llama antes a iniciar_secuencia, pero con
 46+  A6AF                                          ; un 0 aqui cualquier camino que se saltara ese paso
 47+  A6AF                                          ; dejaria IX=$0000 y pintar_tetromino leeria las
 48+  A6AF                                          ; filas/columnas de la ROM.
 49+  A6AF 0F           Medio:           DB 15      ; copia en memoria de la columna en curso (C).
 50+  A6B0                                          ; El valor inicial es indiferente: juego.asm lo
 51+  A6B0                                          ; escribe desde C en cuanto aparece la primera
 52+  A6B0                                          ; pieza. Antes vivia en piezas.asm, dentro de la
 53+  A6B0                                          ; imagen de codigo, pegado al ultimo registro.
 54+  A6B0
# file closed: variables.asm
 47   A6B0
# file closed: main.asm
