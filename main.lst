133+  9CBF              ; ----------------------------------------------------------------------------------------
134+  9CBF              ; INK2PAPER - moves ink of attribute stored in (PRINT_ATTR) to paper and sets ink to 0
135+  9CBF              ; 				Sets bright 1 and flash 0
136+  9CBF              ; ----------------------------------------------------------------------------------------
137+  9CBF 3A DF 9C     INK2PAPER:	LD A, (PRINT_ATTR)		    ; Get storedAttribute
138+  9CC2 E6 07                    AND 7						; get Attr INK in A
139+  9CC4 07           			RLCA
140+  9CC5 07           			RLCA
141+  9CC6 07           			RLCA						; move Ink to Paper
142+  9CC7 F6 40        			OR 64						; ink 0 bright 1
143+  9CC9 32 DF 9C     			LD (PRINT_ATTR),A		    ; Get storedAttribute
144+  9CCC C9           			RET
