 38+  9C6B              ; CRtoSCREEN - Converts a scr char coord into a SCREEN Address   b,c = y,x positions
 39+  9C6B              ;	IN  - B=Row, C=Column
 40+  9C6B              ;	OUT - HL=Address in screen also stored in (SCR_CUR_PTR)
 41+  9C6B              ;	Conversion:
 42+  9C6B              ;			Row FFfff   Column CCCCC
 43+  9C6B              ;			HL=%010FF000 fffCCCCC
 44+  9C6B              ;-----------------------------------------------------------------------------------------
 45+  9C6B              CRtoSCREEN:
 46+  9C6B 78           			LD A,B						; %___FFfff
 47+  9C6C F6 40        			OR #40						; %010FFfff
 48+  9C6E E6 F8        			AND #F8						; %010FF000
 49+  9C70 67           			LD H,A
 50+  9C71
 51+  9C71 78           			LD A,B						; %___FFfff
 52+  9C72 E6 07        			AND #7						; %00000fff
 53+  9C74 0F           			RRCA						; %f00000ff
 54+  9C75 0F           			RRCA						; %ff00000f
 55+  9C76 0F           			RRCA						; %fff00000
 56+  9C77 B1           			OR C						; %fffCCCCC
 57+  9C78 6F           			LD L,A
 58+  9C79 22 D2 9C                 LD (SCR_CUR_PTR),HL			; Update Variable
 59+  9C7C C9                       RET
 60+  9C7D              ; ----------------------------------------------------------------------------------------
 61+  9C7D
 62+  9C7D
 63+  9C7D
 64+  9C7D              ;-----------------------------------------------------------------------------------------
 65+  9C7D              ; CRtoATTR - Converts a screen char coord  into a ATTR Address  b,c = y,x positions
 66+  9C7D              ;	IN  - B=Row, C=Column
 67+  9C7D              ;	OUT - HL=Address in screen also stored in (SCR_ATTR_PTR)
 68+  9C7D              ;	Conversion:
 69+  9C7D              ;			Row FFfff   Column CCCCC
 70+  9C7D              ;			HL=%010110FF fffCCCCC
 71+  9C7D              ;-----------------------------------------------------------------------------------------
 72+  9C7D              CRtoATTR:
 73+  9C7D 78           			LD A,B						; %___FFfff
 74+  9C7E 0F           			RRCA						; %f000FFff
 75+  9C7F 0F           			RRCA						; %ff000FFf
 76+  9C80 0F           			RRCA						; %fff000FF
 77+  9C81 6F           			LD L,A
 78+  9C82 E6 03        			AND 3						; %000000FF	value of FF can be only 00,01,10
 79+  9C84 F6 58        			OR #58						; %010110FF value will be #58, #59 or #5A
 80+  9C86 67           			LD H,A
 81+  9C87
 82+  9C87 7D           			LD A,L						; %fff000FF
 83+  9C88 E6 E0        			AND #E0						; %fff00000
 84+  9C8A B1           			OR C						; %fffCCCCC
 85+  9C8B 6F           			LD L,A
 86+  9C8C
 87+  9C8C 22 D4 9C                 LD (SCR_ATTR_PTR),HL		; Update Variable
 88+  9C8F C9                       RET
