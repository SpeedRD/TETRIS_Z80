113+  A506 CD 2B A5       call ImprimirBCD
114+  A509 3E 07            ld a, 7
114+  A50B 06 04          ld b, 4
114+  A50D 0E 1A          ld c, 26
115+  A50F CD 6B 9C         call PREP_PRT
116+  A512 3A 84 A5         ld a, (LINEAS)
116+  A515 CD 3F A5       call ImprimirDec3
117+  A518 3E 07            ld a, 7
117+  A51A 06 07          ld b, 7
117+  A51C 0E 1A          ld c, 26
118+  A51E CD 6B 9C         call PREP_PRT
119+  A521 3A 85 A5         ld a, (NIVEL)
119+  A524 CD 3F A5       call ImprimirDec3
